// Screenshot website function
let ssweb = (url, device = 'desktop') => {
  return new Promise((resolve, reject) => {
    const requestData = {
      'url': url,
      'device': device,
      'cacheLimit': 0
    };
    
    axios({
      'url': "https://www.screenshotmachine.com/capture.php",
      'method': 'POST',
      'data': new URLSearchParams(Object.entries(requestData)),
      'headers': {
        'content-type': "application/x-www-form-urlencoded; charset=UTF-8"
      }
    }).then(response => {
      const cookies = response.headers["set-cookie"];
      if (response.data.status == "success") {
        axios.get("https://www.screenshotmachine.com/" + response.data.link, {
          'headers': { 'cookie': cookies.join('') },
          'responseType': "arraybuffer"
        }).then(({ data: imageData }) => {
          resolve({
            'status': 200,
            'result': imageData
          });
        });
      } else {
        reject({
          'status': 404,
          'statuses': "Link Error",
          'message': response.data
        });
      }
    }).catch(reject);
  });
};

// Command: Take website screenshot
smd({
  'cmdname': 'ss',
  'alias': ["webss", "fullss"],
  'type': 'new',
  'info': "get random poetry lines"
}, async (message, text) => {
  try {
    let url = text.split(" ")[0].trim();
    if (!url) {
      return await message.reply(`*Need URL! Use ${prefix}ss https://github.com/efeurhobobullish/Empire-Md*`);
    }
    
    let screenshot = await ssweb(url);
    if (screenshot && screenshot.status == "200") {
      return await message.send(screenshot.result, {
        'caption': Config.caption
      }, 'smdimg', message);
    } else {
      message.send("_No response from server!_");
    }
  } catch (error) {
    await message.error(error + "\n\ncommand : myip", error, "*Request Denied!*");
  }
});

// Temporary email service
const secmailData = {};

// Command: Create temporary email
smd({
  'pattern': "tempmail",
  'alias': ['tmpmail', "newmail", "tempemail"],
  'info': "Create temporary email address, and use it according your need!",
  'type': "email"
}, async (message) => {
  try {
    if (!secmailData[message.sender]) {
      const emailData = await tempmail.create();
      if (!emailData || !emailData[0]) {
        return await message.reply(langText("new", "request_denied", {}, message.userLang || global.currentUserLang));
      }
      
      const emailParts = emailData[0].split('@');
      secmailData[message.sender] = {
        'email': emailData[0],
        'login': emailParts[0],
        'domain': emailParts[1]
      };
    }
    
    var thumbnailImage = false;
    try {
      thumbnailImage = await smdBuffer("https://telegra.ph/file/b8e96b599e0fa54d25940.jpg");
    } catch (error) {}
    
    await message.reply((`*YOUR TEMPMAIL INFO*\n      \n      \n  *EMAIL:* ➪ ${secmailData[message.sender].email}\n  *Login:* ➪ ${secmailData[message.sender].login}\n  *Domain:* ➪ ${secmailData[message.sender].domain}\n  \n  \n  *USE _${prefix}checkmail_ to get latest emails!*\n  *USE _${prefix}delmail_ to delete current email!*\n  \n  ${Config.caption}\n  `).trim(), {
      'contextInfo': {
        ...(await message.bot.contextInfo("TEMPMAIL", message.senderName, thumbnailImage))
      }
    }, 'smd', message);
  } catch (error) {
    console.log(error);
    await message.reply(langText("new", "request_denied", {}, message.userLang || global.currentUserLang));
  }
});

// Command: Check temporary email inbox
smd({
  'pattern': "checkmail",
  'alias': ["readmail", "reademail"],
  'type': "email",
  'info': "check mails in your temporary email address!"
}, async (message) => {
  try {
    const senderId = message.sender;
    const emailInfo = secmailData[senderId];
    
    if (!emailInfo || !emailInfo.email) {
      return await message.reply(`*You haven't created a temporary email.*\n  *Use _${prefix}tempmail_ to create email first!*`);
    }
    
    const emails = await tempmail.mails(emailInfo.login, emailInfo.domain);
    if (!emails || !emails[0] || emails.length === 0) {
      return await message.reply(`*EMPTY  ➪ No mails received yet!* \n*Use _${prefix}delmail_ to delete mail!*`);
    }
    
    var thumbnailImage = false;
    try {
      thumbnailImage = await smdBuffer("https://telegra.ph/file/b8e96b599e0fa54d25940.jpg");
    } catch (error) {}
    
    for (const email of emails) {
      const emailBody = await tempmail.emailContent(emailInfo.login, emailInfo.domain, email.id);
      console.log({ 'emailContent': emailBody });
      
      if (emailBody) {
        const formattedEmail = `\n  *From* ➪ ${email.from}\n  *Date* ➪  ${email.date}\n  *EMAIL ID* ➪  [${email.id}]\n  *Subject* ➪  ${email.subject}\n  *Content* ➪  ${emailBody}`;
        
        await message.reply(formattedEmail, {
          'contextInfo': {
            ...(await message.bot.contextInfo(`*EMAIL ➪ ${email.id}*`, message.senderName, thumbnailImage))
          }
        }, "smd", message);
      }
    }
  } catch (error) {
    console.log(error);
    await message.reply(langText("new", "request_denied", {}, message.userLang || global.currentUserLang));
  }
});

// Command: Delete temporary email
smd({
  'pattern': 'delmail',
  'alias': ['deletemail', "deltemp", 'deltmp'],
  'type': 'email',
  'info': "Delete temporary email address!"
}, async (message) => {
  try {
    const senderId = message.sender;
    if (secmailData[senderId]) {
      delete secmailData[senderId];
      await message.reply(langText("new", "email_deleted", {}, message.userLang || global.currentUserLang));
    } else {
      await message.reply(langText("new", "no_email", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    console.log(error);
    await message.reply(langText("new", "request_denied", {}, message.userLang || global.currentUserLang));
  }
});

// Temporary email API helper functions
const tempmail = {
  "create": async () => {
    try {
      let response = await fetch("https://www.1secmail.com/api/v1/?action=genRandomMailbox&count=1");
      if (!response.ok) {
        throw new Error("HTTP error! status: " + response.status);
      }
      let data = await response.json();
      return data;
    } catch (error) {
      console.log(error);
      return null;
    }
  },
  "mails": async (login, domain) => {
    const apiUrl = `https://www.1secmail.com/api/v1/?action=getMessages&login=${login}&domain=${domain}`;
    try {
      let response = await fetch(apiUrl);
      if (!response.ok) {
        throw new Error("HTTP error! status: " + response.status);
      }
      let data = await response.json();
      return data;
    } catch (error) {
      console.log(error);
      return null;
    }
  },
  emailContent: async (login, domain, emailId) => {
    const apiUrl = `https://www.1secmail.com/api/v1/?action=readMessage&login=${login}&domain=${domain}&id=${emailId}`;
    try {
      let response = await fetch(apiUrl);
      if (!response.ok) {
        throw new Error("HTTP error! status: " + response.status);
      }
      let data = await response.json();
      const htmlContent = data.htmlBody;
      console.log({ 'htmlContent': htmlContent });
      const $ = cheerio.load(htmlContent);
      const textContent = $.text();
      return textContent;
    } catch (error) {
      console.log(error);
      return null;
    }
  }
};
