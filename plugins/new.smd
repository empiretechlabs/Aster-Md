// Command: Set caption for replied media message
smd({
  'cmdname': "caption",
  'alias': ['setcaption'],
  'desc': "set caption for Replied Message",
  'category': 'new',
  'filename': __filename
}, async (message, text) => {
  try {
    if (!message.reply_message || !text) {
      return await message.reply(!message.reply_message ? 
        "*_Please reply to message with caption | filename_*" : 
        "*Please provide text to set caption!*");
    }
    
    if (message.reply_message.image || message.reply_message.video || 
        message.reply_message.mtype.includes('document')) {
      let fileName = text.split('|')[1]?.trim() || "null";
      let caption = message.reply_message.mtype.includes("document") ? 
        text.split('|')[0].trim() : text;
      
      message.reply_message.message[message.reply_message.mtype].caption = caption;
      message.reply_message.message[message.reply_message.mtype].fileName = fileName;
      
      await message.bot.copyNForward(message.chat, message.reply_message);
    } else {
      return await message.reply("please reply to an Audio/Video/document message");
    }
  } catch (error) {
    await message.error(error + "\n\ncommand : caption", error, false);
  }
});

// Command: Convert image/video to document
smd({
  'cmdname': 'document',
  'alias': ['senddoc', 'todoc'],
  'desc': "send document for Replied image/video Message",
  'category': "new",
  'filename': __filename
}, async (message, text) => {
  try {
    let mediaMessage = message.image || message.video ? message : 
      message.reply_message && (message.reply_message.image || message.reply_message.video) ? 
      message.reply_message : false;
    
    if (!mediaMessage) {
      return await message.reply("_Reply to an image/video message!_");
    }
    if (!text) {
      return await message.reply("_Need fileName, Example: document empire | caption_");
    }
    
    let mediaFile = await message.bot.downloadAndSaveMediaMessage(mediaMessage);
    let separator = text.includes(':') ? ':' : text.includes(';') ? ';' : '|';
    let fileName = text.split(separator)[0].trim() + '.' + (mediaMessage.image ? "jpg" : 'mp4');
    let caption = text.split(separator)[1]?.trim() || '';
    caption = ['copy', 'default', 'old', 'reply'].includes(caption) ? mediaMessage.text : caption;
    
    if (mediaFile) {
      message.bot.sendMessage(message.chat, {
        'document': { 'url': mediaFile },
        'mimetype': mediaMessage.mimetype,
        'fileName': fileName,
        'caption': caption
      });
    } else {
      message.reply(langText("new", "request_denied", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    await message.error(error + "\n\ncommand : document", error, false);
  }
});

// Command: Convert to view-once message
smd({
  'cmdname': "tovv",
  'alias': ["toviewonce"],
  'desc': "send viewonce for Replied image/video Message",
  'category': 'new',
  'filename': __filename
}, async (message, caption) => {
  try {
    let mediaMessage = message.image || message.video ? message : 
      message.reply_message && (message.reply_message.image || message.reply_message.video) ? 
      message.reply_message : false;
    
    if (!mediaMessage) {
      return await message.reply("_Reply to image/video with caption!_");
    }
    
    let mediaFile = await message.bot.downloadAndSaveMediaMessage(mediaMessage);
    let mediaType = mediaMessage.image ? "image" : 'video';
    
    if (mediaFile) {
      message.bot.sendMessage(message.chat, {
        [mediaType]: { 'url': mediaFile },
        'caption': caption,
        'mimetype': mediaMessage.mimetype,
        'fileLength': "99999999",
        'viewOnce': true
      }, { 'quoted': mediaMessage });
    } else {
      message.reply(langText("new", "request_denied", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    await message.error(error + "\n\ncommand : tovv", error, false);
  }
});

// Command: Show total feature count
smd({
  'cmdname': "feature",
  'alias': ["totalfeature", 'features', "empire"],
  'category': "new",
  'filename': __filename,
  'info': "get counting for total features!"
}, async (message) => {
  try {
    const plugins = require("../lib/plugins");
    let totalFeatures = Object.values(plugins.commands).length;
    
    // Animated counting
    try {
      let { key: editKey } = await message.send("Counting... 0", {}, "empire", message);
      for (let i = 0; i <= totalFeatures; i++) {
        if (i % 15 === 0) {
          await message.send("Counting... " + i, { 'edit': editKey }, "empire", message);
        } else {
          if (totalFeatures - i < 10) {
            await message.send("Counting... " + i, { 'edit': editKey }, "empire", message);
          }
        }
      }
      await message.send("*Feature Counting Done!*", { 'edit': editKey }, "empire", message);
    } catch (error) {}
    
    let featureReport = ` *乂 ＳＵＨＡＩＬ ＭＤ - ＢＯＴ ＦＥＡＴＵＲＥ*\n\n\n  ◦ _Total Features ➪ ${totalFeatures}_\n  \n*◦ LIST DOWN THE FEATURES*\n\n      _Commands ➪ ${Object.values(plugins.commands).filter(cmd => cmd.pattern).length}_\n      _Msg Listener ➪ ${Object.values(plugins.commands).filter(cmd => cmd.on).length}_\n      _Call Listener ➪ ${Object.values(plugins.commands).filter(cmd => cmd.call).length}_\n      _Group Listener ➪ ${Object.values(plugins.commands).filter(cmd => cmd.group).length}_\n  \n\n${Config.caption}`;
    
    await message.bot.relayMessage(message.chat, {
      'requestPaymentMessage': {
        'currencyCodeIso4217': 'PK',
        'amount1000': totalFeatures * 1000,
        'requestFrom': '0@s.whatsapp.net',
        'noteMessage': {
          'extendedTextMessage': {
            'text': featureReport,
            'contextInfo': {
              'mentionedJid': [message.sender],
              'externalAdReply': {
                'showAdAttribution': true
              }
            }
          }
        }
      }
    }, {});
  } catch (error) {
    await message.error(error + "\n\ncommand : feature", error, false);
  }
});

// Command: Random character trait generator
smd({
  'cmdname': "character",
  'category': "fun",
  'use': '[@user]',
  'filename': __filename,
  'info': "Check character of replied USER!"
}, async (message) => {
  const targetUser = message.reply_message ? message.reply_message.sender : 
    message.mentionedJid && message.mentionedJid[0] ? message.mentionedJid[0] : '';
  
  if (!targetUser || !targetUser.includes('@')) {
    return await message.reply(langText("new", "mention_user", {}, message.userLang || global.currentUserLang));
  }
  
  const characterTraits = [
    "Sigma", "Generous", 'Grumpy', "Overconfident", "Obedient", "Good", 
    'Simple', "Kind", "Patient", "Pervert", "Cool", "Helpful", 'Brilliant', 
    "Sexy", "Hot", "Gorgeous", "Cute", 'Fabolous', "Funny"
  ];
  
  const randomTrait = characterTraits[Math.floor(Math.random() * characterTraits.length)];
  let responseText = `Character of @${targetUser.split('@')[0]}  is *${randomTrait}* 🔥⚡`;
  
  message.send(responseText, { 'mentions': [targetUser] }, 'empire', message);
});

