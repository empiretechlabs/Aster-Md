// Extracted alexa command to plugins/ai.smd

// Command: Bot status and performance
smd({
  'cmdname': "ping2",
  'alias': ["botstatus", "statusbot", 'p2'],
  'type': "new",
  'info': "get random poetry lines"
}, async (message) => {
  try {
    const memoryUsage = process.memoryUsage();
    
    // Calculate CPU info
    const cpus = os.cpus().map(cpu => {
      cpu.total = Object.keys(cpu.times).reduce((total, timeKey) => total + cpu.times[timeKey], 0);
      return cpu;
    });
    
    const cpuStats = cpus.reduce((stats, cpu, index, { length }) => {
      stats.total += cpu.total;
      stats.speed += cpu.speed / length;
      stats.times.user += cpu.times.user;
      stats.times.nice += cpu.times.nice;
      stats.times.sys += cpu.times.sys;
      stats.times.idle += cpu.times.idle;
      stats.times.irq += cpu.times.irq;
      return stats;
    }, {
      'speed': 0, 'total': 0,
      'times': { 'user': 0, 'nice': 0, 'sys': 0, 'idle': 0, 'irq': 0 }
    });
    
    let startTime = speed();
    let responseTime = speed() - startTime;
    let newTime = performance.now();
    let oldTime = performance.now();
    
    let statusReport = (
      `\nResponse Speed ${responseTime.toFixed(4)} _Second_ \n ${(oldTime - newTime)} _milliseconds_\n\n` +
      `Runtime : ${runtime(process.uptime())}\n\n` +
      `💻 Info Server\nRAM: ${formatp(os.totalmem() - os.freemem())} / ${formatp(os.totalmem())}\n\n` +
      `_NodeJS Memory Usage_\n${Object.keys(memoryUsage).map((key, index, keys) => 
        key.padEnd(Math.max(...keys.map(k => k.length)), " ") + ": " + formatp(memoryUsage[key])
      ).join("\n")}\n\n` +
      (cpus[0] ? 
        `_Total CPU Usage_\n${cpus[0].model.trim()} (${cpuStats.speed} MHZ)\n` +
        Object.keys(cpuStats.times).map(timeKey => 
          `- *${(timeKey + '*').padEnd(6)}: ${(100 * cpuStats.times[timeKey] / cpuStats.total).toFixed(2)}%`
        ).join("\n") + " " : ''
      ) + `\n\n `
    ).trim();
    
    message.reply(statusReport);
  } catch (error) {
    await message.error(error + "\n\ncommand : ping2", error, false);
  }
});

