// Command: List active users and their message counts in current chat
smd({
  'cmdname': "listmessage",
  'alias': ["countmessage", "msgcount"],
  'desc': "Check how many users continuously active in chat!",
  'category': "new",
  'filename': __filename
}, async (message, chat, { store }) => {
  try {
    let userMessageCount = {};
    
    // Count messages per user
    store.messages[message.jid].array.forEach(msg => {
      const userName = msg.pushName || (message.isGroup ? msg.key.participant : msg.key.remoteJid || 'unknown').split('@')[0];
      userMessageCount[userName] = (userMessageCount[userName] || 0) + 1;
    });
    
    let userEntries = Object.entries(userMessageCount);
    if (!userEntries || !userEntries[0]) {
      return await message.reply("_No messages found!_");
    }
    
    // Format user list with message counts
    const userList = Object.entries(userMessageCount)
      .map(([name, count]) => `\t*${(name?.split("\n").join(" ") || "unknown")}*  ➪  _${count}_`)
      .join("\n");
    
    var responseText = (`*LIST OF ACTIVE USERS IN CURRENT CHAT*\n_Note: Sometimes Data will be reset when bot restart!_\n\n*Total Users: _${userEntries.length}_*\n\n*USERNAME ➪ MESSAGE COUNT(s)*\n${userList}\n\n${Config.caption}`).trim();
    
    await message.send(responseText, {
      'contextInfo': {
        ...(await message.bot.contextInfo("ACTIVE USERS", message.senderName))
      }
    }, 'empire', message);
  } catch (error) {
    console.log({ 'error': error });
  }
});

// Command history tracking
global.commandHistory = global.commandHistory || [];
const commandHistory = global.commandHistory;

// Auto-track commands used
smd({
  'on': 'main'
}, async (message, chat, { icmd }) => {
  try {
    if (icmd && message.cmd) {
      commandHistory.push({
        'user': message.sender,
        'command': message.cmd,
        'timestamp': new Date()
      });
    }
  } catch (error) {
    await message.error(error + "\n\ncommand : listmessage", error, "*ERROR!*");
  }
});

// Command: Show command usage statistics
smd({
  'cmdname': "cmdused",
  'alias': ["cmds", "usedcmd", "usage"],
  'desc': "Counts the commands used by users after starting bot?",
  'category': "new",
  'filename': __filename
}, async (message) => {
  try {
    let userOrder = [];
    const userStats = {};
    
    // Calculate command usage per user
    commandHistory.forEach(({ user, command }) => {
      if (!userStats[user]) {
        userStats[user] = {
          'commands': {},
          'count': 0
        };
        userOrder.push(user);
      }
      if (!userStats[user].commands[command]) {
        userStats[user].commands[command] = 1;
      } else {
        userStats[user].commands[command]++;
      }
      userStats[user].count++;
    });
    
    // Format usage statistics
    const usageReport = userOrder.map((user, index) => {
      const userCommands = userStats[user].commands;
      const commandList = Object.entries(userCommands)
        .map(([cmd, count]) => cmd + " " + (count <= 1 ? '' : '(' + count + ')'))
        .join(", ");
      return `*${(index + 1)} -- @${user.split('@')[0]}'s ➪ ${userStats[user].count}*  \n *LIST ➪*  _${commandList.trim()}_`;
    }).join("\n\n");
    
    var responseText = (`*LIST OF COMMANDS USED TODAY!*\n_Note: Data will be reset when bot restart!_\n\n*Total Users: _${userOrder.length}_*\n*Total Command Used: _${commandHistory.length}_*\n\n${usageReport}\n\n${Config.caption}`).trim();
    
    await message.send(responseText, {
      'contextInfo': {
        ...(await message.bot.contextInfo("HISTORY"))
      },
      'mentions': [...userOrder]
    }, "empire", message);
  } catch (error) {
    await message.error(error + "\n\ncommand : cmdused", error, "*ERROR!*");
  }
});

