const saveSetCmdAlias = async (Void) => {
  const botId = getBotDbId(Void);
  await bot_.findOne({ id: botId }) || await bot_.new({ id: botId });
  await bot_.updateOne({ id: botId }, { setcmd: { ...global.setCmdAlias } });
};
