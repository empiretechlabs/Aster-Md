// ==================== READMORE COMMAND ====================
smd({
  pattern: 'readmore',
  alias: ["rmore", 'readmor'],
  desc: "Adds *readmore* in given text.",
  category: "general",
  filename: __filename
}, async (message, text) => {
  try {
    let inputText = text ? text : message.reply_text;
    if (!inputText) {
      inputText = "*Uhh Dear,Please provide text*\n*Eg:- _.readmor text1 readmore text2_*";
    } else {
      inputText += " ";
    }
    
    if (inputText.includes('readmore')) {
      await message.reply(inputText.replace(/readmore/, String.fromCharCode(0x200e).repeat(4001)));
    } else {
      await message.reply(inputText.replace(" ", String.fromCharCode(0x200e).repeat(4001)));
    }
  } catch (error) {
    await message.error(error + "\n\ncommand : readmore", error, false);
  }
});

// ==================== URL COMMAND ====================
let pmtypes = ["videoMessage", "imageMessage"];

cmd({
  pattern: "url",
  alias: ['createurl'],
  category: "general",
  filename: __filename,
  desc: "image to url.",
  use: "<video | image>"
}, async (message) => {
  try {
    let mediaMessage = pmtypes.includes(message.mtype) ? message : message.reply_message;
    if (!mediaMessage || !pmtypes.includes(mediaMessage?.["mtype"])) {
      return message.reply(langText("msgs", "reply_image_video", {}, message.userLang || global.currentUserLang));
    }
    let mediaPath = await message.bot.downloadAndSaveMediaMessage(mediaMessage);
    let url = await createUrl(mediaPath, "catbox");
    if (!url) {
      return message.reply(langText("msgs", "url_failed", {}, message.userLang || global.currentUserLang));
    }
    try {
      fs.unlink(mediaPath);
    } catch {}
    await message.send(util.format(url), {}, "empire", mediaMessage);
  } catch (error) {
    await message.error(error + "\n\ncommand url", error);
  }
});

// ==================== UPLOAD COMMAND ====================
cmd({
  pattern: "upload",
  alias: ['url2'],
  category: "general",
  filename: __filename,
  desc: "image to url.",
  use: "<video | image>"
}, async (message) => {
  try {
    let mediaMessage = pmtypes.includes(message.mtype) ? message : message.reply_message;
    if (!mediaMessage || !pmtypes.includes(mediaMessage?.["mtype"])) {
      return message.reply(langText("msgs", "reply_image_video", {}, message.userLang || global.currentUserLang));
    }
    let mediaPath = await message.bot.downloadAndSaveMediaMessage(mediaMessage);
    let uploadResult = await createUrl(mediaPath, "catbox");
    try {
      fs.unlink(mediaPath);
    } catch {}
    let uploadUrl = typeof uploadResult === "string" ? uploadResult : uploadResult?.url;
    if (!uploadUrl) {
      return message.reply(langText("msgs", "url_failed", {}, message.userLang || global.currentUserLang));
    }
    await message.send(util.format(uploadUrl), {}, 'empire', mediaMessage);
  } catch (error) {
    await message.error(error + "\n\ncommand upload", error);
  }
});

// ==================== CALC COMMAND ====================
smd({
  pattern: 'calc',
  desc: "calculate an equation.",
  category: "general",
  use: "<equation>",
  filename: __filename
}, async (message, equation) => {
  try {
    if (!equation) {
      return await message.reply(langText("msgs", "calc_need", {}, message.userLang || global.currentUserLang));
    }
    
    let cleanEquation = equation.replace(/\s+/g, '');
    if (!/^(\d+([-+%*/]\d+)+)$/.test(cleanEquation)) {
      return await message.reply("Please enter a valid mathematical operation.");
    }
    
    const result = new Function("return " + cleanEquation)();
    
    if (cleanEquation.includes('/') && cleanEquation.split('/').some(part => part === '0')) {
      return message.reply("Cannot divide by zero.");
    }
    
    if (cleanEquation.split(/[-+%*/]/).length <= 2) {
      const [num1, operator, num2] = cleanEquation.match(/\d+|[-+%*/]/g);
      return await message.reply(num1 + " " + operator + " " + num2 + " = " + result);
    } else {
      return await message.reply("Result: " + result);
    }
  } catch (error) {
    return await message.error(error + "\n\ncommand: calc", error);
  }
});

// ==================== DATE TIME FUNCTION ====================
async function getDateTime() {
  const now = new Date();
  const date = now.toISOString().slice(0, 10);
  const time = now.toLocaleTimeString();
  return { date: date, time: time };
}

