// ==================== TRANSLATE COMMAND ====================
empireMd.cmd({
  pattern: "trt",
  alias: ["translate"],
  category: "general",
  filename: __filename,
  use: "< text >",
  desc: "Translate's given text in desird language."
}, async (message, input) => {
  try {
    let targetLanguage = input ? input.split(" ")[0].toLowerCase() : 'en';
    
    if (!message.reply_text) {
      var textToTranslate = input.replace(targetLanguage, '')?.trim() || false;
    } else {
      var textToTranslate = message.reply_text;
    }

    if (!textToTranslate) {
      return await message.reply(langText("general", "translate_example", { prefix }, message.userLang || global.currentUserLang));
    }

    var translationResult = await translatte(textToTranslate, { from: "auto", to: targetLanguage });

    if ("text" in translationResult) {
      return await message.reply(translationResult.text);
    }
  } catch (error) {
    await message.error(error + "\n\ncommand trt", error);
  }
});

// ==================== FILE COMMAND ====================
const readDirectory = (directoryPath) => {
  return new Promise((resolve, reject) => {
    fs.readdir(directoryPath, (error, files) => {
      if (error) {
        reject("Error reading directory");
      } else {
        resolve(files);
      }
    });
  });
};

empireMd.cmd({
  pattern: 'file',
  desc: "to get extact name where that command is in repo.\nSo user can edit that.",
  category: "general",
  fromMe: true,
  filename: __filename
}, async (message, input) => {
  try {
    if (!input) {
      return message.reply(langText("msgs", "provide_cmd", {}, message.userLang || global.currentUserLang));
    }

    // If input starts with '.', treat as directory path
    if (input.startsWith('.')) {
      let fileList = "*------------- FILE MANAGER -------------*\n";
      try {
        const files = await readDirectory(input);
        files.forEach(file => {
          fileList += file + "\n";
        });
        await message.reply(fileList.toString());
      } catch (error) {
        message.reply(error);
      }
      return;
    }

    let commandDetails = [];
    let searchTerm = input.split(" ")[0].toLowerCase().trim();

    let foundCommand = empireMd.commands.find(cmd => cmd.pattern === searchTerm) || 
                       empireMd.commands.find(cmd => cmd.alias && cmd.alias.includes(searchTerm));

    if (!foundCommand) {
      return await message.reply(langText("msgs", "no_cmd", {}, message.userLang || global.currentUserLang));
    }

    commandDetails.push("*🍁Command:* " + foundCommand.pattern);
    if (foundCommand.category) {
      commandDetails.push("*🧩Type:* " + foundCommand.category);
    }
    if (foundCommand.alias && foundCommand.alias[0]) {
      commandDetails.push("*🧩Alias:* " + foundCommand.alias.join(", "));
    }
    if (foundCommand.desc) {
      commandDetails.push("*✨Description:* " + foundCommand.desc);
    }
    if (foundCommand.use) {
      commandDetails.push("*〽️Usa:*\n ```" + prefix + foundCommand.pattern + " " + foundCommand.use + "```");
    }
    if (foundCommand.usage) {
      commandDetails.push("*〽️Usage:*\n ```" + foundCommand.usage + "```");
    }
    if (foundCommand.filename) {
      commandDetails.push("*✨FileName:* " + foundCommand.filename);
    }

    try {
      if (input.includes("function") && foundCommand["function"] && message.isEmpire && foundCommand.pattern !== 'file') {
        commandDetails.push("*🧩Function:* " + foundCommand["function"].toString());
      }
    } catch {}

    await message.reply(commandDetails.join("\n"));
  } catch (error) {
    await message.error(error + "\nCommand:file", error);
  }
});

// ==================== EVAL COMMAND ====================
empireMd.cmd({
  pattern: "eval",
  alias: ['$'],
  category: "owner",
  filename: __filename,
  fromMe: true,
  desc: "Runs js code on node server.",
  use: "< run code >",
  dontAddCommandList: true
}, async (message, code, { isCreator, cmdName, Void }) => {
  try {
    if (!code) {
      return message.reply(langText("general", "provide_query", {}, message.userLang || global.currentUserLang));
    }

    let result = eval("const a = async()=>{\n" + code + "\n}\na()");

    if (typeof result === "object") {
      await message.reply(JSON.stringify(result));
    } else {
      await message.reply(result.toString());
    }
  } catch (error) {
    return await message.reply(error.toString());
  }
});

// ==================== SHELL COMMAND ====================
empireMd.cmd({
  pattern: 'shell',
  category: "owner",
  filename: __filename,
  fromMe: true,
  desc: "Runs command in Heroku(server) shell.",
  use: "<shell cmds | ls,cd >",
  dontAddCommandList: true
}, async (message, command) => {
  try {
    if (!message.isCreator) {
      return message.reply(tlang().owner);
    }
    if (!command) {
      return message.reply(langText("general", "provide_heroku_cmd", {}, message.userLang || global.currentUserLang));
    }

    exec(command, (error, stdout) => {
      if (error) {
        return message.reply("----" + tlang().title + "----\n\n" + error);
      }
      if (stdout) {
        return message.reply('----' + tlang().title + "----\n\n" + stdout);
      }
    });
  } catch (error) {
    await message.error(error + "\n\ncommand shell", error);
  }
});

// ==================== TEXT EVENT HANDLER (Menu Selection & Cron) ====================
smd({
  on: 'text'
}, async (msg, text, { mek, body, args, botNumber, isCreator, icmd, store, budy, Empire, Void, proto }) => {
  try {
    // Start cron job to clean temp directory every 15 minutes
    if (!cronStart) {
      cron.schedule("*/15 * * * *", () => {
        cronStart = true;
        fs.readdir('./temp', (error, files) => {
          if (error) {
            return;
          }
          files.forEach(file => {
            try {
              fs.unlink('./temp/' + file);
            } catch {}
          });
        });
      });
    }

    if (!msg.reply_message || !text || !msg.isPublic) {
      return;
    }

    const replyLines = msg.reply_message.text.split("\n");

    // Handle fancy text selection by number
    let selectedNumber = parseInt(text.split(" ")[0]);
    if (!isNaN(selectedNumber)) {
      if (replyLines.length > 30 && replyLines[1].includes('EMPIRE-MD_FANCY_TEXT')) {
        var selectedLine = replyLines.find(line => line.startsWith(selectedNumber + " "));
        try {
          if (selectedLine) {
            await msg.send(selectedLine.replace('' + selectedNumber, '').trim(), {}, '', msg);
          } else {
            '';
          }
        } catch {}
      }
    }

    // Handle menu category selection by decimal number
    let categoryNumber = parseFloat(text.split(" ")[0]);
    if (isNaN(categoryNumber)) {
      return;
    }

    let formattedNumber = categoryNumber.toFixed(1);
    var matchingLine = replyLines.find(line => line.startsWith('*' + formattedNumber + " "));

    if (matchingLine && (matchingLine.endsWith("COMMANDS*") || matchingLine.endsWith("MENU*"))) {
      var categoryName = matchingLine.replace('*' + formattedNumber, '')
        .replace('|', '')
        .replace(/COMMANDS\*/gi, '')
        .replace(/MENU\*/gi, '')
        .toLowerCase();

      if (categoryName.length > 0 && categoryName.length < 20) {
        const { commands: cmdList } = require("../lib");
        const categorizedCommands = {};

        cmdList.forEach(cmd => {
          if (!cmd.dontAddCommandList && cmd.pattern !== undefined) {
            if (!categorizedCommands[cmd.category]) {
              categorizedCommands[cmd.category] = [];
            }
            categorizedCommands[cmd.category].push({
              command: cmd.pattern,
              info: cmd.desc,
              help: prefix + cmd.pattern + " " + (cmd.use ? cmd.use : '')
            });
          }
        });

        let categoryOutput = false;
        for (const category in categorizedCommands) {
          let categoryLower = '' + category.toLowerCase();
          if (categoryName.includes(categoryLower)) {
            categoryOutput = "┏━━━━━━━━━━━━━━━━━━━━━━━\n┃\t*EMPIRE-MD_" + 
              category.toUpperCase() + "_COMMANDS*  \n┗━━━━━━━━━━━━━━━━━━━━━━━\n\n\n";
            
            categorizedCommands[category].forEach(cmdInfo => {
              categoryOutput += "*🍁Command:* ```" + cmdInfo.command + "``` " + 
                (cmdInfo.info ? "\n*🧩Info:* ```" + cmdInfo.info + "```" : '') + 
                "\n*〽️Help:* ```" + cmdInfo.help + "```\n\n";
            });
            categoryOutput += "\n\n" + Config.caption;
            break;
          }
        }

        if (categoryOutput) {
          return await msg.sendUi(msg.from, { caption: categoryOutput });
        }
      }
    }
  } catch (error) {
    console.log("ERROR : ", error);
  }
});

// ==================== MASTER TEXT EVENT HANDLER (Eval shortcuts) ====================
smd({
  on: "text"
}, async (msg, text, { mek, body, args, botNumber, isCreator, icmd, store, budy, Empire, Void, proto }) => {
  const { send, reply, react, sendMessage } = msg;

  if (msg.isCreator) {
    // Handle '>' prefix for synchronous eval
    if (!Config.HANDLERS.includes('>') && msg.text.startsWith('>')) {
      let code = budy.slice(1);
      if (!code) {
        return msg.reply("Provide me with a query to run Master!");
      }
      try {
        let result = eval(code);
        if (result) {
          return msg.reply(util.format(result));
        }
      } catch (error) {
        return msg.reply(util.format(error));
      }
    }
    // Handle '$' prefix for async eval
    else if (!Config.HANDLERS.includes('$') && msg.text.startsWith('$')) {
      let code = budy.slice(1);
      if (!code) {
        return msg.reply("Provide me with a query to run Master!");
      }
      try {
        let result = await eval("const a = async()=>{\n" + code + "\n}\na()");
        await msg.react('🍁');
        if (result) {
          return await msg.reply(util.format(result));
        }
      } catch (error) {
        console.log("ERROR FROM RUNNING QUERY WITH MASTER $\n", error);
        return await msg.reply(util.format(error));
      }
    }
  }
});

function formatAfkDuration(startTime = 0) {
  const elapsed = Math.max(1, Math.floor((Date.now() - Number(startTime || 0)) / 1000));
  return runtime(elapsed);
}

function loadAfkMap(botData = {}) {
  if (!botData.afk) return {};
  if (typeof botData.afk === "string") {
    try {
      return JSON.parse(botData.afk);
    } catch {
      return {};
    }
  }
  return typeof botData.afk === "object" ? botData.afk : {};
}

function normalizeAfkJid(jid = "") {
  return jid && jid.includes("@") ? jid : jid ? jid.replace(/[^0-9]/g, "") + "@s.whatsapp.net" : "";
}

async function getAfkData(botNumber) {
  return (await bot_.findOne({ id: "bot_" + botNumber })) || (await bot_.new({ id: "bot_" + botNumber }));
}

// ==================== AFK COMMANDS ====================
smd({
  pattern: "afk",
  alias: ["away"],
  desc: "Set yourself as AFK.",
  category: "general",
  filename: __filename
}, async (message, input, { botNumber }) => {
  try {
    const botData = await getAfkData(botNumber);
    const afk = loadAfkMap(botData);
    const reason = (input || "AFK").trim();
    const botJid = normalizeAfkJid(botNumber);

    afk[message.sender] = {
      reason,
      time: Date.now(),
      name: message.senderName || message.pushName || message.sender.split("@")[0],
      owner: message.sender === botJid
    };

    await bot_.updateOne({ id: "bot_" + botNumber }, { afk });
    return await message.reply(langText("general", "afk_enabled", { reason }, message.userLang || global.currentUserLang));
  } catch (error) {
    await message.error(error + "\n\ncommand: afk", error, "*Could not set AFK.*");
  }
});

smd({
  pattern: "unafk",
  alias: ["back"],
  desc: "Remove your AFK status.",
  category: "general",
  filename: __filename
}, async (message, input, { botNumber }) => {
  try {
    const botData = await getAfkData(botNumber);
    const afk = loadAfkMap(botData);
    const oldAfk = afk[message.sender];

    if (!oldAfk) return await message.reply(langText("general", "afk_not", {}, message.userLang || global.currentUserLang));

    delete afk[message.sender];
    await bot_.updateOne({ id: "bot_" + botNumber }, { afk });

    return await message.reply(langText("general", "afk_back", { duration: formatAfkDuration(oldAfk.time) }, message.userLang || global.currentUserLang));
  } catch (error) {
    await message.error(error + "\n\ncommand: unafk", error, "*Could not remove AFK.*");
  }
});

smd({
  on: "main",
  filename: __filename
}, async (message, text, { botNumber, icmd }) => {
  try {
    if (icmd || message.fromMe) return;

    const botJid = normalizeAfkJid(botNumber);
    const targets = new Set([...(message.mentionedJid || [])]);
    if (message.quoted?.sender) targets.add(message.quoted.sender);

    if (!message.isGroup && botJid) targets.add(botJid);

    targets.delete(message.sender);

    if (!targets.size) return;

    const botData = await getAfkData(botNumber);
    const afk = loadAfkMap(botData);
    const notices = [];
    const mentions = [];

    for (const jid of targets) {
      if (!afk[jid]) continue;
      const isOwnerAfk = jid === botJid || afk[jid].owner;
      mentions.push(jid);
      notices.push(
        (isOwnerAfk ? "*The owner is AFK*" : "*@" + jid.split("@")[0] + " is AFK*") + "\n" +
        "*Reason:* " + (afk[jid].reason || "AFK") + "\n" +
        "*Time:* " + formatAfkDuration(afk[jid].time)
      );
    }

    if (notices.length) {
      return await message.reply(notices.join("\n\n"), { mentions });
    }
  } catch (error) {
    console.log("AFK main handler error:", error);
  }
});

// ==================== ALIVE COMMAND ====================
smd({
  pattern: "alive",
  desc: "Checks if bot is online, or updates alive message.",
  category: "general",
  filename: __filename
}, async (message, input, { prefix, botNumber }) => {
  try {
    let botData = (await bot_.findOne({ id: "bot_" + botNumber })) || (await bot_.new({ id: 'bot_' + botNumber }));
    
    if (input) {
      // If input is "info" or "get", show current alive settings
      if (input.toLowerCase() === "info" || input.toLowerCase() === "get") {
        let infoText = `*『 ALIVE SETTINGS 』*\n\n` +
          `*Message:* ${botData.alive_text}\n` +
          `*Media URL:* ${botData.alive_url || "Not Set"}\n` +
          `*Media Type:* ${botData.alive_image ? "Image" : botData.alive_video ? "Video" : "None"}\n\n` +
          `*To update alive message:* \`${prefix}alive <your_new_message>\`\n` +
          `*To update alive image URL:* \`${prefix}aliveurl <image_url>\``;
        return await message.reply(infoText);
      }
      
      // Update alive text in database
      await bot_.updateOne({ id: "bot_" + botNumber }, { alive_text: input });
      return await message.reply(`*🎉 Alive message updated successfully!*\n\n*New message:* ${input}`);
    }
    
    // Default: Send alive message
    let baseText = botData.alive_text || `*ι αм σηℓιηє нσω ¢αη ι нєℓρ уσυ*`;
    let formattedText = baseText
      .replace(/&user/g, "@" + message.sender.split('@')[0])
      .replace(/&uptime/g, runtime(process.uptime()))
      .replace(/&prefix/g, prefix);
      
    let mentions = [message.sender];
    
    if (botData.alive_url && (botData.alive_image || botData.alive_video)) {
      let type = botData.alive_image ? "image" : "video";
      return await message.send(botData.alive_url, {
        caption: formattedText,
        mentions: mentions
      }, type, message);
    } else {
      return await message.send(formattedText, {
        mentions: mentions
      }, "text", message);
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: alive", error);
  }
});

// ==================== ALIVEURL COMMAND ====================
smd({
  pattern: "aliveurl",
  desc: "Updates bot's alive media URL.",
  category: "general",
  fromMe: true,
  filename: __filename
}, async (message, input, { botNumber }) => {
  try {
    if (!input) {
      return await message.reply(`*Please specify an image/video URL.*\nExample: \`.aliveurl https://example.com/image.jpg\``);
    }
    
    let isVideo = /\.(mp4|gif)/gi.test(input);
    let isImage = /\.(jpg|jpeg|png|webp)/gi.test(input) || !isVideo;
    
    await bot_.updateOne({ id: "bot_" + botNumber }, {
      alive_url: input,
      alive_image: isImage,
      alive_video: isVideo
    });
    
    return await message.reply(`*🎉 Alive media URL updated successfully!*\n\n*URL:* ${input}\n*Type:* ${isImage ? "Image" : "Video"}`);
  } catch (error) {
    await message.error(error + "\n\ncommand: aliveurl", error);
  }
});
