// ==================== MENU COMMAND ====================
empireMd.cmd({
  cmdname: "menu",
  desc: "Help list",
  type: "general",
  filename: __filename
}, async (message, input) => {
  try {
    const { commands: cmdList } = require("../lib");

    // If a specific command is provided, show its details
    if (input.split(" ")[0]) {
      let commandDetails = [];
      const foundCommand = cmdList.find(cmd => cmd.pattern === input.split(" ")[0].toLowerCase());
      
      if (foundCommand) {
        commandDetails.push("*🍁Command:* " + foundCommand.pattern);
        if (foundCommand.category) {
          commandDetails.push("*🧩Category:* " + foundCommand.category);
        }
        if (foundCommand.alias && foundCommand.alias[0]) {
          commandDetails.push("*🧩Alias:* " + foundCommand.alias.join(", "));
        }
        if (foundCommand.desc) {
          commandDetails.push("*🧩Description:* " + foundCommand.desc);
        }
        if (foundCommand.use) {
          commandDetails.push("*〽️Usa:*\n ```" + prefix + foundCommand.pattern + " " + foundCommand.use + "```");
        }
        if (foundCommand.usage) {
          commandDetails.push("*〽️Usage:*\n ```" + foundCommand.usage + "```");
        }
        await message.reply(commandDetails.join("\n"));
      }
    }

    // Menu style variables
    var menuHeader;
    var menuItemPrefix;
    var menuFooter;
    var categoryHeader;
    var categoryTitleSuffix;
    var commandSeparator;
    var categoryFooter;

    let menuStyle = 0;
    if (Config.menu === '') {
      menuStyle = Math.floor(Math.random() * 4) + 1;
    }

    // Style 1: Aztec
    if (menuStyle == 1 || Config.menu.trim().startsWith('1') || Config.menu.toLowerCase().includes('aztec')) {
      menuHeader = "┏━━⟪ *" + Config.botname + "* ⟫━━⦿";
      menuItemPrefix = "┃ ✗";
      menuFooter = "┗━━━━━━━━━━━━━━━⦿";
      categoryHeader = '┌──『';
      categoryTitleSuffix = "』──❖\n";
      commandSeparator = " | ";
      categoryFooter = "\n└──────────────◉";
    }
    // Style 2: a17
    else if (menuStyle == 2 || Config.menu.trim().startsWith('2') || Config.menu.toLowerCase().includes("a17")) {
      menuHeader = "┌───═[ *" + Config.botname + "* ]═──▸\n│╭────────────···▸\n┴│▸";
      menuItemPrefix = "⬡│▸";
      menuFooter = "┬│▸\n│╰─────────────···▸\n└───────────────···▸";
      categoryHeader = '┌───〈';
      categoryTitleSuffix = "〉───◆\n│╭─────────────···▸\n┴│▸";
      commandSeparator = "⬡│▸ ";
      categoryFooter = "┬│▸\n│╰────────────···▸▸\n└───────────────···▸";
    }
    // Style 3: Default
    else {
      menuHeader = "╭────《  " + Config.botname + "  》────⊷\n│ ╭──────✧❁✧──────◆";
      menuItemPrefix = "│ │";
      menuFooter = "│ ╰──────✧❁✧──────◆\n╰══════════════════⊷";
      categoryHeader = '╭────❏';
      categoryTitleSuffix = '❏';
      commandSeparator = '│';
      categoryFooter = "╰━━━━━━━━━━━━━━──⊷";
    }

    // Build categorized commands
    const categorizedCommands = {};
    cmdList.map(async (cmd, index) => {
      if (cmd.dontAddCommandList === false && cmd.pattern !== undefined) {
        if (!categorizedCommands[cmd.category]) {
          categorizedCommands[cmd.category] = [];
        }
        categorizedCommands[cmd.category].push(cmd.pattern);
      }
    });

    const currentTime = message.time;
    const currentDate = message.date;

    let menuText = menuHeader + "\n" + 
      menuItemPrefix + " Theme:- " + tlang().title + "\n" + 
      menuItemPrefix + " Owner:- " + Config.ownername + "\n" + 
      menuItemPrefix + " Plugins:- " + cmdList.length + "\n" + 
      menuItemPrefix + " Uptime:- " + runtime(process.uptime()) + "\n" + 
      menuItemPrefix + " Mem:- " + formatp(os.totalmem() - os.freemem()) + '/' + formatp(os.totalmem()) + "\n" + 
      menuItemPrefix + " Time:- " + currentTime + "\n" + 
      menuItemPrefix + " Date:- " + currentDate + "\n" + 
      menuFooter + "\n\n";

    // Sort commands within each category
    for (const cat in categorizedCommands) {
      categorizedCommands[cat].sort();
    }
    for (const category of Object.keys(categorizedCommands).sort()) {
      menuText += categoryHeader + " *" + tiny(category) + "* " + categoryTitleSuffix + "\n";
      
      if (input.toLowerCase() == category.toLowerCase()) {
        menuText = categoryHeader + " *" + tiny(category) + "* " + categoryTitleSuffix + "\n";
        for (const cmdPattern of categorizedCommands[category]) {
          menuText += commandSeparator + " " + fancytext(cmdPattern, 1) + "\n";
        }
        menuText += categoryFooter + "\n";
        break;
      } else {
        for (const cmdPattern of categorizedCommands[category]) {
          menuText += commandSeparator + " " + fancytext(cmdPattern, 1) + "\n";
        }
        menuText += categoryFooter + "\n";
      }
    }

    menuText += Config.caption;
    let menuData = { caption: menuText };
    return await message.sendUi(message.chat, menuData, message);
  } catch (error) {
    await message.error(error + "\nCommand:menu", error);
  }
});

