// ==================== CPU COMMAND ====================
smd({
  pattern: 'cpu',
  desc: "To check bot status",
  category: "general",
  filename: __filename
}, async (message) => {
  try {
    const memoryUsage = process.memoryUsage();
    const cpus = os.cpus().map(cpu => {
      cpu.total = Object.keys(cpu.times).reduce((last, type) => last + cpu.times[type], 0);
      return cpu;
    });
    
    const totalCpu = cpus.reduce((last, cpu, index, { length }) => {
      last.total += cpu.total;
      last.speed += cpu.speed / length;
      last.times.user += cpu.times.user;
      last.times.nice += cpu.times.nice;
      last.times.sys += cpu.times.sys;
      last.times.idle += cpu.times.idle;
      last.times.irq += cpu.times.irq;
      return last;
    }, {
      speed: 0,
      total: 0,
      times: {
        user: 0,
        nice: 0,
        sys: 0,
        idle: 0,
        irq: 0
      }
    });
    
    const timestampe = speed();
    const latensie = speed() - timestampe;
    const startTime = speed();
    const endTime = speed();
    
    respon = (
      "*❲❒❳ " + Config.botname + " Server Info ❲❒❳*\n\n" +
      "  *❲❒❳ Runtime:* " + runtime(process.uptime()) + "\n" +
      "  *❲❒❳ Speed:* " + latensie.toFixed(3) + '/' + (endTime - startTime).toFixed(3) + " ms\n" +
      "  *❲❒❳ RAM:* " + formatp(os.totalmem() - os.freemem()) + " / " + formatp(os.totalmem()) + "\n\n" +
      "  *❲❒❳ Memory Usage:*\n      " + 
      Object.keys(memoryUsage).map((key, i, arr) => 
        key.padEnd(Math.max(...arr.map(k => k.length)), " ") + ": " + formatp(memoryUsage[key])
      ).join("\n      ") + "\n\n" +
      (cpus[0] ? 
        "  *❲❒❳ Total CPU Usage:*\n  *" + cpus[0].model.trim() + " (" + totalCpu.speed + " MHZ)*\n      " + 
        Object.keys(totalCpu.times).map(type => 
          '-' + (type + '').padEnd(6) + ": " + (100 * totalCpu.times[type] / totalCpu.total).toFixed(2) + '%'
        ).join("\n      ") + "\n\n" +
        "  *❲❒❳ CPU Core Usage (" + cpus.length + " Core CPU)*\n  " + 
        cpus.map((cpu, i) => 
          "*Core " + (i + 1) + ": " + cpu.model.trim() + " (" + cpu.speed + " MHZ)*\n      " + 
          Object.keys(cpu.times).map(type => 
            '-' + (type + '').padEnd(6) + ": " + (100 * cpu.times[type] / cpu.total).toFixed(2) + '%'
          ).join("\n      ")
        ).join("\n\n") 
      : '') + "\n"
    ).trim();
    
    return await message.send(respon, {}, '', message);
  } catch (error) {
    await message.error(error + "\n\ncommand: cpu", error, "*_No responce from Server side, Sorry!!_*");
  }
});

// ==================== ADVT COMMAND (Advertisement) ====================
smd({
  pattern: "advt",
  alias: ["advertisement"],
  category: 'general',
  desc: "Advertise of your Message, by sending it to provided nmbr range.",
  use: "9231844741xx,Your_text_here",
  fromMe: true,
  filename: __filename
}, async (message, input) => {
  try {
    let userInput = input ? input : message.reply_text;
    if (!userInput) {
      return await message.reply(
        "*Advertise of your Message*\n*by sending it to provided nmbr range.*\n" +
        prefix + "advt 9231844741xx,Your_text_here"
      );
    }
    
    const commaIndex = userInput.indexOf(',');
    if (commaIndex === -1) {
      return await message.send("*Invalid format. Please provide number and Message separated by a comma.*");
    }
    
    let numberTemplate = '' + userInput.slice(0, commaIndex).trim();
    let messageText = userInput.slice(commaIndex + 1).trim() + "\n\n\n" + Config.caption;
    
    if (!numberTemplate.includes('x')) {
      return message.send(
        "*You did not add x in number.*\n*Ex: " + prefix + "advt 9231844741xx,Your_Message_here*  \n " + Config.caption
      );
    }
    
    await message.send("*Sending message to given number range.!*\n*It may take some time, so wait please*");
    
    var prefix_num = numberTemplate.split('x')[0];
    var suffix_num = numberTemplate.split('x')[numberTemplate.split('x').length - 1] ? numberTemplate.split('x')[numberTemplate.split('x').length - 1] : '';
    var xCount = numberTemplate.split('x').length - 1;
    var loopCount;
    
    if (xCount == 1) {
      loopCount = 10;
    } else if (xCount == 2) {
      loopCount = 100;
    } else if (xCount == 3) {
      loopCount = 1000;
    } else if (xCount > 3) {
      return await message.send("*Only 3(x) are Allowed in number*");
    }
    
    let sentCount = 0;
    let sentUsers = '';
    var lastUser = '';
    
    for (let i = 0; i < loopCount; i++) {
      var checkResult = await message.bot.onWhatsApp('' + prefix_num + i + suffix_num + "@s.whatsapp.net");
      if (checkResult[0]) {
        lastUser = checkResult[0].jid;
        if (sentUsers.includes(lastUser)) {
          continue;
        }
        await sleep(1500);
        await message.bot.sendMessage(lastUser, { text: messageText });
        sentUsers = sentUsers + ',' + lastUser;
        sentCount += 1;
      }
    }
    
    return await message.send(
      "*_Advertisement of your Message is Done,_* \n\n" +
      "*_Message Succesfully sent to " + sentCount + " chats_*\n" +
      "Last_User: " + lastUser.split('@')[0] + "\n" +
      "Search_No: " + loopCount + " number searched\n\n\n" + Config.caption
    );
  } catch (error) {
    await message.error(error + "\n\ncommand: dalle", error, "*_No responce from Server side, Sorry!!_*");
  }
});

// ==================== ANONYMOUS MESSAGE SYSTEM ====================
const empireMdAnonyMsg = {};
let isAnnonyMsgAlive = '';

class AnonymousMsg {
  constructor() {
    this.id = '';
    this.sender = '';
    this.reciever = '';
    this.senderMsg = '';
    this.tellinfo = 0;
    this.howmanyreply = 0;
  }
}

// ==================== ANONYMSG COMMAND ====================
smd({
  pattern: "anonymsg",
  alias: ["recognition", 'anonychat'],
  desc: "Send message Annonymously",
  category: 'general',
  use: "<Hii, Empire Tech Labs>",
  filename: __filename
}, async (message, input, { smd: commandName }) => {
  try {
    let userInput = input ? input : message.reply_text;
    if (!userInput) {
      return await message.send(
        "*provide number with msg to send Anonymously.* \n" +
        "*Example " + (prefix + commandName) + " 923184474176,your_Message*",
        {}, '', message
      );
    }
    
    if (message.isCreator && userInput === "info") {
      return await message.reply(
        isAnnonyMsgAlive == '' ? 
        "*Theres no Anonymous Chat created yet*" : 
        "*Anonymous Chat Recivers*\n_" + isAnnonyMsgAlive + '_'
      );
    }
    
    const commaIndex = userInput.indexOf(',');
    if (commaIndex === -1) {
      return await message.reply(langText("msgs", "invalid_format", {}, message.userLang || global.currentUserLang));
    }
    
    let targetNumber = userInput.slice(0, commaIndex).trim() + "@s.whatsapp.net";
    let messageContent = userInput.slice(commaIndex + 1).trim();
    let parsedNumbers = (await parsedJid(targetNumber)) || [];
    
    if (parsedNumbers[0]) {
      const { date: currentDate, time: currentTime } = await getDateTime();
      const msgId = "anony-msg-" + Math.floor(100000 + Math.random() * 900000);
      
      empireMdAnonyMsg[msgId] = new AnonymousMsg();
      let anonyMsg = empireMdAnonyMsg[msgId];
      anonyMsg.id = msgId;
      anonyMsg.sender = message.sender;
      anonyMsg.reciever = parsedNumbers[0];
      anonyMsg.msgStatus = true;
      anonyMsg.senderMsg = message;
      
      messageContent = "*ᴇᴍᴘɪʀᴇ-ᴍᴅ • ᴀɴɴᴏɴʏᴍᴏᴜs ᴍsɢ*\n\n" +
        "*Msg_Id:* " + anonyMsg.id + "\n" +
        "*Date:* _" + currentDate + "_\n" +
        "*Time:* _" + currentTime + "_\n\n" +
        "*Message:* " + messageContent + "\n\n\n" + Config.caption;
      
      isAnnonyMsgAlive = isAnnonyMsgAlive + ',' + anonyMsg.reciever;
      
      await message.bot.sendMessage(anonyMsg.reciever, { text: messageContent });
      return await message.reply(langText("msgs", "anonymous_sent", {}, message.userLang || global.currentUserLang));
    } else {
      return await message.reply(langText("msgs", "invalid_number", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: " + commandName, error, "*_Can't send annonymously message yet, Sorry!!_*");
  }
});

// ==================== ANONYMOUS MESSAGE REPLY HANDLER ====================
smd({
  on: "text"
}, async (message) => {
  try {
    if (message.quoted && message.reply_text && isAnnonyMsgAlive.includes(message.sender) && message.text.length > 2) {
      const replyLines = message.reply_text.split("\n");
      if (replyLines.length < 3) {
        return;
      }
      
      if (message.reply_text.includes("ᴇᴍᴘɪʀᴇ-ᴍᴅ • ᴀɴɴᴏɴʏᴍᴏᴜs ᴍsɢ") && 
          replyLines[0].includes("ᴇᴍᴘɪʀᴇ-ᴍᴅ • ᴀɴɴᴏɴʏᴍᴏᴜs ᴍsɢ") && 
          replyLines[2].includes('Msg_Id')) {
        
        let msgId = replyLines[2].replace(/[*_]/g, '').replace('Msg_Id:', '').trim();
        let anonyMsg = empireMdAnonyMsg[msgId];
        
        if (!anonyMsg) {
          return;
        }
        
        try {
          if (anonyMsg) {
            let command = message.text.split(',')[0].trim();
            if (command.toLowerCase().startsWith("reply")) {
              anonyMsg.howmanyreply += 1;
              const commaIndex = message.text.indexOf(',');
              
              let replyMessage = "*ᴇᴍᴘɪʀᴇ-ᴍᴅ • ʏᴏᴜʀ ᴀɴᴏɴʏ-ᴍsɢ ʀᴇᴘʟʏ*\n\n" +
                "*_From @" + anonyMsg.reciever.split('@')[0] + "_*\n" +
                "*_Msg_Id: " + anonyMsg.id + "_*\n\n" +
                "*Message:* " + message.text.slice(commaIndex + 1).trim() + "\n\n\n\n" + Config.caption;
              
              if (anonyMsg.howmanyreply >= 2) {
                isAnnonyMsgAlive = isAnnonyMsgAlive.replace(',' + message.sender, '');
              }
              
              await message.bot.sendMessage(anonyMsg.sender, {
                text: replyMessage,
                mentions: [anonyMsg.reciever]
              }, {
                quoted: anonyMsg.senderMsg
              });
              
              if (anonyMsg.howmanyreply >= 2) {
                isAnnonyMsgAlive = isAnnonyMsgAlive.replace(',' + message.sender, '');
                delete empireMdAnonyMsg[msgId];
              }
              
              return await message.reply(
                "*_Your Message succesfully deliver to User_* " + 
                (anonyMsg.howmanyreply == 1 ? "\n*you can reply 1 more time*" : '') + " "
              );
            } else {
              if (anonyMsg.tellinfo === 0) {
                anonyMsg.tellinfo = 1;
                let infoMessage = "*Basically, Its an Annonymous Message*\n\n" +
                  "_Msg_Id: " + anonyMsg.id + "_\n" +
                  "_this message sended by a chatbot_\n" +
                  "_User not wants to expose itself to send that msg_\n\n\n" +
                  "*if you wanna reply to that user,*\n" +
                  "*Send msg by replying to above message*\n" +
                  "*Type like:* reply, Type_your_Message_Here\n" +
                  "*Example:* reply, Can you text me from your number\n\n\n" + Config.caption;
                
                message.bot.sendMessage(anonyMsg.reciever, { text: infoMessage }, { quoted: message });
              } else if (anonyMsg.tellinfo === 1) {
                anonyMsg.tellinfo = 2;
                message.reply(langText("msgs", "reply_format", {}, message.userLang || global.currentUserLang));
              }
            }
          }
        } catch (error) {
          console.log("error : ", error);
        }
      }
    }
  } catch {}
});

// Extracted aitts command to plugins/ai.smd

// ==================== HELP COMMAND ====================
smd({
  cmdname: "help",
  alias: ['categories', "ctgry", "category"],
  desc: "category list",
  category: "general"
}, async (message, input) => {
  try {
    // If a specific command is provided, show its details
    if (input.split(" ")[0]) {
      let commandDetails = [];
      const foundCommand = commands.find(cmd => cmd.pattern === input.split(" ")[0].toLowerCase());
      
      if (foundCommand) {
        commandDetails.push("*🍁Command:* " + foundCommand.pattern);
        if (foundCommand.category) {
          commandDetails.push("*🧩Category:* " + foundCommand.category);
        }
        if (foundCommand.alias && foundCommand.alias[0]) {
          commandDetails.push("*🧩Alias:* " + foundCommand.alias.join(", "));
        }
        if (foundCommand.desc) {
          commandDetails.push("*🧩Description:* " + foundCommand.desc);
        }
        if (foundCommand.use) {
          commandDetails.push("*〽️Usage:*\n ```" + prefix + foundCommand.pattern + " " + foundCommand.use + "```");
        }
        await message.reply(commandDetails.join("\n"));
      }
    }

    // Build category list
    const categorizedCommands = {};
    commands.map(async (cmd, index) => {
      if (cmd.dontAddCommandList === false && cmd.pattern !== undefined) {
        if (!categorizedCommands[cmd.category]) {
          categorizedCommands[cmd.category] = [];
        }
        categorizedCommands[cmd.category].push(cmd.pattern);
      }
    });

    let randomNumber = Math.round(Math.random());
    let menuTitle = randomNumber === 0 ? "MENU" : "COMMANDS";
    
    let outputText = "┏━━━━━━━━━━━━━━━━━━━━━━━━\n┃\t *EMPIRE-MD_" + menuTitle + "_LIST* \n┗━━━━━━━━━━━━━━━━━━━━━━━━\n\n\t```Reply the number you wants to select```\n\n";
    
    let categoryIndex = 1;
    let commandCounter = 0;
    
    // Sort commands within each category
    for (const cat in categorizedCommands) {
      categorizedCommands[cat].sort();
    }
    for (const category of Object.keys(categorizedCommands).sort()) {
      commandCounter += 1;
      
      if (input.toLowerCase() == category.toLowerCase()) {
        outputText = "┏━━⟪ *" + category.toUpperCase() + "* ⟫━━⦿\n\n";
        for (const cmdPattern of categorizedCommands[category]) {
          outputText += "┃ ✗ " + fancytext(cmdPattern, 1) + "\n";
        }
        outputText += "\n┗━━━━━━━━━━━━━━⦿";
        break;
      }
      
      if (commandCounter >= 10) {
        categoryIndex += 1;
        commandCounter = 0;
      }
      outputText += "\n*" + categoryIndex + '.' + commandCounter + " |" + category.toUpperCase() + " " + menuTitle + "*\n";
    }
    
    outputText += "\n\n" + Config.caption;
    return await message.sendUi(message.jid, { caption: outputText });
  } catch (error) {
    await message.error(error + "\nCommand:help", error);
  }
});

