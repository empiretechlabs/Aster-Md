// ==================== SETCMD COMMAND (Set Custom Command) ====================
empireMd.cmd({
  pattern: "setcmd",
  desc: "To check ping",
  category: "general",
  fromMe: true,
  filename: __filename
}, async (message, input, { Void }) => {
  try {
    if (!input) {
      return await message.send("*_Please provide cmd name by replying a Sticker_*");
    }

    let parts = input.split(',');
    var newCommandName;
    var targetCommand;
    let isStickerCommand = false;

    if (message.quoted) {
      let quotedType = message.quoted.mtype;
      if (quotedType == "stickerMessage" && input) {
        isStickerCommand = true;
        targetCommand = input.split(" ")[0];
        newCommandName = stickerCmdKey(message.quoted.msg.fileSha256);
      }
    }

    if (!isStickerCommand && parts.length > 1) {
      newCommandName = parts[0].trim().toLowerCase();
      targetCommand = parts[1].trim().toLowerCase();
    } else if (!isStickerCommand) {
      return await message.send("*_Uhh Dear, Give Cmd With New Name_*\n*Eg: _.setcmd New_Name, Cmd_Name_*");
    }

    if (newCommandName.length < 1) {
      return await message.reply(langText("msgs", "provide_cmd_name", {}, message.userLang || global.currentUserLang));
    }

    if (global.setCmdAlias[newCommandName]) {
      return await message.send("*_\"" + (isStickerCommand ? "Given Sticker" : newCommandName) + 
        "\" Already set for \"" + global.setCmdAlias[newCommandName] + 
        "\" Cmd, Please try another " + (isStickerCommand ? 'Sticker' : "Name") + '_*');
    }

    const foundCommand = empireMd.commands.find(cmd => cmd.pattern === targetCommand) || 
                         empireMd.commands.find(cmd => cmd.alias && cmd.alias.includes(targetCommand));

    if (foundCommand) {
      global.setCmdAlias[newCommandName] = foundCommand.pattern;
      await saveSetCmdAlias(Void);
      return await message.send("*_Cmd \"" + global.setCmdAlias[newCommandName] +
        "\" Succesfully set to \"" + (isStickerCommand ? "Sticker" : newCommandName) +
        "\"._*\n*_Saved to database — survives bot restart._*");
    } else {
      return await message.send("*_Provided Cmd( " + targetCommand + 
        ") not found in bot cmds. Please Provide Valid cmd Name_*");
    }
  } catch (error) {
    await message.error(error + "\nCommand:setcmd", error);
  }
});

// ==================== DELCMD COMMAND (Delete Custom Command) ====================
empireMd.cmd({
  pattern: "delcmd",
  desc: "To check ping",
  category: 'general',
  fromMe: true,
  filename: __filename
}, async (message, input, { Void }) => {
  try {
    let commandName = input ? input.split(" ")[0].trim().toLowerCase() : '';
    let isStickerCommand = false;

    if (message.quoted) {
      if (message.quoted.mtype == "stickerMessage") {
        isStickerCommand = true;
        commandName = stickerCmdKey(message.quoted.msg.fileSha256);
      } else {
        if (!input) {
          return await message.send("*_Please reply to a Sticker that set for a Cmd_*");
        }
      }
    } else {
      if (!input) {
        return await message.send("*_Uhh Dear, provide Name that set to a cmd_*\n*Eg: _.delcmd Cmd_Name_*");
      }
    }

    if (global.setCmdAlias[commandName]) {
      await message.send("*_\"" + (isStickerCommand ? "Given Sticker" : commandName) +
        "\" deleted Succesfully at \"" + global.setCmdAlias[commandName] + "\" cmd_*");
      delete global.setCmdAlias[commandName];
      await saveSetCmdAlias(Void);
      return;
    } else {
      return await message.send("*_\"" + (isStickerCommand ? "Given Sticker" : commandName) + 
        "\" not Set for any cmd._*\n *_Please Provide Valid " + 
        (isStickerCommand ? "Sticker" : "cmd Name") + " to delete_*");
    }
  } catch (error) {
    await message.error(error + "\nCommand:delcmd", error);
  }
});

