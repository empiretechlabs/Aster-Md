// ==================== DAILYMOTION DOWNLOADER ====================
smd({
  pattern: 'dailymotion',
  alias: ['dm', 'dmdl'],
  desc: 'Downloads Dailymotion videos.',
  category: 'downloader',
  filename: __filename,
  use: '<add dailymotion url.>'
}, async (message, url) => {
  try {
    if (!url) {
      return await message.reply(langText("downloader", "dailymotion_url", { prefix }, message.userLang || global.currentUserLang));
    }
    let dmUrl = url.split(' ')[0];
    if (!/dailymotion/.test(dmUrl)) return await message.reply(langText("downloader", "invalid_url", {}, message.userLang || global.currentUserLang));
    let response = await smdJson('https://empiretech-api.hf.space/api/download/dailymotion?apikey=empire&url=' + dmUrl);
    if (!response || !response.success) return await message.reply(langText("downloader", "download_failed", {}, message.userLang || global.currentUserLang));
    let downloads = response.result?.downloads || [];
    if (!downloads.length) return await message.reply(langText("msgs", "video_not_found", {}, message.userLang || global.currentUserLang));
    let videoUrl = downloads[0].url;
    let videoBuffer = await getBuffer(videoUrl);
    return await message.bot.sendMessage(message.chat, { video: videoBuffer, caption: response.result.title || Config.caption, mimetype: 'video/mp4' }, { quoted: message });
  } catch (error) {
    return message.error(error + '\n\ncommand: dailymotion', error, '*_Video not Found_*');
  }
});

// ==================== GITCLONE ====================
smd({
  pattern: 'gitclone',
  desc: 'Downloads git repositories.',
  category: 'downloader',
  filename: __filename,
  use: '<repo url>'
}, async (message, repoUrl) => {
  try {
    if (!repoUrl) {
      return await message.reply(langText("downloader", "provide_repo", {}, message.userLang || global.currentUserLang));
    }
    let gitUrl = repoUrl.split(' ')[0];
    const gitRegex = /(?:https|git)(?::\/\/|@)github\.com[\/:]([^\/:]+)\/(.+)/i;
    if (!gitRegex.test(gitUrl)) return await message.reply(langText("downloader", "invalid_repo", {}, message.userLang || global.currentUserLang));
    let response = await smdJson('https://empiretech-api.hf.space/api/download/gitclone?apikey=efe123&url=' + gitUrl);
    if (!response || !response.success) return await message.reply(langText("downloader", "download_failed", {}, message.userLang || global.currentUserLang));
    let downloadUrl = response.result?.download_url || false;
    let fileName = response.result?.filename || 'repo.zip';
    if (!downloadUrl) return await message.reply(langText("msgs", "not_found", {}, message.userLang || global.currentUserLang));
    await message.bot.sendMessage(message.chat, { document: { url: downloadUrl }, fileName: fileName, mimetype: 'application/zip', caption: Config.caption }, { quoted: message });
  } catch (error) {
    return message.error(error + '\n\ncommand: gitclone', error, '*_File not found!!_*');
  }
});

