// ==================== TELEGRAM STICKERS ====================
smd({
  pattern: 'tgs',
  desc: 'Downloads telegram stickers.',
  category: 'downloader',
  filename: __filename,
  use: '<add sticker url.>'
}, async (message, input) => {
  try {
    if (!input) {
      return await message.reply("_Enter a tg sticker url_\nEg: .tgs https://t.me/addstickers/Oldboyfinal\nKeep in mind that there is a chance of ban if used frequently");
    }
    if (!input.includes('addstickers')) {
      return await message.reply('Provide Valid Repositry Url');
    }
    let stickerSet = input.split('|')[0];
    let setName = stickerSet.split('/addstickers/')[1];
    let { result } = await fetchJson('https://api.telegram.org/bot7025486524:AAGNJ3lMa8610p7OAIycwLtNmF9vG8GfboM/getStickerSet?name=' + encodeURIComponent(setName) + ' ');
    let option = input.split('|')[1] || '';
    let infoMsg = 'Total stickers: ' + result.stickers.length + ' \nEstimated complete in: ' + result.stickers.length * 1.5 + ' seconds\nKeep in mind that there is a chance of a ban if used frequently';
    if (result.is_animated) {
      return await message.reply('Animated stickers are not supported');
    } else if (option.startsWith('info')) {
      return await message.reply(infoMsg);
    }
    let startIndex = parseInt(option.split(',')[0]) || 10;
    let endIndex = parseInt(option.split(',')[1]) || 0;
    let type = option.split(';')[1] || 'Sticker';
    let isImage = true;
    if (type.includes('image')) {
      isImage = false;
      type = 'Photo';
    }
    if (startIndex > result.stickers.length) startIndex = result.stickers.length;
    if (endIndex > result.stickers.length) endIndex = result.stickers.length - 5;
    if (endIndex > startIndex) {
      let temp = startIndex;
      startIndex = endIndex;
      endIndex = temp;
    }
    await message.reply(infoMsg + '\nDownloading as ' + type + ' from index ' + endIndex + ' to ' + startIndex + ' : ' + stickerSet + ' _ \n\n');
    for (endIndex; endIndex < startIndex; endIndex++) {
      let fileData = await fetchJson('https://api.telegram.org/bot7025486524:AAGNJ3lMa8610p7OAIycwLtNmF9vG8GfboM/getFile?file_id=' + result.stickers[endIndex].file_id);
      let fileUrl = 'https://api.telegram.org/file/bot7025486524:AAGNJ3lMa8610p7OAIycwLtNmF9vG8GfboM/' + fileData.result.file_path;
      if (isImage) {
        let buffer = await getBuffer(fileUrl);
        await message.reply(buffer, { packname: Config.packname, author: 'Empire-Md' }, 'sticker');
      } else {
        await message.bot.sendMessage(message.chat, { image: { url: fileUrl }, caption: '*_Telegram Sticker At Index ' + (endIndex + 1) + '*_' });
      }
    }
  } catch (error) {
    await message.error(error + '_Error sending telegram stickers!!!_', error, 'error');
  }
});

// ==================== WIKIMEDIA ====================
smd({
  pattern: 'wikimedia',
  desc: 'Downloads wikimedia images.',
  category: 'downloader',
  filename: __filename,
  use: '<text|search.>'
}, async (message, query) => {
  try {
    if (!query) return await message.send('*_Give Me Search Query_*');
    let { wikimedia } = require('../lib');
    let results = (await wikimedia(query)) || [];
    if (!results || !results[0]) return await message.send('*_No Results Found!_*');
    let limit = message.iscreator && query.split('|')[1] === 'all' ? results.length : results.length > 5 ? 5 : results.length;
    for (let i = 0; i < limit; i++) {
      try {
        message.bot.sendMessage(message.chat, results[i].url, 'image ' + results[i].title + ' \n*Source: ' + results[i].source, message, {}, 'image');
      } catch {}
    }
  } catch (error) {
    await message.error(error + '_Video not Found_', error);
  }
});

// ==================== FACEBOOK ====================
// ==================== FACEBOOK DOWNLOADER ====================
smd({
  pattern: 'facebook',
  alias: ['fb', 'fbdl', 'fbdown'],
  desc: 'Downloads fb videos.',
  category: 'downloader',
  filename: __filename,
  use: '<add fb url.>'
}, async (message, input) => {
  try {
    let fbUrl = input.split(' ')[0];
    if (!fbUrl || !/facebook\.com|fb\.com|fb\.watch/.test(fbUrl)) {
      return await message.send('*_Give me valid Facebook Video Link!_*\n*Example: ' + prefix + 'fb https://www.facebook.com/reel/402579285704851_*');
    }

    let response = await smdJson(
      `https://api.princetechn.com/api/download/facebook?apikey=prince&url=${encodeURIComponent(fbUrl)}`
    );

    if (!response || response.status !== 200 || !response.success || !response.result) {
      return await message.reply(langText("downloader", "download_failed", {}, message.userLang || global.currentUserLang));
    }

    let hdVideo = response.result.hd_video || false;
    let sdVideo = response.result.sd_video || false;
    let videoUrl = hdVideo || sdVideo;
    let thumbnail = response.result.thumbnail || false;

    if (!videoUrl) return await message.reply(langText("msgs", "video_not_found", {}, message.userLang || global.currentUserLang));

    let quality = hdVideo ? 'HD' : 'SD';
    let caption = `*『 Fᴀᴄᴇʙᴏᴏᴋ Dᴏᴡɴʟᴏᴀᴅᴇʀ 』*\n\n` +
      `*📌 Title:* ${response.result.title || 'No description'}\n` +
      `*⏱️ Duration:* ${response.result.duration || 'N/A'}\n` +
      `*🎬 Quality:* ${quality}\n\n` +
      `${Config.caption}`;

    let videoBuffer = await getBuffer(videoUrl);

    return await message.bot.sendMessage(
      message.chat,
      {
        video: videoBuffer,
        caption: caption,
        mimetype: 'video/mp4'
      },
      { quoted: message }
    );

  } catch (error) {
    return message.error(error + '\n\ncommand: facebook', error, '*_Video Not Found!_*');
  }
});

// ==================== TIKTOK DOWNLOADER ====================
smd({
  pattern: 'tiktok',
  alias: ['tt', 'ttdl'],
  desc: 'Downloads Tiktok Videos.',
  category: 'downloader',
  filename: __filename,
  use: '<add tiktok url.>'
}, async (message, url) => {
  try {
    if (!url) {
      return await message.reply(langText("downloader", "tiktok_url", { prefix }, message.userLang || global.currentUserLang));
    }
    let tiktokUrl = url.split(' ')[0];
    if (!/tiktok/.test(tiktokUrl)) {
      return await message.reply(langText("downloader", "invalid_url", {}, message.userLang || global.currentUserLang));
    }

    let response = await smdJson(
      `https://api.princetechn.com/api/download/tiktok?apikey=prince&url=${encodeURIComponent(tiktokUrl)}`
    );

    if (!response || response.status !== 200 || !response.success || !response.result) {
      return await message.reply(langText("downloader", "download_failed", {}, message.userLang || global.currentUserLang));
    }

    let videoUrl = response.result.video || false;
    if (!videoUrl) return await message.reply(langText("msgs", "video_not_found", {}, message.userLang || global.currentUserLang));

    let caption = `*『 TɪᴋTᴏᴋ Dᴏᴡɴʟᴏᴀᴅᴇʀ 』*\n\n` +
      `*📌 Title:* ${response.result.title || 'No title'}\n` +
      `*⏱️ Duration:* ${response.result.duration || '0'}s\n` +
      `*👤 Author:* ${response.result.author?.name || 'Unknown'}\n` +
      `*🆔 ID:* ${response.result.id || 'N/A'}\n\n` +
      `${Config.caption}`;

    let videoBuffer = await getBuffer(videoUrl);

    return await message.bot.sendMessage(
      message.chat,
      {
        video: videoBuffer,
        caption: caption,
        mimetype: 'video/mp4'
      },
      { quoted: message }
    );

  } catch (error) {
    return message.error(error + '\n\ncommand: tiktok', error, '*_Video not Found_*');
  }
});

// ==================== INSTAGRAM DOWNLOADER ====================
