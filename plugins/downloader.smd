});

// ==================== YOUTUBE SEARCH ====================
cmd({
  pattern: 'yts',
  alias: ['yt', 'ytsearch'],
  desc: 'Search on YouTube.',
  category: 'downloader',
  filename: __filename,
  use: '<Yt Search Query>'
}, async (message, query) => {
  try {
    if (!query) return await message.reply(langText("downloader", "provide_query", {}, message.userLang || global.currentUserLang));
    let searchResults = await yts(query);
    let resultMsg = '*ᴇᴍᴘɪʀᴇ-ᴍᴅ • ʏᴏᴜᴛᴜʙᴇ ᴅᴏᴡɴʟᴏᴀᴅ*\n*_______________________________*\n\n_Reply Any Number To Download._\n  _For Audio: 1 mp3._\n  _For Video: 1 video._\n  _For document: 1 document._\n\n_Results For : ' + query + '_ \n';
    let counter = 1;
    for (let video of searchResults.videos) {
      resultMsg += '\n*' + counter++ + ' : ' + video.title + (video.timestamp ? ' (' + video.timestamp + ')' : '') + '*\n*Url :* ' + video.url + '*';
    }
    return await message.bot.sendMessage(message.chat, { image: { url: searchResults.videos[0].thumbnail }, caption: resultMsg }, { quoted: message });
  } catch (error) {
    return await message.reply(langText("msgs", "no_result", {}, message.userLang || global.currentUserLang));
  }
});

// ==================== YOUTUBE DOCUMENT (KEPT ORIGINAL) ====================
smd({
  pattern: 'ytdoc',
  alias: ['ytd'],
  desc: 'Downloads YouTube audio as document.',
  category: 'downloader',
  use: '<yt video url>'
}, async (message, input) => {
  try {
    let url = input ? input : message.reply_text;
    if (!url) return await message.reply('❌ Please provide me a YouTube url');
    let videoUrl = url.split(' ')[0];
    if (!/youtu\.be|youtube\.com/.test(videoUrl)) return await message.reply(langText("downloader", "invalid_url", {}, message.userLang || global.currentUserLang));
    let response = await smdJson(api_smd + '/api/downloader/ytmp3?url=' + videoUrl);
    if (!response || !response.data || !response.data.status) return await message.reply(langText("downloader", "download_failed", {}, message.userLang || global.currentUserLang));
    let downloadUrl = response.data.data.dl_link;
    let title = response.data.data.title || 'Empire-Md Audio';
    if (!downloadUrl) return await message.reply(langText("msgs", "audio_not_found", {}, message.userLang || global.currentUserLang));
    var contextInfo = { ...(await message.bot.contextInfo(Config.botname, 'YT Doc Downloader')) };
    await message.bot.sendMessage(message.chat, { document: { url: downloadUrl }, mimetype: 'audio/mpeg', fileName: title + '.mp3', caption: Config.caption, contextInfo: contextInfo }, { quoted: message });
  } catch (error) {
    await message.error(error + '\n\ncommand: ytdoc', error, '*_Could not found anything_*');
  }
});


// ==================== INTERACTIVE MESSAGE LISTENER (UPDATED VIDEO & AUDIO) ====================
smd({
  on: 'text'
}, async (message, text, { isCreator }) => {
  if (!message.reply_message) return;
  const lines = message.reply_message.text.split('\n');

  // Song downloader listener
  if (lines[0].includes('*ᴇᴍᴘɪʀᴇ-ᴍᴅ • sᴏɴɢ ᴅᴏᴡɴʟᴏᴀᴅᴇʀ*')) {
    const urlLine = lines.find(line => line.startsWith('*Url :*'));
    if (!urlLine) return;
    let videoUrl = urlLine.replace('*Url :*', '').replace(/\*/g, '').trim();
    try {
      await message.react('✨');
      let replyText = message.text.trim();
      let isDoc = replyText.toLowerCase().includes('doc');
      if (replyText.startsWith('1')) {
        // Video download
        let downloadResponse = await fetchJson(`https://eliteprotech-apis.zone.id/ytdown?url=${videoUrl}&format=mp4`);
        if (downloadResponse && downloadResponse.success) {
          let downloadUrl = downloadResponse.downloadURL;
          if (downloadUrl) {
            if (isDoc) return await message.bot.sendMessage(message.chat, { document: { url: downloadUrl }, fileName: 'Empire-Md-video.mp4', mimetype: 'video/mp4', caption: Config.caption }, { quoted: message.reply_message });
            else return await message.bot.sendMessage(message.chat, { video: { url: downloadUrl }, caption: Config.caption, mimetype: 'video/mp4' }, { quoted: message.reply_message });
          }
        }
        return await message.reply(langText("downloader", "download_failed", {}, message.userLang || global.currentUserLang));
      }
      if (replyText.startsWith('2')) {
        // Audio download (MP3)
        let downloadResponse = await smdJson(api_smd + '/api/download/ytmp3?apikey=efe123&url=' + videoUrl);
        if (downloadResponse && downloadResponse.success) {
          let downloadUrl = downloadResponse.result;
          if (downloadUrl) {
            if (isDoc) return await message.bot.sendMessage(message.chat, { document: { url: downloadUrl }, fileName: 'Empire-Md-audio.mp3', mimetype: 'audio/mpeg' }, { quoted: message.reply_message });
            else return await message.bot.sendMessage(message.chat, { audio: { url: downloadUrl }, mimetype: 'audio/mpeg' }, { quoted: message.reply_message });
          }
        }
        return await message.reply(langText("downloader", "download_failed", {}, message.userLang || global.currentUserLang));
      }
    } catch (error) { message.error(error + '\n\nCommand song Listener', error, 'error'); }
  }

  // YT search listener (UPDATED VIDEO & AUDIO)
  else if (lines[0].includes('*ᴇᴍᴘɪʀᴇ-ᴍᴅ • ʏᴏᴜᴛᴜʙᴇ ᴅᴏᴡɴʟᴏᴀᴅ*')) {
    let replyNumber = message.text.split(' ')[0].trim();
    let targetLine = null;
    for (let line of lines) { if (line.startsWith('*' + replyNumber + ' :')) { targetLine = line; break; } }
    if (!targetLine) return;
    let lineIndex = lines.indexOf(targetLine);
    let nextLine = lines[lineIndex + 1];
    if (!nextLine || !nextLine.startsWith('*Url :*')) return;
    let videoUrl = nextLine.replace('*Url :*', '').replace(/\*/g, '').trim();
    if (!videoUrl) return;
    try {
      await message.react('✨');
      let replyText = message.text.trim();
      let isDoc = replyText.toLowerCase().includes('doc');
      let isAudio = /mp3|audio|music/.test(replyText.toLowerCase());
      let downloadUrl = null;
      let isSuccess = false;
      if (isAudio) {
        let downloadResponse = await smdJson(api_smd + '/api/download/ytmp3?apikey=efe123&url=' + videoUrl);
        if (downloadResponse && downloadResponse.success) {
          downloadUrl = downloadResponse.result;
          isSuccess = true;
        }
      } else {
        let downloadResponse = await fetchJson(`https://eliteprotech-apis.zone.id/ytdown?url=${videoUrl}&format=mp4`);
        if (downloadResponse && downloadResponse.success) {
          downloadUrl = downloadResponse.downloadURL;
          isSuccess = true;
        }
      }

      if (isSuccess && downloadUrl) {
        if (isAudio) {
          if (isDoc) return await message.bot.sendMessage(message.chat, { document: { url: downloadUrl }, fileName: 'Empire-Md-audio.mp3', mimetype: 'audio/mpeg' }, { quoted: message.reply_message });
          else return await message.bot.sendMessage(message.chat, { audio: { url: downloadUrl }, mimetype: 'audio/mpeg' }, { quoted: message.reply_message });
        } else {
          if (isDoc) return await message.bot.sendMessage(message.chat, { document: { url: downloadUrl }, fileName: 'Empire-Md-video.mp4', mimetype: 'video/mp4', caption: Config.caption }, { quoted: message.reply_message });
          else return await message.bot.sendMessage(message.chat, { video: { url: downloadUrl }, caption: Config.caption, mimetype: 'video/mp4' }, { quoted: message.reply_message });
        }
      }
      return await message.reply(langText("downloader", "download_failed", {}, message.userLang || global.currentUserLang));
    } catch (error) { message.error(error + 'Failed to process yt selection', error, 'error'); }
  }

  // APK search listener
  else if (lines[0].includes('ᴇᴍᴘɪʀᴇ-ᴍᴅ • ᴀᴘᴋ ᴅᴏᴡɴʟᴏᴀᴅ ʟɪsᴛ')) {
    let replyNumber = message.text.split(' ')[0].trim();
    let targetLine = null;
    for (let line of lines) { if (line.startsWith('*' + replyNumber + ' :')) { targetLine = line; break; } }
    if (!targetLine) return;
    let lineIndex = lines.indexOf(targetLine);
    let nextLine = lines[lineIndex + 1];
    if (!nextLine || !nextLine.startsWith('*Download :*')) return;
    let downloadUrl = nextLine.replace('*Download :*', '').replace(/\*/g, '').trim();
    try {
      await message.react('✨');
      let appName = targetLine.replace('*' + replyNumber + ' :', '').replace(/\*/g, '').trim();
      let response = await smdJson('https://empiretech-api.hf.space/api/search/aptoide?apikey=efe123&q=' + appName);
      if (response && response.success && response.result) {
        let appData = response.result;
        let caption = '*App Name :* ' + appData.name + '\n' + global.caption;
        return await message.bot.sendMessage(message.chat, { document: { url: appData.download_url }, mimetype: 'application/vnd.android.package-archive', fileName: appData.name + '.apk', caption: caption }, { quoted: message.reply_message });
      }
      return message.reply(langText("downloader", "not_found", {}, message.userLang || global.currentUserLang));
    } catch (error) { message.reply(langText("downloader", "not_found", {}, message.userLang || global.currentUserLang)); }
  }
});

// ==================== GOOGLE DRIVE DOWNLOADER ====================
smd({
  pattern: 'gdrive',
  alias: ['gd', 'googledrive', 'drive'],
  desc: 'Downloads files from Google Drive.',
  category: 'downloader',
  filename: __filename,
  use: '<google drive share link>'
}, async (message, input) => {
  try {
    let driveUrl = (input || message.reply_text || '').trim();
    if (!driveUrl) {
      return await message.reply(
        '*『 Gᴏᴏɢʟᴇ Dʀɪᴠᴇ Dᴏᴡɴʟᴏᴀᴅᴇʀ 』*\n\n' +
        '*Usage:* ' + prefix + 'gdrive <google drive link>\n' +
        '*Example:*\n' +
        '  `' + prefix + 'gdrive https://drive.google.com/file/d/FILE_ID/view`\n' +
        '  `' + prefix + 'gdrive https://drive.google.com/open?id=FILE_ID`\n\n' +
        '_Note: File must be publicly accessible (anyone with link)._'
      );
    }

    // Extract file ID from various Google Drive URL formats
    let fileId = null;
    const patterns = [
      /\/file\/d\/([a-zA-Z0-9_-]+)/,           // /file/d/FILE_ID
      /[?&]id=([a-zA-Z0-9_-]+)/,               // ?id=FILE_ID or &id=FILE_ID
      /\/folders\/([a-zA-Z0-9_-]+)/,           // /folders/FOLDER_ID
      /\/d\/([a-zA-Z0-9_-]+)/                  // /d/FILE_ID shortlink
    ];
    for (const pattern of patterns) {
      const match = driveUrl.match(pattern);
      if (match) { fileId = match[1]; break; }
    }

    if (!fileId) {
      return await message.reply(langText("downloader", "invalid_drive", {}, message.userLang || global.currentUserLang));
    }

    await message.react('⏳');

    // Try primary: direct Google Drive download URL
    let directUrl = `https://drive.google.com/uc?export=download&id=${fileId}&confirm=t`;
    let fileName = 'gdrive_file';
    let mimeType = 'application/octet-stream';
    let fileSize = 'Unknown';

    // Try to fetch metadata via API
    let metaRes = null;
    try {
      metaRes = await fetchJson(`https://empiretech-api.hf.space/api/download/gdrive?apikey=empire&id=${fileId}`);
    } catch (_) {}

    if (metaRes && metaRes.success && metaRes.result) {
      let result = metaRes.result;
      directUrl = result.download || result.url || directUrl;
      fileName = result.filename || result.name || fileName;
      mimeType = result.mimeType || result.mimetype || mimeType;
      fileSize = result.size || fileSize;
    } else {
      // Fallback: Try betabotz or similar
      try {
        let fallback = await fetchJson(`https://tools.betabotz.eu.org/tools/gdrive?id=${fileId}`);
        if (fallback && fallback.result) {
          directUrl = fallback.result.download_url || directUrl;
          fileName = fallback.result.name || fileName;
          mimeType = fallback.result.type || mimeType;
          fileSize = fallback.result.size || fileSize;
        }
      } catch (_) {}
    }

    let caption =
      '*『 Gᴏᴏɢʟᴇ Dʀɪᴠᴇ Dᴏᴡɴʟᴏᴀᴅᴇʀ 』*\n\n' +
      ' *📄 Name :* ' + fileName + '\n' +
      ' *📦 Size :* ' + fileSize + '\n' +
      ' *📋 Type :* ' + mimeType + '\n' +
      Config.caption;

    await message.bot.sendMessage(
      message.chat,
      { document: { url: directUrl }, fileName: fileName, mimetype: mimeType, caption: caption },
      { quoted: message }
    );
    await message.react('✅');

  } catch (error) {
    await message.react('❌');
    return message.error(error + '\n\ncommand: gdrive', error, '*_❌ Failed to download from Google Drive!_*');
  }
});

// ==================== TERABOX DOWNLOADER ====================
smd({
  pattern: 'terabox',
  alias: ['tb', 'tera', 'teraboxdl'],
  desc: 'Downloads files from TeraBox.',
  category: 'downloader',
  filename: __filename,
  use: '<terabox share link>'
}, async (message, input) => {
  try {
    let teraUrl = (input || message.reply_text || '').trim();
    if (!teraUrl) {
      return await message.reply(
        '*『 Tᴇʀᴀʙᴏx Dᴏᴡɴʟᴏᴀᴅᴇʀ 』*\n\n' +
        '*Usage:* ' + prefix + 'terabox <terabox link>\n' +
        '*Example:*\n' +
        '  `' + prefix + 'terabox https://terabox.com/s/1aBcDeF`\n' +
        '  `' + prefix + 'terabox https://1024terabox.com/s/1aBcDeF`\n\n' +
        '_Note: File must be set to public sharing._'
      );
    }

    if (!/terabox\.com|1024terabox\.com|teraboxapp\.com|4funbox\.com/.test(teraUrl)) {
      return await message.reply(langText("downloader", "invalid_terabox", {}, message.userLang || global.currentUserLang));
    }

    await message.react('⏳');

    // Try multiple public TeraBox resolver endpoints
    let downloadUrl = null, fileName = 'terabox_file', fileSize = 'Unknown', thumbnail = null;

    const endpoints = [
      `https://teraboxdownloader.online/api/?url=${encodeURIComponent(teraUrl)}`,
      `https://terabox.udayyy.com/api?url=${encodeURIComponent(teraUrl)}`,
      `https://tera.zeropower.xyz/api?url=${encodeURIComponent(teraUrl)}`
    ];

    for (let endpoint of endpoints) {
      try {
        let res = await fetchJson(endpoint);
        // Handle various response shapes from different APIs
        if (res) {
          if (res.download_url) { downloadUrl = res.download_url; fileName = res.file_name || fileName; fileSize = res.size || fileSize; thumbnail = res.thumbnail || null; break; }
          if (res.url) { downloadUrl = res.url; fileName = res.name || res.filename || fileName; fileSize = res.size || fileSize; break; }
          if (res.result && res.result.download) { downloadUrl = res.result.download; fileName = res.result.name || fileName; fileSize = res.result.size || fileSize; break; }
          if (res.data && res.data.download_url) { downloadUrl = res.data.download_url; fileName = res.data.file_name || fileName; break; }
          if (Array.isArray(res) && res[0] && res[0].url) { downloadUrl = res[0].url; fileName = res[0].name || fileName; break; }
        }
      } catch (_) {}
    }

    if (!downloadUrl) {
      // Final fallback: empiretech HF space
      try {
        let fallback = await fetchJson(`https://empiretech-api.hf.space/api/download/terabox?apikey=empire&url=${encodeURIComponent(teraUrl)}`);
        if (fallback && fallback.success && fallback.result) {
          downloadUrl = fallback.result.download || fallback.result.url;
          fileName = fallback.result.filename || fileName;
          fileSize = fallback.result.size || fileSize;
        }
      } catch (_) {}
    }

    if (!downloadUrl) {
      await message.react('❌');
      return await message.reply(
        '*_❌ Could not resolve TeraBox download link._*\n' +
        '_The file may be private, deleted, or the service is temporarily unavailable._'
      );
    }

    let isVideo = /\.(mp4|mkv|avi|mov|wmv|flv|webm)$/i.test(fileName);
    let mimeType = isVideo ? 'video/mp4' : 'application/octet-stream';

    let caption =
      '*『 Tᴇʀᴀʙᴏx Dᴏᴡɴʟᴏᴀᴅᴇʀ 』*\n\n' +
      ' *📄 Name :* ' + fileName + '\n' +
      ' *📦 Size :* ' + fileSize + '\n' +
      Config.caption;

    if (thumbnail) {
      await message.bot.sendMessage(message.chat, { image: { url: thumbnail }, caption: caption }, { quoted: message });
    }

    if (isVideo) {
      await message.bot.sendMessage(
        message.chat,
        { video: { url: downloadUrl }, caption: caption, mimetype: 'video/mp4', fileName: fileName },
        { quoted: message }
      );
    } else {
      await message.bot.sendMessage(
        message.chat,
        { document: { url: downloadUrl }, fileName: fileName, mimetype: mimeType, caption: caption },
        { quoted: message }
      );
    }
    await message.react('✅');

  } catch (error) {
    await message.react('❌');
    return message.error(error + '\n\ncommand: terabox', error, '*_❌ Failed to download from TeraBox!_*');
  }
});