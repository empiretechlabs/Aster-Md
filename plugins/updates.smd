// Command: Enable disappearing messages
smd({
  'cmdname': "ephemeral",
  'alias': ["disapear"],
  'desc': "enable disappearing messages from chat!",
  'category': "updates",
  'filename': __filename
}, async (message, text, { args }) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang("group"));
    }
    if (!message.isBotAdmin) {
      return message.reply(tlang("botAdmin"));
    }
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang("admin"));
    }
    
    if (!text) {
      return await message.reply(`*please provide time with type*\n*Use : ${prefix}ephemeral on 7 days*`);
    }
    
    // Turn off disappearing messages
    if (['off', "deact", "disable"].includes(text.split(" ")[0].toLowerCase())) {
      await message.bot.sendMessage(message.chat, {
        'disappearingMessagesInChat': false
      });
      return await message.reply("_Done_");
    }
    
    let timeUnit = args[2] || "day";
    let timeValue = parseInt(args[1]) || 7;
    
    // Calculate seconds based on unit
    var durationSeconds = 604800; // Default 7 days
    if (timeUnit.includes("hour")) {
      durationSeconds = 86400; // 24 hours
    } else if (timeUnit.includes('day')) {
      timeValue = timeValue > 30 ? 90 : 7; // Cap at 90 days
      durationSeconds = timeValue * 24 * 60 * 60;
    }
    
    if (['on', "act", "enable"].includes(text.split(" ")[0].toLowerCase())) {
      await message.bot.sendMessage(message.chat, {
        'disappearingMessagesInChat': durationSeconds
      });
      await message.reply(`_Now Message disappears from chat in '${timeValue} ${timeUnit}'!_`);
    } else {
      return message.reply(
        `*Please provide an option below !*\n` +
        `    *${prefix}disapear on 24 hour*\n` +
        `    *${prefix}disapear on 7/90 days*\n` +
        `  *OR*\n` +
        `    *${prefix}disapear off(disable)*`
      );
    }
  } catch (error) {
    console.log({ 'error': error });
  }
});

// Helper function: Process image with Vyro AI
async function processImage(imageBuffer, endpoint) {
  try {
    const FormData = require("form-data");
    return new Promise(async (resolve, reject) => {
      let form = new FormData();
      let apiUrl = "https://inferenceengine.vyro.ai/" + endpoint;
      
      form.append('model_version', 1, {
        'Content-Transfer-Encoding': "binary",
        'contentType': "multipart/form-data; charset=utf-8"
      });
      
      form.append("image", Buffer.from(imageBuffer), {
        'filename': endpoint + ".jpg",
        'contentType': "image/jpeg"
      });
      
      form.submit({
        'url': apiUrl,
        'host': "inferenceengine.vyro.ai",
        'path': '/' + endpoint,
        'protocol': 'https:',
        'headers': {
          'User-Agent': "okhttp/4.9.3",
          'Connection': "Keep-Alive",
          'Accept-Encoding': "gzip"
        }
      }, function(error, response) {
        if (error) reject();
        
        let chunks = [];
        response.on("data", function(chunk) {
          chunks.push(chunk);
        }).on('end', () => {
          resolve(Buffer.concat(chunks));
        }).on("error", err => {
          reject();
        });
      });
    });
  } catch (error) {
    console.log(error);
    return imageBuffer;
  }
}

// Command: Enhance image quality (Remini)
smd({
  'cmdname': "remini",
  'desc': "enhance image quality!",
  'type': "updates",
  'filename': __filename
}, async (message) => {
  let imageMessage = message.image ? message : message.reply_message;
  
  if (!imageMessage || !imageMessage.image) {
    return await message.send("*Reply to image, to enhance quality!*");
  }
  
  try {
    let imageBuffer = await imageMessage.download();
    const enhancedImage = await processImage(imageBuffer, "enhance");
    await message.send(enhancedImage, {}, 'img', message);
    imageBuffer = false;
  } catch (error) {
    message.error(error + "\n\nCommand: remini", error, "*Process Denied :(*");
  }
});

