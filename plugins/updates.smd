let { smd, smdBuffer, tlang, sleep, langText, tr } = require(global.lib_dir || "../lib");
let fs = require('fs');

// Character trait arrays for random generation
var personalityTraits = [
  "Fine", 'Unfriendly', 'Cute', "Sigma", "Chapri", 'Nibba/nibbi', 
  "Annoying", 'Dilapidated', "Angry person", "Polite", "Burden", 
  "Great", 'Cringe', 'Liar'
];

var hobbies = [
  'Cooking', "Dancing", "Playing", "Gaming", "Painting", 
  "Helping Others", "Watching anime", "Reading", "Riding Bike", 
  "Singing", "Chatting", "Sharing Memes", "Drawing", 
  "Eating Parents Money", "Playing Truth or Dare", "Staying Alone"
];

var appearanceRating = ["Yes", 'No', "Very Ugly", "Very Handsome"];

var characterTypes = [
  "Caring", "Generous", "Angry person", "Sorry", "Submissive", 
  "Fine", "Im sorry", "Kind Hearted", "Patient", "UwU", "Top", "Helpful"
];

var checkmeCache = {};

// Command: Random character profile generator
smd({
  'cmdname': "checkme",
  'alias': ['aboutme'],
  'desc': "Check random information about your character!",
  'category': 'updates',
  'filename': __filename
}, async (message, text) => {
  try {
    let targetUser = message.sender;
    
    // Allow creator to check others by reply or mention
    if (message.isCreator) {
      targetUser = message.reply_message ? 
        message.reply_message.sender : 
        message.mentionedJid[0] ? 
        message.mentionedJid[0] : 
        targetUser;
    }
    
    // Use cached result or generate new one (reset with fresh/reset/new/why/update)
    let profileText = !/fresh|reset|new|why|update/g.test(text) && checkmeCache[targetUser] ? 
      checkmeCache[targetUser] : 
      `*ABOUT @${targetUser.split('@')[0]}*\n  \n` +
      `*Name :* ${(await message.bot.getName(targetUser)).split("\n").join("  ")}\n` +
      `*Characteristic :* ${personalityTraits[Math.floor(Math.random() * personalityTraits.length)]}\n` +
      `*Hobby :* ${hobbies[Math.floor(Math.random() * hobbies.length)]}\n` +
      `*Simp :* ${Math.floor(Math.random() * 101)}%\n` +
      `*Great :* ${Math.floor(Math.random() * 101)}%\n` +
      `*Handsome :* ${appearanceRating[Math.floor(Math.random() * appearanceRating.length)]}\n` +
      `*Character :* ${characterTypes[Math.floor(Math.random() * characterTypes.length)]}\n` +
      `*Good Morals :* ${Math.floor(Math.random() * 101)}%\n` +
      `*Bad Morals :* ${Math.floor(Math.random() * 101)}%\n` +
      `*Intelligence :* ${Math.floor(Math.random() * 101)}%\n` +
      `*Courage :* ${Math.floor(Math.random() * 101)}%\n` +
      `*Afraid :* ${Math.floor(Math.random() * 101)}%\n` +
      `  \n *ALL ABOUT YOU*`;
    
    checkmeCache[targetUser] = profileText;
    
    message.bot.sendUi(
      message.from, 
      { 'caption': profileText, 'mentions': [targetUser] }, 
      { 'quoted': message }, 
      "image", 
      await message.getpp(targetUser), 
      true
    );
  } catch (error) {
    message.error(error + "\n\nCommand:aboutme", error, false);
  }
});

