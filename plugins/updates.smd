// Command: Clear temporary files
smd({
  'pattern': "cleartmp",
  'type': "updates",
  'info': "Clear temporary files cache"
}, async (message) => {
  try {
    if (fs.existsSync("./temp")) {
      fs.readdirSync("./temp").forEach(file => fs.rmSync("./temp/" + file));
    }
    await message.reply("_The *temp* folder has been cleaned_");
  } catch (error) {
    message.error(error + "\n\nCommand: cleartmp", error, false);
  }
});

// Command: Report bugs or request features
smd({
  'cmdname': "request",
  'alias': ["reportbug", "report"],
  'desc': "report bug/features of bot to its creator!",
  'category': "updates",
  'filename': __filename
}, async (message, text) => {
  try {
    if (!text) {
      return message.reply(`Example : ${prefix}request [REQUEST/BUG] yt commands are not working!`);
    }
    
    if (text.split(" ").length < 5) {
      return message.reply("_your `REQUEST/BUG` must have `5 words` !_");
    }
    
    let reportDetails = `\n\n*User* : @${message.senderNum}\n\n*Request/Bug* : ${text}`;
    let userConfirmation = `\n\n*Hii ${message.senderName.split("\n").join(" ")}, Your request has been forwarded to my Creator!*.`;
    
    // Forward to creator
    await message.sendMessage("2348078582627@s.whatsapp.net", {
      'text': "*| REQUEST/BUG |*" + reportDetails,
      'mentions': [message.sender]
    }, { 'quoted': message });
    
    // Confirm to user
    await message.reply(
      "*| REQUEST/BUG |*" + userConfirmation + reportDetails, 
      { 'mentions': [message.sender] }, 
      "empire", 
      message
    );
  } catch (error) {
    message.error(error + "\n\nCommand: request", error, false);
  }
});

// Command: Temporarily close group chat
smd({
  'cmdname': "closetime",
  'alias': ["setclose", "setmute"],
  'desc': "set temporary timer to close a group chat!",
  'category': 'updates',
  'filename': __filename
}, async (message, text, { args }) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang("group"));
    }
    if (!message.isBotAdmin) {
      return message.reply(tlang("botAdmin"));
    }
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang("admin"));
    }
    
    let timeUnit = args[1] || '';
    let timeValue = parseInt(args[0]) || '';
    
    if (!timeValue || isNaN(timeValue)) {
      return await message.reply(`*please provide time with type*\n*Use : ${prefix}setclose 2 minute*`);
    }
    
    // Calculate milliseconds based on unit
    var durationMs;
    if (timeUnit.includes("sec")) {
      durationMs = args[0] * 1000;
    } else if (timeUnit.includes("min")) {
      durationMs = args[0] * 60000;
    } else if (timeUnit.includes('hour')) {
      durationMs = args[0] * 3600000;
    } else {
      return message.reply(
        `*Please provide an option below !*\n` +
        `      *${prefix}setclose 30 second*\n` +
        `      *${prefix}setclose 10 minute*\n` +
        `      *${prefix}setclose 1 hour*`
      );
    }
    
    message.reply(`*Group close in next '${args[0]} ${args[1]}'!*`);
    
    setTimeout(() => {
      message.bot.groupSettingUpdate(message.from, 'announcement');
      message.reply(langText("group", "group_closed", {}, message.userLang || global.currentUserLang));
    }, durationMs);
  } catch (error) {
    console.log({ 'error': error });
  }
});

