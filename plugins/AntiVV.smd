/**
 * @project_name : Aster-Md
 * @author : Empire Tech Labs
 * @description : Auto download view-once messages.
 */

const { smd, bot_ } = require("../lib");

async function getBotSettings(user) {
  const botId = "bot_" + user;
  return (await bot_.findOne({ id: botId })) || (await bot_.new({ id: botId }));
}

function unwrapViewOnce(message) {
  if (!message) return null;
  if (message.msg?.viewOnce || message.viewOnce) return message;

  const wrappers = [
    message.message?.viewOnceMessage?.message,
    message.message?.viewOnceMessageV2?.message,
    message.data?.message?.viewOnceMessage?.message,
    message.data?.message?.viewOnceMessageV2?.message
  ];

  for (const inner of wrappers) {
    if (!inner) continue;
    const mtype2 = Object.keys(inner)[0];
    if (!mtype2) continue;
    return {
      ...message,
      msg: inner[mtype2],
      mtype2,
      mtype: mtype2.replace(/Message$/i, "")
    };
  }

  return message.mtype2 ? message : null;
}

smd({
  cmdname: "antiviewonce",
  alias: ["antivv"],
  desc: "Turn on/off auto view-once downloader",
  fromMe: true,
  type: "general",
  use: "<on/off>",
  filename: __filename
}, async (message, text) => {
  try {
    const settings = await getBotSettings(message.user);
    const choice = (text || "").toLowerCase().split(" ")[0].trim();

    if (["on", "enable", "act", "true"].includes(choice)) {
      if (settings.antiviewonce === "true") {
        return await message.reply("*AntiViewOnce is already enabled.*");
      }
      await bot_.updateOne({ id: "bot_" + message.user }, { antiviewonce: "true" });
      return await message.reply("*AntiViewOnce enabled.*");
    }

    if (["off", "disable", "deact", "false"].includes(choice)) {
      if (settings.antiviewonce === "false") {
        return await message.reply("*AntiViewOnce is already disabled.*");
      }
      await bot_.updateOne({ id: "bot_" + message.user }, { antiviewonce: "false" });
      return await message.reply("*AntiViewOnce disabled.*");
    }

    return await message.reply("*Use on/off to enable or disable AntiViewOnce.*");
  } catch (error) {
    await message.error(error + "\n\nCommand: AntiViewOnce", error);
  }
});

smd({ on: "viewonce" }, async (message) => {
  try {
    if (message.fromMe) return;

    const settings = await getBotSettings(message.user);
    if (!settings || settings.antiviewonce !== "true") return;

    const mediaHolder = unwrapViewOnce(message);
    if (!mediaHolder?.msg) return;

    const mediaBuffer = await message.bot.downloadMediaMessage(mediaHolder);
    const mediaType = (mediaHolder.mtype2 || "imageMessage").split("Message")[0];
    const targetJid = message.chat || message.from;

    await message.bot.sendMessage(targetJid, {
      [mediaType]: mediaBuffer,
      mimetype: mediaHolder.msg.mimetype,
      caption: message.body || ""
    }, {
      quoted: {
        key: { ...message.key },
        message: { conversation: "```[VIEWONCE DETECTED]```" }
      }
    });
  } catch (error) {
    console.log("AntiViewOnce error:", error);
  }
});
