global.pinging = class _Ping {
   constructor() { this._before = new Date().getTime(); this._after = new Date().getTime(); }
   before(){ this._before = new Date().getTime(); }
   start(){ this._before = new Date().getTime(); }
   after(){ this._after = new Date().getTime(); }
   end(){ this._after = new Date().getTime(); }
   ping() { return this._after - this._before; }
}

process.env.name = "smd"
process.env.BUTTONS = "true"
global.BUTTONS = "true"

const { 
   smd, 
   botpic,
   send,
   Config, 
   tlang, 
   sleep,
   smdBuffer,
   prefix,
   bot_,
   groupdb,
   langText,
   tr
} = require('../lib')
const axios = require('axios')
let EmpireTechInfo = "Owner";
global.Package_ = {}
let counter_name = {name: "empire-md-1.0.0"}
try { global.Package_ = require(__dirname+ '/../package.json') || counter_name } catch { global.Package_ = counter_name }

smd({  
   pattern: "ssave",
   alias: ["ssaver","#"],         
   desc: "Save whatsapp status",
   category: "whatsapp",         
   filename: __filename,
   use: "< status >",
}, async(message) => {
   try {
      const mm = message.reply_message;
      const isStatus = mm && (
         mm.status ||
         mm.chat === "status@broadcast" ||
         mm.key?.remoteJid === "status@broadcast"
      );
      if (isStatus) {
         await message.bot.copyNForward(message.user, mm, false);
         return;
      }
      return message.send("*reply to whatsapp status*");
   } catch(e) {
      await message.error(`${e}\n\ncommand : #(Status Saver)`, e, false)
   }
})

//========================= [ SMD USERS ] =========================\\

smd(
   {
      pattern: "smd",         
      desc: "total Users Currently using suhail MD",
      category: "whatsapp",
      filename: __filename,
   },
   async(message, text) => {
      try {
         let check = new global.pinging() 
         let { data } = await axios.get(`${global.api_smd || "https://api-smd.onrender.com"}/bot/getUser?id=${global.Package_.name}`)
         check.after()
         if(data && data.success) {
            let str = `*Currently "${data.total || data.length || "-INFINITY-"}" Users have installed Empire MD!*`.trim()
            let fullCaption = `${str}\n*Id:* ${global.Package_.name}_bot \n*Status:* ${data.status || "Success"}! \n*Ping*: ${check.ping()} ms \n*Requester:* ${message.senderName} \n`;
            await message.reply(fullCaption)
         } else {
            message.reply(langText("ssaver", "no_data", {}, message.userLang || global.currentUserLang))
         }
      } catch (e) {
         console.error("Error:", e);
         message.reply(langText("ssaver", "error", {}, message.userLang || global.currentUserLang))
      }
})

let checkUser = false;
smd(
   { on: "text" },
   async(message, text) => {
      try {
         if(!checkUser) {
            try {
               let { data } = await axios.get(`${global.api_smd || "https://api-smd.onrender.com"}/bot/addUser?id=HRKU_${global.Package_.name}&number=${message.user.split("@")[0]}`)
               checkUser = true
            } catch (e) { /*console.log(e)*/ }
         }
         if (message.isEmpire && !message.fromMe && !message.text.startsWith("$")) {
            const botConfig = await bot_.findOne({ id: "bot_" + message.user });
            const chatConfig = message.isGroup
              ? ((await groupdb.findOne({ id: message.chat })) || { chatbot: "false" })
              : { chatbot: "false" };
            const chatbotOn = botConfig?.chatbot === "true" || chatConfig.chatbot === "true";
            if (!chatbotOn) message.react("👑");
         }
      } catch(e) {
         console.log(e)
      }
})

global.YT_PROMOTE = "https://youtube.com/shorts/xupJQLsUpyU !" || "https://youtube.com/only_one_empire"

global.config_dir = require("path").join(__dirname, '../', './config')

global.gurl = process.env.GURL || "https://whatsapp.com/channel/0029VbBpPLa4yltGWSKWlC1L";

try {
   global.auto_send_status = process.env.AUTO_SEND_STATUS || 'true';

   const regexSend = new RegExp(`\\b(?:${["send", "share", "snd", "give", "save", "sendme", "forward", "fwd"].join('|')})\\b`, 'i');

   smd(
      { on: "quoted" },
      async(message, text, { icmd }) => {
         try {
            if (icmd) return;
            let mm = message.reply_message;
            const isStatus = mm && (
               mm.status ||
               mm.chat === "status@broadcast" ||
               mm.key?.remoteJid === "status@broadcast"
            );
            if (isStatus && regexSend.test(text.toLowerCase())) {
               if (global.auto_send_status == "true") {
                  await message.bot.copyNForward(message.fromMe ? message.user : message.from, mm, false);
               }
            }
         } catch(e) {
            console.log(e)
         }
   })

   let status = false, times = 0;
   smd(
      { on: "main" },
      async(message, text, { icmd }) => {
         try {
            if(!status) {
               try {
                  status = true
               } catch (e) { /*console.log(e)*/ }
            }

            if(message.status) return
            if((global.readmessagefrom && global.readmessagefrom.includes(message.sender)) || ["yes","true","ok","sure"].includes(global.readmessage) || (icmd && ["yes","true","ok","sure"].includes(global.readcmds))) message.bot.readMessages([message.key]) 
         } catch(e) {
            console.log(e)
         }
   })

   smd(
      { on: "text" },
      async(message, text, { icmd }) => {
         try {
            if(['unavailable', 'available', 'composing', 'recording', 'paused'].includes(global.waPresence)) message.bot.sendPresenceUpdate(global.waPresence, message.from) 
         } catch(e) {
            console.log(e)
         }
   })

   smd(
      { on: "status" },
      async(message, text) => {
         try {
            let participant = message.key.participant || message.participant || message.key.remoteJid || '';
            let participantNum = participant ? participant.split("@")[0] : '';
            if((global.read_status_from && global.read_status_from.split(",").includes(participantNum)) || ["yes","true","ok","sure"].includes(global.read_status) || message.fromMe || message.isEmpire) {
               await message.bot.readMessages([{...message.key, fromMe: false}]) 
            }
            if(((global.save_status_from && global.save_status_from.split(",").includes(participantNum)) || ["yes","true","ok","sure"].includes(global.save_status)) && !message.fromMe) {
               await message.bot.copyNForward(message.user, message, false);
            }
            if (global.auto_like_status === 'true' && !message.fromMe) {
               let reactionEmoji = global.status_reaction_emoji || 'random';
               if (reactionEmoji === 'random') {
                  const emojis = ['❤', '💕', '😻', '🧡', '💛', '💚', '💙', '💜', '🖤', '❣', '💞', '💓', '💗', '💖', '💘', '💝', '💟', '♥', '💌', '🙂', '🤗', '😌', '😉', '🤗', '😊', '🎊', '🎉', '🎁', '🎈', '👋'];
                  const mojis = ['💘','💝','💖','💗','💓','💞','💕','💟','❣️','💔','❤️','🧡','💛','💚','💙','💜','🤎','🖤','🤍','❤️','🔥','❤️','🩹','💯','♨️','💥','❤️‍🔥','❤️‍🩹','💯','🔥','💔','❤️','🧡','💛','💚','💙','💜','🖤','🤍','💖','💝','💟'];
                  const combined = [...emojis, ...mojis];
                  reactionEmoji = combined[Math.floor(Math.random() * combined.length)];
               }
               await message.bot.sendMessage('status@broadcast', {
                  react: {
                     text: reactionEmoji,
                     key: message.key
                  }
               }, {
                  statusJidList: [message.key.participant]
               });
            }
         } catch(e) {
            console.log(e)
         }
   })

} catch(e) {}

//========================= [ SETTINGS COMMANDS ] =========================\\

smd({
   pattern: "typing",
   desc: "Toggle composing/typing presence update",
   category: "settings",
   filename: __filename,
}, async (message, text) => {
   if (!message.isCreator) return await message.reply("This command is only for my owner.");
   if (!text) return await message.reply(`*_Please Provide Valid Instruction_*\n*_Use on/off to enable/disable_*`);
   let choice = text.toLowerCase().trim();
   if (choice === 'on' || choice === 'true') {
      global.waPresence = 'composing';
      return await message.reply("Typing presence has been enabled.");
   } else if (choice === 'off' || choice === 'false') {
      global.waPresence = 'null';
      return await message.reply("Typing presence has been disabled.");
   } else {
      return await message.reply(`*_Please Provide Valid Instruction_*\n*_Use on/off to enable/disable_*`);
   }
});

