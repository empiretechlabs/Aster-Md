smd({
   pattern: "likeemoji",
   alias: ["autolikeemoji"],
   desc: "Set custom status reaction emoji",
   category: "settings",
   filename: __filename,
}, async (message, text) => {
   if (!message.isCreator) return await message.reply("This command is only for my owner.");
   if (!text) return await message.reply(`*_Please Provide Valid Emoji_*\n*_Example: .likeemoji 🧡_*`);
   let emoji = text.trim();
   if (emoji.toLowerCase() === 'random') {
      global.status_reaction_emoji = 'random';
      return await message.reply("Status Reaction Emoji has been set to: random");
   }
   global.status_reaction_emoji = emoji;
   return await message.reply(`Status Reaction Emoji has been set to: ${emoji}`);
});

smd({
   pattern: "settings",
   alias: ["setting"],
   desc: "Show bot settings menu",
   category: "settings",
   filename: __filename,
}, async (message) => {
   try {
      let typing = global.waPresence === 'composing' ? '⬢' : '⬡';
      let recording = global.waPresence === 'recording' ? '⬢' : '⬡';
      let alwaysonline = global.waPresence === 'available' ? '⬢' : '⬡';
      let unavailable = global.waPresence === 'unavailable' ? '⬢' : '⬡';
      let readstatus = ["yes", "true", "ok", "sure"].includes(global.read_status) ? '⬢' : '⬡';
      let savestatus = ["yes", "true", "ok", "sure"].includes(global.save_status) ? '⬢' : '⬡';
      let sendstatus = global.auto_send_status === 'true' ? '⬢' : '⬡';
      let readmessage = ["yes", "true", "ok", "sure"].includes(global.readmessage) ? '⬢' : '⬡';
      let readcmds = ["yes", "true", "ok", "sure"].includes(global.readcmds) ? '⬢' : '⬡';
      let likestatus = global.auto_like_status === 'true' ? '⬢' : '⬡';
      let likeemoji = global.status_reaction_emoji !== 'random' ? '⬢' : '⬡';
      let reactionEmoji = global.status_reaction_emoji || 'random';

      let menuText = `┌─────┫ SETTINGS MENU ┣━━━━━━✦
│
│  ▸ 
│  ${typing} ▸ TYPING
│  ${recording} ▸ RECORDING
│  ${alwaysonline} ▸ ALWAYSONLINE
│  ${unavailable} ▸ UNAVAILABLE
│  ${readstatus} ▸ READSTATUS
│  ${savestatus} ▸ SAVESTATUS
│  ${sendstatus} ▸ SENDSTATUS
│  ${readmessage} ▸ READMESSAGE
│  ${readcmds} ▸ READCMDS
│  ${likestatus} ▸ LIKESTATUS
│  ${likeemoji} ▸ LIKEEMOJI : ${reactionEmoji}
│  ▸ 
└────────────────────────────✦`;

      await message.sendUi(message.jid, { caption: menuText });
   } catch (e) {
      await message.error(`${e}\n\ncommand : settings`, e);
   }
});
