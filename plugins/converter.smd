let mtypes = ["imageMessage", "videoMessage", "stickerMessage"];

// ==================== STICKER COMMAND ====================
smd({
  cmdname: "sticker",
  alias: ['s'],
  info: "Makes sticker of replied image/video.",
  type: "sticker",
  filename: __filename,
  use: "<reply to any image/video.>"
}, async (message) => {
  try {
    let mediaMessage = mtypes.includes(message.mtype) ? message : message.reply_message;
    
    if (mediaMessage && mtypes.includes(mediaMessage?.["mtype"] || "need_Media")) {
      let mediaBuffer = await mediaMessage.download();
      let stickerOptions = {
        pack: Config.packname,
        author: Config.author,
        type: StickerTypes.FULL,
        quality: 70
      };
      await generateSticker(message, mediaBuffer, stickerOptions);
      return mediaBuffer = false;
    } else {
      return message.reply(langText("converter", "reply_image_video", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    return await message.error(error + "\n\ncmdName: sticker\n");
  }
});

// ==================== TAKE COMMAND (Steal Sticker) ====================
smd({
  cmdname: "take",
  info: "Makes sticker of replied image/video.",
  type: "sticker",
  filename: __filename,
  use: "<reply to sticker.>"
}, async (message, input) => {
  try {
    let replyMessage = message.reply_message;
    if (!replyMessage || replyMessage?.["mtype"] != "stickerMessage") {
      return await message.reply(langText("msgs", "need_reply_sticker", {}, message.userLang || global.currentUserLang));
    }
    
    let parts = input.split('|');
    let packName = parts[0]?.trim() !== '' ? parts[0] : message.pushName;
    let authorName = parts[1] && parts[1] !== '' ? parts[1] : "ᴇᴍ🇵𝗜𝗥𝗘-𝗠𝗗 ♥️";
    
    let stickerBuffer = await replyMessage.download();
    let stickerOptions = {
      pack: packName,
      author: authorName,
      type: StickerTypes.FULL,
      quality: 10
    };
    
    await generateSticker(message, stickerBuffer, stickerOptions);
    return stickerBuffer = false;
  } catch (error) {
    return await message.error(error + "\n\ncmdName: take\n");
  }
});

