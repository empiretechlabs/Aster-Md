// Command: bio - Update profile status/bio
smd({
  'pattern': "bio",
  'desc': "update profile status of whatsapp",
  'category': "whatsapp",
  'use': "<text>",
  'fromMe': true,
  'filename': __filename
}, async (message, text) => {
  try {
    if (!text) {
      return await message.send("*_provide text to update profile status!_*\n*_Example: " + prefix + "bio Empire Md_*");
    }
    await message.bot.updateProfileStatus(text);
    message.send("*Profile status updated successfully!*");
  } catch (error) {
    await message.error(error + "\n\ncommand : bio", error);
  }
});

// Command: product - Send WhatsApp product catalog message (Baileys)
smd({
  pattern: "product",
  alias: ["shop", "productmsg"],
  desc: "send product catalog message",
  category: "whatsapp",
  use: "<reply to image>",
  fromMe: true,
  filename: __filename
}, async (message) => {
  try {
    let image = { url: global.THUMB_IMAGE };
    const mediaMessage = mtypes.includes(message.mtype) ? message : message.reply_message;

    if (mediaMessage && mtypes.includes(mediaMessage?.mtype || '')) {
      const mediaUrl = await message.bot.downloadAndSaveMediaMessage(mediaMessage);
      image = { url: mediaUrl };
    }

    await message.bot.sendMessage(message.chat, {
      image,
      body: '👋🏻 Check my product here!',
      footer: '@itsliaaa/baileys',
      product: {
        currencyCode: 'NGN',
        description: '🛍️ Interesting product!',
        priceAmount1000: 70_000_000,
        productId: randomUUID(),
        productImageCount: 1,
        salePriceAmount1000: 65_000_000,
        signedUrl: 'https://www.npmjs.com/package/@itsliaaa/baileys',
        title: '📦 Starseed (Premium)',
        url: 'https://www.npmjs.com/package/@itsliaaa/baileys'
      },
      businessOwnerJid: message.user
    }, { quoted: message });

  } catch (error) {
    await message.error(error + "\n\ncommand : product", error);
  }
});

