      await groupdb.updateOne({ id: message.chat }, { pdm: "true" });
      return await message.send("*Promote/Demote Alerts Enable Succesfully!*");
    } else if (userInput.startsWith("off") || userInput.startsWith("deact") || userInput.startsWith('disable')) {
      if (groupConfig.pdm == "false") {
        return await message.send("*Promote/Demote Alerts Already Disabled In Current Chat!*");
      }
      await groupdb.updateOne({ id: message.chat }, { pdm: "false" });
      return await message.send("*Promote/Demote Alerts Disable Succesfully!*");
    } else {
      return await message.reply(langText("group", "toggle_on_off", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    message.error(error + "\n\ncommand: pdm", error);
  }
});

// ==================== AMUTE COMMAND (Auto Mute) ====================
smd({
  pattern: "amute",
  desc: "sets auto mute time in group.",
  category: 'moderation'
}, async (message, input) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }

    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat }));

    if (!input) {
      return await message.reply(langText("group", "auto_mute_status", {
        status: groupConfig.mute === "false" ? "disabled" : "enabled",
        detail: groupConfig.mute !== "false" ? "\n*Auto-mute set at: " + groupConfig.mute + "*" : ""
      }, message.userLang || global.currentUserLang));
    }

    let [hours, minutes] = input.split(':').map(Number);
    if (isNaN(hours) || isNaN(minutes) || hours < 0 || hours >= 24 || minutes < 0 || minutes >= 60) {
      return message.reply(langText("group", "time_format", { prefix, cmd: "amute" }, message.userLang || global.currentUserLang));
    }

    let timeFormatted = hours.toString().padStart(2, '0') + ':' + minutes.toString().padStart(2, '0');
    await groupdb.updateOne({ id: message.chat }, { mute: timeFormatted });
    return message.reply(langText("group", "auto_mute_done", { time: timeFormatted }, message.userLang || global.currentUserLang));
  } catch (error) {
    message.error(error + "\n\ncommand: amute", error);
  }
});

