// ==================== ONLYADMIN COMMAND ====================
smd({
  pattern: "onlyadmin",
  alias: ['antimessge'],
  desc: "activates and deactivates onlyadmin.",
  category: "group",
  filename: __filename
}, async (message, input, { cmdName }) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }

    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat }));
    
    let userInput = input ? input.toLowerCase().trim() : false;
    let mode = userInput ? userInput.split(" ")[0] : false;

    if (!mode) {
      return await message.send('*_' + cmdName + " *" + 
        (groupConfig.onlyadmin === "false" ? "Disabled" : "Enabled") + 
        " in this Group!_*\n *_Use on/off to enable/disable_*");
    } else if (mode.startsWith('off') || mode.startsWith("deact") || mode.startsWith("disable")) {
      if (groupConfig.onlyadmin === 'false') {
        return await message.reply(langText("group", "onlyadmin_off", {}, message.userLang || global.currentUserLang));
      }
      await groupdb.updateOne({ id: message.chat }, { onlyadmin: "false" });
      await message.bot.groupSettingUpdate(message.chat, 'not_announcement');
      return await message.send('*' + cmdName + " succesfully disable in group!_*\n*_Now everyone send message in group_*");
    } else if (mode.startsWith('on') || mode.startsWith("act") || mode.startsWith("enable")) {
      if (groupConfig.onlyadmin === "true") {
        return await message.reply(langText("group", "onlyadmin_on", {}, message.userLang || global.currentUserLang));
      }
      if (message.isBotAdmin) {
        await groupdb.updateOne({ id: message.chat }, { onlyadmin: 'true' });
        await message.bot.groupSettingUpdate(message.chat, 'announcement');
        return await message.send('*' + cmdName + " succesfully set to kick msg senders!_*\n*_Now only admins allow to send msg in group_*");
      } else {
        return await message.reply(langText("msgs", "not_bot_admin", {}, message.userLang || global.currentUserLang));
      }
    } else {
      return await message.reply(langText("group", "provide_on_off", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    message.error(error + "\n\ncommand: onlyadmin", error);
  }
});

// ==================== ANTIBOT COMMAND ====================
smd({
  pattern: "antibot",
  desc: "kick Bot Users from Group.!",
  category: "group",
  filename: __filename
}, async (message, input, { cmdName }) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }

    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat }));
    
    let userInput = input ? input.toLowerCase().trim() : '';
    let mode = userInput.startsWith('on') || userInput.startsWith("act") || 
               userInput.startsWith('enable') || userInput.startsWith("del") || 
               userInput.startsWith("warn") ? 'warn' : 
               userInput.startsWith("kic") ? "kick" : 
               userInput.startsWith('off') || userInput.startsWith("reset") || 
               userInput.startsWith('deact') || userInput.startsWith("disable") ? "false" : '';

    if (!mode) {
      return await message.send("*_Antibot Currently *" + 
        (groupConfig.antibot === "false" ? 'Disabled' : "Enabled") + 
        " in this Group!_*\n*_Use warn/kick/off to enable/disable Antibot_*");
    } else if (mode === "false") {
      if (groupConfig.antibot === "false") {
        return await message.reply(langText("group", "antibot_disabled", {}, message.userLang || global.currentUserLang));
      }
      await groupdb.updateOne({ id: message.chat }, { antibot: "false" });
      return await message.send("*_Antibot Succesfully Disable in group!_*");
    } else if (mode === 'warn' || mode === "kick") {
      if (groupConfig.antibot === mode) {
        return await message.reply(langText("group", "antibot_mode", { mode }, message.userLang || global.currentUserLang));
      }
      if (!message.isBotAdmin) {
        return await message.reply(langText("msgs", "not_bot_admin", {}, message.userLang || global.currentUserLang));
      }
      await groupdb.updateOne({ id: message.chat }, { antibot: mode });
      return await message.send("*_Antibot Succesfully set to " + mode + " Bot Users!_*");
    } else {
      return await message.reply(langText("group", "antibot_instructions", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    message.error(error + "\n\ncommand: antibot", error);
  }
});

// ==================== DISABLE COMMAND ====================
smd({
  pattern: "disable",
  desc: "disable cmds in Group.!",
  category: "group",
  filename: __filename
}, async (message, input) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }

    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat }));
    
    let userInput = input ? input.toLowerCase().trim() : false;
    let commandName = userInput ? userInput.split(" ")[0] : '';

    if (!commandName) {
      return await message.send("*Provide cmd name to disable in group*\n*Ex " + prefix + "disable tag(to disabled 'tag' cmd)/info*");
    } else if (commandName.startsWith("info") || commandName.startsWith("list") || commandName.startsWith("cmds")) {
      return await message.send(groupConfig.disablecmds === "false" ? 
        "*_Uhh Dear, Theres no cmd disabled in current group_*" : 
        "*_Disable cmds :_* ```" + groupConfig.disablecmds.replace("false,", '') + '```');
    } else if (commandName.startsWith("enable") || commandName.startsWith('disable') || commandName.startsWith("bot")) {
      return await message.reply(langText("group", "cant_disable_cmd", {}, message.userLang || global.currentUserLang));
    } else if (commandName) {
      const command = empireMd.commands.find(cmd => cmd.pattern === commandName) || 
                      empireMd.commands.find(cmd => cmd.alias && cmd.alias.includes(commandName));
      
      if (command) {
        let escapedPattern = command.pattern.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        let patternRegex = new RegExp("\\b" + escapedPattern + "\\b");
        
        if (patternRegex.test(groupConfig.disablecmds)) {
          return await message.send("*Uhh Dear, Provided cmd already in disable cmds*");
        }
        
        var newDisabledCmds = groupConfig.disablecmds + ',' + command.pattern;
        await groupdb.updateOne({ id: message.chat }, { disablecmds: newDisabledCmds });
        
        let displayCmds = newDisabledCmds.replace("false,", '');
        return await message.send("*_\"" + commandName + "\" Succesfully added in disable cmds_*" + 
          (displayCmds === '' ? '' : "\n*_Disable cmds :_* ```" + displayCmds + "```"));
      } else {
        return await message.reply(langText("group", "invalid_cmd", { cmd: commandName }, message.userLang || global.currentUserLang));
      }
    }
  } catch (error) {
    message.error(error + "\n\ncommand: enable", error);
  }
});

// ==================== ENABLE COMMAND ====================
smd({
  pattern: "enable",
  desc: "enable a cmd in Group.!",
  category: 'group',
  filename: __filename
}, async (message, input) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }

    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat }));
    
    let userInput = input ? input.toLowerCase().trim() : false;
    let commandName = userInput ? userInput.split(" ")[0] : '';
    let escapedCommand = commandName.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    let commandRegex = new RegExp("\\b" + escapedCommand + "\\b");

    if (!commandName || commandName === '') {
      return await message.send("*Please provide disabled cmd name to enable it*\n*Ex " + prefix + "enable tag(if 'tag' cmd disabled)/all(reset disables)*");
    } else if (userInput.startsWith("all")) {
      await groupdb.updateOne({ id: message.chat }, { disablecmds: "false" });
      return await message.send("*_All disable cmds succesfully enabled_*");
    } else if (commandRegex.test(groupConfig.disablecmds) && groupConfig.disablecmds.includes(commandName)) {
      let updatedCmds = groupConfig.disablecmds.replace(commandRegex, '');
      await groupdb.updateOne({ id: message.chat }, { disablecmds: updatedCmds });
      return await message.send("*_\"" + commandName.replace(',', '') + "\" Succesfully removed from disable cmds_*");
    } else {
      return await message.send("_There's no cmd disabled with *" + commandName.replace(',', '') + "* name");
    }
  } catch (error) {
    message.error(error + "\n\ncommand: disable", error);
  }
});

// ==================== ANTIFAKE COMMAND ====================
smd({
  pattern: "antifake",
  desc: "Detects promote/demote and sends alert.",
  category: 'group',
  filename: __filename
}, async (message, input) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }

    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat }));
    
    let userInput = input ? input.toLowerCase().trim() : '';

    if (userInput.startsWith("off") || userInput.startsWith("deact") || userInput.startsWith('disable')) {
      if (groupConfig.antifake == "false") {
        return await message.send("*Anti_Fake Already Disabled In Current Chat!*");
      }
      await groupdb.updateOne({ id: message.chat }, { antifake: 'false' });
      return await message.send("*Anti_Fake Disable Succesfully!*");
    } else if (!input) {
      return await message.send("*_Antifake " + 
        (groupConfig.antifake === 'false' ? "Not set to any" : "set to \"" + groupConfig.antifake + "\"") + 
        " Country Code!_*\n *Provide Country code to Update Antifake Status*\n*Eg: _.antifake 92_*");
    }

    let countryCodes = input ? input.split(',').map(code => parseInt(code)).filter(code => !isNaN(code)).join(',') : false;

    if (!input || !countryCodes) {
      return await message.send("*_Please provide a country code First_*\n *_Only numbers to join this group._*\n*_eg: " + prefix + "antifake 92_*");
    } else if (countryCodes) {
      await groupdb.updateOne({ id: message.chat }, { antifake: '' + countryCodes });
      return await message.send("*Anti_Fake Succesfully set to \"" + countryCodes + "\"!*\n*_Now People Joined Group Who's Number Start With " + countryCodes + '_*');
    } else {
      return await message.send("*_Please provide a Valid country code First_*\n *_Only numbers to join this group._*\n*_eg: " + prefix + "antifake 92_*");
    }
  } catch (error) {
    message.error(error + "\n\ncommand: antifake", error);
  }
});

