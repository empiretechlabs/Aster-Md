// ==================== SHIP COMMAND (Matchmaking) ====================
smd({
  pattern: "ship",
  category: 'group',
  filename: __filename
}, async (message) => {
  if (!message.isGroup) {
    return message.reply(tlang().group);
  }
  
  let participantIds = message.metadata.participants.map(p => p.id);
  
  var targetUser = message.reply_message 
    ? message.reply_message.sender 
    : message.mentionedJid[0] 
      ? message.mentionedJid[0] 
      : false;
  
  var shipPartner;
  if (targetUser) {
    shipPartner = targetUser;
  } else {
    shipPartner = participantIds[Math.floor(Math.random() * participantIds.length)];
  }
  
  if (message.sender === shipPartner) {
    return message.reply(langText("group", "matchmaking_self", {}, message.userLang || global.currentUserLang));
  }
  
  async function getShipPercentage() {
    var percentageText;
    const percentage = Math.floor(Math.random() * 100);
    
    if (percentage < 25) {
      percentageText = "\t\t\t\t\t*RelationShip Percentage : " + percentage + "%* \n\t\tThere's still time to reconsider your choices";
    } else if (percentage < 50) {
      percentageText = "\t\t\t\t\t*RelationShip Percentage : " + percentage + "%* \n\t\t Good enough, I guess! 💫";
    } else if (percentage < 75) {
      percentageText = "\t\t\t\t\t*RelationShip Percentage : " + percentage + "%* \n\t\t\tStay together and you'll find a way ⭐️";
    } else if (percentage < 90) {
      percentageText = "\t\t\t\t\t*RelationShip Percentage : " + percentage + "%* \n\tAmazing! You two will be a good couple 💖 ";
    } else {
      percentageText = "\t\t\t\t\t*RelationShip Percentage : " + percentage + "%* \n\tYou both are fit to be together 💙";
    }
    
    return percentageText;
  }
  
  var contextInfo = {
    ...(await message.bot.contextInfo('Matchmaking', "   ˚ʚ♡ɞ˚"))
  };
  
  await message.reply(
    "\t❣️ *Matchmaking...* ❣️\n" +
    "\t*✯────────────────────✯*\n" +
    "@" + message.sender.split('@')[0] + "  x  @" + shipPartner.split('@')[0] + "\n" +
    "\t*✯────────────────────✯*\n\n" +
    (await getShipPercentage()) + "\n\n" + Config.caption,
    {
      contextInfo: contextInfo,
      mentions: [shipPartner]
    },
    "empire"
  );
});

// ==================== MUTE COMMAND ====================
smd({
  pattern: "mute",
  desc: "Provides admin role to replied/quoted user",
  category: "group",
  filename: __filename,
  use: "<quote|reply|number>"
}, async (message) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    
    if (message.metadata?.['announce']) {
      return await message.reply(langText("group", "already_muted", {}, message.userLang || global.currentUserLang));
    }
    
    if (!message.isBotAdmin) {
      return message.reply(tlang().botAdmin);
    }
    
    if (!message.isCreator && !message.isAdmin) {
      return message.reply(tlang().admin);
    }
    
    await message.bot.groupSettingUpdate(message.chat, "announcement")
      .then(result => message.reply(langText("group", "muted", {}, message.userLang || global.currentUserLang)))
      .catch(error => message.reply(langText("group", "setting_failed", {}, message.userLang || global.currentUserLang)));
  } catch (error) {
    await message.error(error + "\n\ncommand: gmute", error);
  }
});

