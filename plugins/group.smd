// ==================== LEFT COMMAND (Leave Group) ====================
smd({
  cmdname: "left",
  info: "left from a group.",
  fromMe: true,
  type: "group",
  filename: __filename
}, async (message, input) => {
  try {
    if (!message.isGroup) {
      return await message.send(tlang().group, {}, '', message);
    }
    
    let confirmation = input.toLowerCase().trim();
    
    if (confirmation.startsWith('sure') || confirmation.startsWith('ok') || confirmation.startsWith("yes")) {
      await message.bot.groupParticipantsUpdate(message.chat, [message.user], 'remove');
      message.send("*Group Left!!*", {}, '', message, message.user);
    } else {
      return await message.send("*_Use: " + prefix + "left sure/yes/ok, For security threats_*", {}, '', message);
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: left", error, false);
  }
});

// ==================== GPP COMMAND (Set Group Profile Picture) ====================
smd({
  pattern: "gpp",
  desc: "Set Group profile picture",
  category: "group",
  use: "<reply to image>",
  filename: __filename
}, async (message) => {
  try {
    if (!message.isGroup) {
      return await message.send(tlang().group, {}, '', message);
    }
    
    if (!message.isBotAdmin || !message.isAdmin) {
      return await message.reply(!message.isBotAdmin 
        ? "*_I'm Not Admin In This Group" + (!message.isCreator ? ", Idiot" : '') + '_*' 
        : tlang().admin);
    }
    
    let mediaMessage = mtypes.includes(message.mtype) ? message : message.reply_message;
    if (!mediaMessage || !mtypes.includes(mediaMessage?.["mtype"] || "need_Media")) {
      return await message.reply(langText("msgs", "need_reply_image", {}, message.userLang || global.currentUserLang));
    }
    
    return await updateProfilePicture(message, message.chat, mediaMessage, 'gpp');
  } catch (error) {
    await message.error(error + "\n\ncommand : gpp", error);
  }
});

