// ==================== ANTIWORD COMMAND ====================
smd({
  pattern: 'antiword',
  desc: "Detects words from chat,and delete/warn senders.",
  category: "group",
  filename: __filename,
  use: "< action | words >"
}, async (message, input, { cmdName }) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }

    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat, antiword: { status: "false", words: '' } }));
    
    let userInput = input ? input.toLowerCase().trim() : false;
    let antiwordConfig = groupConfig.antiword;
    
    let helpText = "*Antiword Currently *" + 
      (antiwordConfig.status !== "false" ? "enabled" : "disabled") + "!!!* ```\n  STATUS: " + 
      (antiwordConfig.status ? antiwordConfig.status : "--Empty Yet--") + " \n  WORDS: " + 
      (antiwordConfig.words ? antiwordConfig.words.replace(/,/gi, " -- ") : "--Empty Yet--") + 
      "```\n\n*Available Cmds:* ```\n  " + (prefix + cmdName) + " off \n  " + (prefix + cmdName) + " reset\n  " + 
      (prefix + cmdName) + " warn | bad,words\n  " + (prefix + cmdName) + " delete | hot,badas\n``` \n\n\n " + Config.caption;

    if (!userInput || !input) {
      return await message.send(helpText);
    }

    let wordsPart = userInput.split('|')[1] || '';
    let mode = userInput.startsWith('on') || userInput.startsWith("act") || 
               userInput.startsWith('enable') || userInput.startsWith("del") ? 'delete' : 
               userInput.startsWith("warn") ? "warn" : 
               userInput.startsWith('off') || userInput.startsWith('deact') || 
               userInput.startsWith('disable') ? "false" : 
               userInput.startsWith("reset") ? "reset" : '';
    
    mode = !mode && wordsPart && antiwordConfig.status !== "false" ? antiwordConfig.status : mode;

    if (mode === 'reset') {
      await groupdb.updateOne({ id: message.chat }, { antiword: {} });
      return await message.send("*_Anti_Word status cleard!_*");
    } else if (mode === 'delete' || mode === "warn") {
      if (antiwordConfig.status == mode && !wordsPart) {
        return await message.send("*Please provide badWords, like " + (prefix + cmdName) + " " + mode + " | bad,words");
      }
      wordsPart = wordsPart ? wordsPart : antiwordConfig.words;
      await groupdb.updateOne({ id: message.chat }, { antiword: { status: mode, words: wordsPart } });
      return await message.send("*_Anti_Word succesfully set to '" + mode + "' badward!_*\n*Antiwords are:```" + 
        (wordsPart ? wordsPart.replace(/,/gi, " | ") : "--Empty Yet--") + "``` *");
    } else if (mode === "false") {
      if (antiwordConfig.status === mode) {
        return await message.send("*Anti_Word Already Disabled In Current Chat!*");
      }
      await groupdb.updateOne({ id: message.chat }, { antiword: { status: 'false', words: antiwordConfig.words } });
      return await message.send("*Anti_Word Disable Succesfully!*");
    } else {
      return await message.reply(langText("group", "follow_instructions", { text: helpText }, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    message.error(error + "\n\ncommand: antiword", error);
  }
});

async function getMentionConfig(botJid) {
  let botData = (await bot_.findOne({ id: "bot_" + botJid })) || (await bot_.new({ id: "bot_" + botJid }));
  return botData.mention || {};
}

async function sendMentionReply(message, mentionConfig) {
  if (mentionConfig.media && mentionConfig.media.data && mentionConfig.media.type) {
    const mediaBuffer = Buffer.from(mentionConfig.media.data, "base64");
    const mediaType = mentionConfig.media.type;
    const content = {
      [mediaType]: mediaBuffer,
      mimetype: mentionConfig.media.mimetype || undefined
    };

    if (mentionConfig.text && !["audio", "sticker"].includes(mediaType)) {
      content.caption = mentionConfig.text;
    }
    if (mediaType === "audio") {
      content.ptt = !!mentionConfig.media.ptt;
    }

    return await message.bot.sendMessage(message.chat, content, { quoted: message });
  }

  const mentionText = (mentionConfig.text || "I am offline right now.")
    .replace(/@user/gi, "@" + message.senderNum)
    .replace(/@name/gi, message.senderName || message.senderNum);

  return await message.bot.sendMessage(message.chat, {
    text: mentionText,
    mentions: [message.sender]
  }, { quoted: message });
}

// ==================== MENTION COMMAND ====================
smd({
  pattern: "setmention",
  alias: ["mention", "metion"],
  desc: "set auto reply when the bot is tagged",
  category: "group",
  use: "<text|off> or reply media",
  fromMe: true,
  filename: __filename
}, async (message, input, { botNumber }) => {
  try {
    const botJid = botNumber || message.user;
    const action = (input || "").trim();
    const lowerAction = action.toLowerCase();

    if (["off", "false", "disable", "delete", "remove", "clear"].includes(lowerAction)) {
      await bot_.updateOne({ id: "bot_" + botJid }, { mention: { status: false } });
      return await message.reply(langText("group", "mention_reply_disabled", {}, message.userLang || global.currentUserLang));
    }

    let mentionData = {
      status: true,
      text: action,
      get: action || "media",
      updatedAt: new Date().toISOString()
    };

    if (message.quoted && /^(image|video|audio|sticker)Message$/i.test(message.quoted.mtype || "")) {
      const mediaBuffer = await message.quoted.download();
      const mediaType = (message.quoted.mtype || "").replace(/Message$/i, "").toLowerCase();
      mentionData.media = {
        type: mediaType,
        data: mediaBuffer.toString("base64"),
        mimetype: message.quoted.mimetype || "",
        ptt: !!message.quoted.msg?.ptt
      };
      mentionData.text = action || message.quoted.text || "";
      mentionData.get = mentionData.text || mediaType;
    }

    if (!mentionData.text && !mentionData.media) {
      return await message.reply(
        "*Use:* `" + prefix + "mention am offline`\n" +
        "*Media:* reply image/video/audio/sticker with `" + prefix + "mention`\n" +
        "*Off:* `" + prefix + "setmention off`"
      );
    }

    await bot_.updateOne({ id: "bot_" + botJid }, { mention: mentionData });
    return await message.reply(langText("group", "mention_reply_saved", {}, message.userLang || global.currentUserLang));
  } catch (error) {
    await message.error(error + "\n\ncommand: setmention", error, "*Could not save mention auto-reply.*");
  }
});

// ==================== MAIN EVENT HANDLER ====================
smd({
  on: "main"
}, async (message, input, { botNumber, isCreator, budy, body, icmd }) => {
  try {
    if (Config.MsgsInLog === 'true') {
      console.log('' + (message.isGroup ? 
        "[MESSAGE IN GROUP] From => " + message.metadata.subject + "\n[USER]:" : 
        "[MESSAGE IN PRIVATE] From =>") + 
        (" " + message.senderName + " " + message.senderNum + "\n[" + 
        message.mtype.toUpperCase() + "]: " + message.body + 
        "\n============== [SMD] ================="));
    }

    let groupConfig = (await groupdb.findOne({ id: message.chat })) || false;
    let warnStatus = false;

    try {
      const botJid = botNumber || message.user;
      const taggedBot = message.isGroup && !message.fromMe && !icmd && message.mtype !== "reactionMessage" && (
        (message.mentionedJid || []).includes(message.user) ||
        (message.body || "").includes("@" + (message.user || "").split("@")[0])
      );

      if (taggedBot) {
        const mentionConfig = await getMentionConfig(botJid);
        if (mentionConfig && (mentionConfig.status === true || mentionConfig.status === "true")) {
          await sendMentionReply(message, mentionConfig);
        }
      }
    } catch (error) {
      console.log("Error From Mention Reply : ", error);
    }

    try {
      if (!global.SmdOfficial && global.SmdOfficial !== "yes") {
        return;
      }

      if (groupConfig && groupConfig.antitag == "true" && !message.checkBot() && 
          message.mtype !== 'reactionMessage' && groupConfig.botenable == "true") {
        
        const isTagAll = await haveEqualMembers(
          message.metadata.participants.map(p => p.id), 
          message.mentionedJid
        );

        if (isTagAll && message.isBotAdmin) {
          let warnData = {
            reason: "tagging all members!",
            chat: message.metadata?.["subject"] || "GROUP",
            warnedby: tlang().title,
            date: message.date
          };
          warnStatus = await warn.addwarn(message.sender, message.chat, warnData);
          await message.reply(langText("group", "tag_detected", { user: message.senderNum }, message.userLang || global.currentUserLang),
            { mentions: [message.sender] });
          await message.delete();
        } else if (isTagAll && !message.isBotAdmin) {
          await message.reply(langText("group", "tagall_no_admin", {}, message.userLang || global.currentUserLang),
            { mentions: [message.sender] });
        }
      }

      if (groupConfig && message.isGroup && !message.isAdmin && !isCreator && 
          message.mtype !== "reactionMessage" && groupConfig.botenable == "true") {
        
        if (groupConfig.antibot && groupConfig.antibot !== "false" && message.isBot && !message.checkBot(message.sender)) {
          if (message.isBotAdmin) {
            var actionMessage = "*_Bot user not allowed, please make it private!_*";
            if (groupConfig.antibot === "warn") {
              let warnData = {
                reason: "Bots not allowed!",
                chat: message.metadata?.["subject"] || "GROUP",
                date: message.date
              };
              warnStatus = warnStatus ? warnStatus : await warn.addwarn(message.sender, message.chat, warnData);
              if (warnStatus.status) {
                actionMessage = "*_Hey @" + message.senderNum + " warning, Due To Antibot!_*";
              }
            } else if (groupConfig.antibot === "kick") {
              try {
                sleep(1000);
                await message.bot.groupParticipantsUpdate(message.chat, [message.sender], "remove");
                actionMessage = "*_User @" + message.senderNum + " kick Due To Antibot!_*";
              } catch {}
            }
            await message.delete();
            await message.send(actionMessage, { mentions: [message.sender] });
          } else if (!message.isBotAdmin && message.isBot) {
            await message.reply(langText("group", "antibot_admin_needed", {}, message.userLang || global.currentUserLang));
          }
        }

        if (groupConfig.onlyadmin && groupConfig.onlyadmin === "true" && SmdOfficial == "yes") {
          var actionMessage = '';
          if (message.isBotAdmin) {
            let warnData = {
              reason: "Only Admin can Chat!",
              chat: message.metadata?.["subject"] || "PRIVATE",
              warnedby: tlang().title,
              date: message.date
            };
            warnStatus = warnStatus ? warnStatus : await warn.addwarn(message.sender, message.chat, warnData);
            if (warnStatus.status) {
              actionMessage = "*Warns you for chat here!*\n";
            }
            await message.delete();
            sleep(1500);
            await message.send("*Hey @" + message.senderNum + "* " + actionMessage + 
              "*Deleteing message,while onlyadmin activated!!* ", { mentions: [message.sender] });
          } else {
            await message.send("*_Provide admin role to kick Message Senders_*\n*Or _Disable onlyadmin(on/off) in currentchat_*");
          }
        }

        if (groupConfig.antilink && groupConfig.antilink !== "false" && SmdOfficial === "yes") {
          const linkPatterns = Config.antilink_values && Config.antilink_values !== "all" ? 
            Config.antilink_values.split(',').filter(val => val.trim() !== '') : 
            ["https://", "chat.whatsapp.com", 'fb.com'];
          
          let messageText = body.toLowerCase();
          if (linkPatterns.some(pattern => messageText.includes(pattern))) {
            if (!message.isBotAdmin) {
              let alertMsg = " *[LINK DETECTED]*\nUser @" + message.sender.split('@')[0] + 
                " detected sending a link.\nPromote " + Config.botname + " as admin to " + 
                (groupConfig.antilink === "kick" ? "kick \nlink senders." : "delete \nlinks from this Chat") + " \n";
              await message.send(alertMsg, { mentions: [message.sender] });
            } else {
              if (groupConfig.antilink === "delete") {
                await message.send("*_Link Detected.. Deletion Done!_*");
                await message.delete();
              } else if (groupConfig.antilink === 'warn' || groupConfig.antilink === "true") {
                let warnData = {
                  reason: "links not allowed!",
                  chat: message.metadata?.["subject"] || "PRIVATE",
                  warnedby: tlang().title,
                  date: message.date
                };
                warnStatus = warnStatus ? warnStatus : await warn.addwarn(message.sender, message.chat, warnData);
                var actionMessage = warnStatus.status ? 
                  "*_[LINK DETECTED] Hey @" + message.senderNum + " warning!!_*\n*_links not allowed in current group!_*" : 
                  "*_[LINK DETECTED]!_*";
                await message.reply(actionMessage, { mentions: [message.sender] });
                await message.delete();
              } else if (groupConfig.antilink === "kick") {
                await message.send("*_Link Detected!!_*");
                try {
                  await message.delete();
                  await sleep(1500);
                  await message.bot.groupParticipantsUpdate(message.chat, [message.sender], 'remove');
                } catch {
                  await message.send("*Link Detected*\n" + tlang().botAdmin);
                }
              }
            }
          }
        }
      }
    } catch (error) {
      console.log("Error From Antilinks : ", error);
    }

    var antiwordConfig = groupConfig?.["antiword"] || { status: 'false' };
    if (input.length > 1 && !message.isBot && antiwordConfig && antiwordConfig.status !== "false" && antiwordConfig.words) {
      var badWords = antiwordConfig.words.split(',') || [];
      let wordDetected = false;
      
      badWords.map(async (word) => {
        if (message.isAdmin || !global.SmdOfficial || global.SmdOfficial != "yes") {
          return;
        }
        let wordRegex = new RegExp("\\b" + word?.trim() + "\\b", 'ig');
        let messageContent = budy.toLowerCase();
        
        if (!wordDetected && word && wordRegex.test(messageContent)) {
          wordDetected = true;
          await sleep(500);
          try {
            var warnMsg = '';
            if (antiwordConfig.status === "warn") {
              let warnData = {
                reason: "For using Bad Word",
                chat: message.metadata?.['subject'] || 'PRIVATE',
                warnedby: tlang().title,
                date: message.date
              };
              warnStatus = warnStatus ? warnStatus : await warn.addwarn(message.sender, message.chat, warnData);
              if (warnStatus.status) {
                warnMsg = "\n*Warns you for using badWord!!*\n";
              }
            }
            if (message.isBotAdmin) {
              await message.send("*[BAD WORD DETECTED] Hey @" + message.senderNum + "* " + warnMsg + 
                "*Deleting your message from chat!*\n", { mentions: [message.sender] }, "empire", message);
              await message.delete();
            } else {
              await message.reply(langText("group", "badword_admin", {}, message.userLang || global.currentUserLang), { mentions: [message.sender] });
            }
          } catch (error) {
            console.log("Error From Bad Words : ", error);
          }
        }
      });
    }

    if (warnStatus) {
      let warnLimit = parseInt(Config.warncount) || 3;
      if (warnStatus.warning >= warnLimit) {
        if (message.isGroup) {
          if (message.isBotAdmin) {
            await message.send("*_Hey @" + message.senderNum + " Kicking you from group!_*\n*_Because Your warn limit exceed!_*", 
              { mentions: [message.sender] });
            await message.bot.groupParticipantsUpdate(message.chat, [message.sender], "remove");
          }
        } else {
          await message.send("*_Hey @" + message.senderNum + " Blocking you!_*\n*_Because Your warn limit exceed!_*", 
            { mentions: [message.sender] });
          await message.bot.updateBlockStatus(message.sender, 'block');
        }
      }
    }

      try {
      if (global.SmdOfficial === "yes" && message.mtype !== "reactionMessage") {
        await handleChatbot(message, { icmd, budy, groupConfig });
      }
    } catch (error) {
      console.log("Error From ChatBot : ", error);
    }
  } catch (error) {
    console.log("Group Settings error in command.main() \n", error);
  }
});

// ==================== GROUP EVENT HANDLERS ====================

// User Added to Group
smd({
  group: "add"
}, async (message, { Void }) => {
  try {
    let groupConfig = await groupdb.findOne({ id: message.chat });
    if (!groupConfig || !message.isGroup || groupConfig.botenable !== "true" || message.blockJid || message.fromMe) {
      return;
    }

    let welcomeEnabled = groupConfig && groupConfig.welcome ? groupConfig.welcome : "false";
    let antifakeCodes = groupConfig && groupConfig.antifake ? groupConfig.antifake.toLowerCase() : "false";
    let allowedCodes = antifakeCodes.split(',');
    const isAllowed = allowedCodes.some(code => message.user.startsWith(code));

    if (antifakeCodes !== "false" && !isAllowed && !message.isCreator) {
      if (message.isBotAdmin) {
        try {
          await message.kick();
          return await sendWelcome(message, "*[ANTIFAKE START] @User kicked automaticaly!* @pp");
        } catch (error) {
          await message.error(" Can't kick user in antifake\n❲❒❳ GROUP: " + message.metadata.subject + 
            "\n❲❒❳ ERROR: " + error + "\n", error, false);
        }
      } else {
        await message.send("*[ANTI_FAKE ERROR] Need admin role to kick fake users!!*");
      }
    } else if (welcomeEnabled === "true") {
      await sendWelcome(message, groupConfig.welcometext);
    }
  } catch (error) {
    console.log("Error From Welcome : ", error);
  }
});

// User Removed from Group
smd({
  group: 'remove'
}, async (message, { Void }) => {
  try {
    let groupConfig = (await groupdb.findOne({ id: message.chat })) || false;
    if (!message || !groupConfig || !message.isGroup || groupConfig.botenable !== 'true' || message.blockJid || message.fromMe) {
      return;
    }
    let goodbyeEnabled = groupConfig && groupConfig.goodbye ? groupConfig.goodbye : 'false';
    if (goodbyeEnabled === "true") {
      await sendWelcome(message, groupConfig.goodbyetext);
    }
  } catch (error) {
    console.log("Error From Goodbye : ", error);
  }
});

// User Promoted
smd({
  group: 'promote'
}, async (message, { Void }) => {
  try {
    let groupConfig = (await groupdb.findOne({ id: message.chat })) || false;
    if (!groupConfig || !message.isGroup || groupConfig.botenable !== "true" || message.blockJid) {
      return;
    }

    if (!user_warns[message.sender]) {
      user_warns[message.sender] = { [message.action]: 1 };
    } else {
      user_warns[message.sender][message.action]++;
    }

    let cantDemote;
    if (groupConfig.antipromote == "true" && !message.isCreator) {
      cantDemote = !message.isBotAdmin;
      if (users[message.sender] && users[message.sender].previous_Action === "antidemote") {
        delete users[message.sender];
        return;
      }
      if (message.isBotAdmin) {
        try {
          await message.demote();
          users[message.sender] = { previous_Action: 'antipromote' };
          if (user_warns[message.sender][message.action] > 2) {
            return;
          }
          return await sendWelcome(message, "*[ANTIPROMOTE START] @User Demoted Automatically!* @pp ");
        } catch (error) {
          await message.error(" Can't demote user in antipromote\n❲❒❳ GROUP: " + message.metadata.subject + 
            "\n❲❒❳ ERROR: " + error + "\n", error, false);
        }
      }
    }

    if (groupConfig.pdm == 'true' || cantDemote) {
      if (user_warns[message.sender][message.action] > 2) {
        return;
      }
      var promoteAlert = " *[SOMEONE PROMOTE HERE]*\n" + 
        (cantDemote ? "*Note : _I'm Not Admin Here, So I Can't Demote Someone while Anti_Promote Activated_*" : '') + 
        "\n           \n  ❲❒❳ *User:* _@user_\n❲❒❳ *Position:* _Member -> Admin_ @pp\n  ❲❒❳ *Total Members:* _@count_Members_\n❲❒❳ *Group Name:* @gname\n\n\n" + Config.caption;
      return await sendWelcome(message, promoteAlert);
    }
  } catch (error) {
    console.log("Error From Promote : ", error);
  }
});

// User Demoted
smd({
  group: "demote"
}, async (message, { Void }) => {
  try {
    let groupConfig = (await groupdb.findOne({ id: message.chat })) || false;
    if (!groupConfig || !message.isGroup || groupConfig.botenable !== 'true' || message.blockJid) {
      return;
    }

    if (!user_warns[message.sender]) {
      user_warns[message.sender] = { [message.action]: 1 };
    } else {
      user_warns[message.sender][message.action]++;
    }

    let cantPromote;
    if (groupConfig.antidemote == "true" && !message.isCreator) {
      cantPromote = !message.isBotAdmin;
      if (users[message.sender] && users[message.sender].previous_Action === 'antipromote') {
        delete users[message.sender];
        return;
      }
      if (message.isBotAdmin) {
        try {
          await message.promote();
          users[message.sender] = { previous_Action: "antidemote" };
          if (user_warns[message.sender][message.action] > 2) {
            return;
          }
          return await sendWelcome(message, "*[ANTIPROMOTE START] User promote automatically!* @pp ");
        } catch (error) {
          await message.error(" Can't promote user in antidemote\n❲❒❳ GROUP: " + message.metadata.subject + 
            "\n❲❒❳ ERROR: " + error + "\n", error, false);
        }
      }
    }

    if (groupConfig.pdm == "true" || cantPromote) {
      if (user_warns[message.sender][message.action] > 2) {
        return;
      }
      var demoteAlert = " *[SOMEONE DEMOTE HERE]*\n  " + 
        (cantPromote ? "*Note : _I'm Not Admin Here, So I Can't promote Someone while Anti_Demote Activated_*" : '') + 
        "\n\n  ❲❒❳ *User:* _@user_\n❲❒❳ *Position:* _Admin -> Member_ @pp\n  ❲❒❳ *Total Members:* _@count_Members_\n❲❒❳ *Group Name:* @gname\n  \n\n" + Config.caption;
      return await sendWelcome(message, demoteAlert);
    }
  } catch (error) {
    console.log("Error From Demote : ", error);
  }
});

// ==================== BAN COMMAND ====================
smd({
  'pattern': "ban",
  'category': 'owner',
  'filename': __filename,
  'desc': "Bans user from using bot."
}, async (message, reason) => {
  if (!isMainDev(message)) return message.reply(langText("group", "dev_only", {}, message.userLang || global.currentUserLang));

  try {
    let { jid: targetUser } = pickTargetUser(message, reason);

    if (!targetUser) return await message.send("*_Uhh please, reply/mention/tag a user or type their number!!_*");

    let userName = await message.bot.getName(targetUser);
    let user = await userdb.findOne({ id: targetUser });

    if (!user) {
      await new userdb({ id: targetUser, ban: "true" }).save();
      return await message.send(`_Banned ${userName} from Using Commands._`);
    } 
    
    if (user.ban == "true") {
      return await message.send(`_${userName} is already Banned from Using Commands!_`);
    }
    
    await userdb.updateOne({ id: targetUser }, { ban: "true" });
    return await message.send(`_Successfully Banned ${userName} from Using Commands._`);
  } catch (error) {
    console.log(error);
    return await message.send("*_Please reply or mention a user!_*");
  }
});

// ==================== UNBAN COMMAND ====================
smd({
  'pattern': "unban",
  'category': 'owner',
  'filename': __filename,
  'desc': "Unbans banned user (from using bot)."
}, async (message, reason) => {
  if (!isMainDev(message)) return message.reply(langText("group", "dev_only", {}, message.userLang || global.currentUserLang));

  try {
    let { jid: targetUser } = pickTargetUser(message, reason);

    if (!targetUser) return await message.send("*_Uhh please, reply/mention/tag a user or type their number!!_*");

    let userName = await message.bot.getName(targetUser);
    let user = await userdb.findOne({ id: targetUser });

    if (!user) {
      return await message.send(`_${userName} is not banned!_`);
    } 
    
    if (user.ban !== "true") {
      return await message.send(`_${userName} is already unbanned!_`);
    }
    
    await userdb.updateOne({ id: targetUser }, { ban: "false" });
    return await message.send(`_${userName} is free now!_`);
  } catch (error) {
    console.log(error);
    return await message.send("*_Please reply or mention a user!_*");
  }
});
