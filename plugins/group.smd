// ==================== JOIN COMMAND ====================
smd({
  cmdname: "join",
  info: "joins group by link",
  type: 'whatsapp',
  fromMe: true,
  filename: __filename,
  use: "<group link.>"
}, async (message, input) => {
  try {
    // Check if replying to a group invite message
    if (message.reply_message && message.reply_message.groupInvite) {
      var joinResult = await message.bot.groupAcceptInviteV4(message.chat, message.reply_message.msg);
      if (joinResult && joinResult.includes("joined to:")) {
        return await send(message, "*_Joined_*", {}, '', message);
      }
    }
    
    let linkText = input ? input : message.reply_text;
    const matchedLink = linkText.match(grouppattern);
    
    if (!matchedLink) {
      return await message.reply(langText("group", "provide_link", {}, message.userLang || global.currentUserLang));
    }
    
    let inviteCode = matchedLink[0].split("https://chat.whatsapp.com/")[1].trim();
    
    await message.bot.groupAcceptInvite(inviteCode)
      .then(result => send(message, "*_Joined_*", {}, '', message))
      .catch(error => message.send("*_Can't Join, Group Id not found!!_*"));
      
  } catch (error) {
    await message.error(error + "\n\ncommand: join", error, "*_Can't Join, Group Id not found, Sorry!!_*");
  }
});

// ==================== NEWGC COMMAND (Create New Group) ====================
smd({
  cmdname: 'newgc',
  info: "Create New Group",
  type: 'whatsapp',
  filename: __filename,
  use: "<group link.>"
}, async (message, input, { smd: commandName, cmdName }) => {
  try {
    if (!message.isCreator) {
      return message.reply(tlang().owner);
    }
    
    if (!input) {
      return await message.reply(langText("group", "provide_group_name", { prefix, cmd: prefix + commandName }, message.userLang || global.currentUserLang));
    }
    
    let groupName = input;
    
    if (groupName.toLowerCase() === 'info') {
      return await message.send((
        "\n  *Its a command to create new Gc*\n" +
        "  \t```Ex: " + (prefix + cmd) + " My new Group```\n" +
        "  \n*You also add peoples in newGc*\n" +
        "  \t```just reply or mention Users```\n"
      ).trim());
    }
    
    let participants = [message.sender];
    
    if (message.quoted) {
      participants.push(message.quoted.sender);
    }
    
    if (message.mentionedJid && message.mentionedJid[0]) {
      participants.push(...message.mentionedJid);
      try {
        message.mentionedJid.forEach(mentionJid => {
          var phoneNumber = mentionJid.split('@')[0].trim();
          groupName = groupName.replace(new RegExp('@' + phoneNumber, 'g'), '');
        });
      } catch {}
    }
    
    const truncatedName = groupName.substring(0, 60);
    const newGroup = await message.bot.groupCreate(truncatedName, [...participants]);
    
    if (newGroup) {
      let welcomeMessage = await message.bot.sendMessage(newGroup.id, {
        text: "*_Hey Buddy, Welcome to new Group_*\n" + Config.caption
      });
      
      try {
        var inviteCode = await message.bot.groupInviteCode(newGroup.id);
      } catch {
        var inviteCode = false;
      }
      
      var inviteLink = "https://chat.whatsapp.com/" + inviteCode;
      
      var contextInfo = {
        externalAdReply: {
          title: "<b>𝗘𝗠𝗣𝗜𝗥𝗘-𝗠𝗗</b>",
          body: '' + truncatedName,
          renderLargerThumbnail: true,
          thumbnail: log0,
          mediaType: 1,
          mediaUrl: inviteLink,
          sourceUrl: inviteLink
        }
      };
      
      return await send(message, (
        "*_Hurray, New group created!!!_*\n" +
        (inviteCode ? '*_' + inviteLink + '_*' : '')
      ).trim(), { contextInfo: contextInfo }, '', welcomeMessage);
    } else {
      await message.send("*_Can't create new group, Sorry!!_*");
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: " + cmdName, error, "*_Can't create new group, Sorry!!_*");
  }
});

// ==================== GINFO COMMAND (Get Group Info by Link) ====================
smd({
  pattern: 'ginfo',
  desc: "get group info by link",
  type: "group",
  filename: __filename,
  use: "<group link.>"
}, async (message, input) => {
  try {
    let linkText = input ? input : message.reply_text;
    const matchedLink = linkText.match(grouppattern) || false;
    
    if (!matchedLink) {
      return await message.reply(langText("group", "provide_link", {}, message.userLang || global.currentUserLang));
    }
    
    let inviteCode = matchedLink[0].split('https://chat.whatsapp.com/')[1].trim();
    const groupInfo = await message.bot.groupGetInviteInfo(inviteCode);
    
    if (groupInfo) {
      const creationDate = new Date(groupInfo.creation * 1000);
      var year = creationDate.getFullYear();
      var month = creationDate.getMonth() + 1;
      var day = creationDate.getDate();
      var formattedDate = year + '-' + month.toString().padStart(2, '0') + '-' + day.toString().padStart(2, '0');
      
      var contextInfo = {
        externalAdReply: {
          title: "𝗘𝗠𝗣𝗜𝗥𝗘-𝗠𝗗",
          body: groupInfo.subject,
          renderLargerThumbnail: true,
          thumbnail: log0,
          mediaType: 1,
          mediaUrl: matchedLink[0],
          sourceUrl: matchedLink[0]
        }
      };
      
      return await send(message, (
        groupInfo.subject + "\n  \n" +
        "  Creator: wa.me/" + groupInfo.owner.split('@')[0] + " \n" +
        "  GJid; ```" + groupInfo.id + "  ```\n" +
        "  *Muted:* " + (groupInfo.announce ? " yes" : " no") + "\n" +
        "  *Locked:* " + (groupInfo.restrict ? " yes" : " no") + "\n" +
        "  *createdAt:* " + formattedDate + "\n" +
        "  *participents:* " + (groupInfo.size > 3 ? groupInfo.size + 'th' : groupInfo.size) + "\n" +
        "  " + (groupInfo.desc ? "*description:* " + groupInfo.desc + "\n" : '') + "\n" +
        "  " + Config.caption + "\n  "
      ).trim(), {
        mentions: [groupInfo.owner],
        contextInfo: contextInfo
      }, '', message);
    } else {
      await message.send("*_Group Id not found, Sorry!!_*");
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: ginfo", error, "*_Group Id not found, Sorry!!_*");
  }
});

// ==================== REJECTALL COMMAND ====================
smd({
  cmdname: "rejectall",
  alias: ["rejectjoin"],
  info: "reject all request to join!",
  type: "group",
  filename: __filename
}, async (message, input) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    
    if (!message.isBotAdmin || !message.isAdmin) {
      return await message.reply(!message.isBotAdmin 
        ? "*_I'm Not Admin In This Group" + (!message.isCreator ? ", Idiot" : '') + '_*' 
        : tlang().admin);
    }
    
    const requestList = await message.bot.groupRequestParticipantsList(message.chat);
    
    if (!requestList || !requestList[0]) {
      return await message.reply(langText("group", "no_join_request", {}, message.userLang || global.currentUserLang));
    }
    
    let rejectedUsers = [];
    let outputText = "*List of rejected users*\n\n";
    
    for (let i = 0; i < requestList.length; i++) {
      try {
        await message.bot.groupRequestParticipantsUpdate(message.from, [requestList[i].jid], "reject");
        outputText += '@' + requestList[i].jid.split('@')[0] + "\n";
        rejectedUsers = [...rejectedUsers, requestList[i].jid];
      } catch {}
    }
    
    await message.send(outputText, { mentions: [rejectedUsers] });
  } catch (error) {
    await message.error(error + "\n\ncommand: rejectall", error);
  }
});

