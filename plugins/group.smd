// ==================== ANTILINK COMMAND ====================
smd({
  pattern: 'antilink',
  desc: "activates and deactivates antilink.",
  category: "group",
  filename: __filename
}, async (message, input, { smd: commandName }) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }

    let userInput = input ? input.toLowerCase().trim() : false;
    let mode = userInput ? userInput.split(" ")[0] : false;
    
    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat }));

    if (!mode) {
      return await message.send(
        "*_Antilink " + (groupConfig.antilink === "false" ? "Disabled" : "Enabled") + " in this Group!_* \n" +
        (groupConfig.antilink === 'false' ? '' : "*Current Mode:* _" + groupConfig.antilink + '_') +
        "\n\n*Antilink Modes:* ```\n" +
        (prefix + commandName) + " kick (Delete Links & Kick Senders)\n" +
        (prefix + commandName) + " delete (Delete Links Only)\n" +
        (prefix + commandName) + " warn (warn & delete links)\n" +
        (prefix + commandName) + " off (Disable Antilink in chat) ```\n\n\n" + Config.caption
      );
    } else if (mode.startsWith("off") || mode.startsWith('deact') || mode.startsWith("disable")) {
      if (groupConfig.antilink === "false") {
        return await message.send("*_Anti_Link already disabled in current Chat!!_*");
      }
      await groupdb.updateOne({ id: message.chat }, { antilink: "false" });
      return await message.send("*_Anti_Link Disabled Succesfully!_*");
    } else if (mode.startsWith("kick")) {
      if (groupConfig.antilink === "kick") {
        return await message.send("*_Anti_Link already set to kick link senders!!_*");
      }
      await groupdb.updateOne({ id: message.chat }, { antilink: "kick" });
      return await message.send("*_Anti_Link Succesfully set to kick link senders!_*");
    } else if (mode.startsWith("delete")) {
      if (groupConfig.antilink === "delete") {
        return await message.send("*_Anti_Link already set to delete links!!_*");
      }
      await groupdb.updateOne({ id: message.chat }, { antilink: "delete" });
      return await message.send("*_Anti_Link Succesfully set to delete links from chat!_*");
    } else if (mode.startsWith("warn")) {
      if (groupConfig.antilink === "warn") {
        return await message.send("*_Anti_Link already set to warn link senders!!_*");
      }
      await groupdb.updateOne({ id: message.chat }, { antilink: 'warn' });
      return await message.send("*_Anti_Link set to warn and delete links!_*");
    } else {
      return await message.send("*_Uhh Please, Provide Valid Instruction_*\n*Eg: _" + prefix + "antilink kick/delete/warn/off_*");
    }
  } catch (error) {
    message.error(error + "\n\ncommand: antilink", error);
  }
});

// ==================== WELCOME COMMAND ====================
smd({
  pattern: 'welcome',
  alias: ["setwelcome"],
  desc: "sets welcome message in specific group.",
  category: 'group',
  filename: __filename
}, async (message, input) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }

    let mode = input.toLowerCase().trim();
    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat }));

    if (mode === 'on' || mode === "act" || mode === "enable") {
      if (groupConfig.welcome === 'true') {
        return await message.send("*_Welcome already enabled in current group!!_*");
      }
      await groupdb.updateOne({ id: message.chat }, { welcome: "true" });
      await message.send("*Welcome successfully enabled!!*");
    }

    if (groupConfig.welcome !== 'true') {
      return await message.send("*_Welcome *Disabled in this Group!_* \n*_Use on/off to enable/disable welcome_*");
    }

    if (!input || mode === "get") {
      return await message.reply(langText("group", "welcome_msg", { text: groupConfig.welcometext }, message.userLang || global.currentUserLang));
    }

    if (mode === "off" || mode === 'deact' || mode === "disable") {
      if (groupConfig.welcome === "false") {
        return await message.send("*_Welcome already disabled in current group!!_*");
      }
      await groupdb.updateOne({ id: message.chat }, { welcome: "false" });
      return await message.send("*Welcome message disabled!!*");
    }

    await groupdb.updateOne({ id: message.chat }, { welcometext: input, welcome: "true" });
    await sendWelcome(message, input);
  } catch (error) {
    message.error(error + "\n\ncommand: setwelcome", error);
  }
});

