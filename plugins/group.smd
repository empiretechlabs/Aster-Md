    await message.send('*_@' + targetUser.split('@')[0] + " promoted Succesfully!_*", {
      mentions: [targetUser]
    });
  } catch (error) {
    await message.error(error + "\n\ncommand: promote", error);
  }
});

// ==================== KICK COMMAND ====================
cmd({
  pattern: "kick",
  desc: "Kicks replied/quoted user from group.",
  category: "group",
  filename: __filename,
  use: "<quote|reply|number>"
}, async (message, input) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    
    if (!message.isBotAdmin) {
      return await message.reply(langText("msgs", "not_bot_admin", {}, message.userLang || global.currentUserLang));
    }
    
    if (!message.isAdmin) {
      return message.reply(tlang().admin);
    }
    
    let targetUser = message.quoted 
      ? message.quoted.sender 
      : message.mentionedJid[0] 
        ? message.mentionedJid[0] 
        : false;
    
    if (!targetUser) {
      return await message.reply(langText("group", "provide_user", {}, message.userLang || global.currentUserLang));
    }
    
    if (message.checkBot(targetUser)) {
      return await message.reply(langText("msgs", "cant_kick_creator", {}, message.userLang || global.currentUserLang));
    }
    
