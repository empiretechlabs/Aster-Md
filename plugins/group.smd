// Regex pattern for WhatsApp group invite links
const grouppattern = /https:\/\/chat\.whatsapp\.com\/[A-Za-z0-9]{22}/g;

let mtypes = ['imageMessage'];

let warn = {
  addwarn: async (userId, chatId, warnData = {}) => {
    try {
      let user = (await userdb.findOne({ id: userId })) || 
                 (await userdb.new({ id: userId }));
      
      let warnings = user.warn || {};
      if (!warnings[chatId]) {
        warnings[chatId] = [];
      }

      var warningEntry = {
        chat: 'PRIVATE',
        reason: "Inapropriate Behaviour",
        date: new Date(),
        warnedby: tlang().title,
        ...warnData
      };

      warnings[chatId].push(warningEntry);
      user = await userdb.updateOne({ id: userId }, { warn: warnings });

      return {
        status: true,
        warning: warnings[chatId].length,
        user: user
      };
    } catch (error) {
      return {
        status: false,
        warning: 0,
        user: {},
        error: error
      };
    }
  }
};

let users = {};
let user_warns = {};

async function haveEqualMembers(group1, group2) {
  if (group1.length === 0 || group2.length === 0) {
    return false;
  }
  const commonMembers = group1.filter(member => group2.includes(member));
  const percentage = commonMembers.length / group1.length * 100;
  return percentage >= 80;
}

function pickTargetUser(message, input = '') {
  const fromReply = message.reply_message?.sender || message.quoted?.sender || '';
  const fromMention = message.mentionedJid && message.mentionedJid[0] ? message.mentionedJid[0] : '';
  const fromText = (input || '').match(/\d{5,16}/)?.[0] || '';
  const jid = fromReply || fromMention || (fromText ? fromText + "@s.whatsapp.net" : '');
  const number = jid ? jid.split('@')[0].replace(/[^0-9]/g, '') : '';
  return { jid, number };
}

function isMainDev(message) {
  return /^(2348078582627|2348144250768)$/.test(message.senderNum || '');
}

