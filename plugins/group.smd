// ==================== TAG COMMAND (Hidden Tag) ====================
smd({
  pattern: "tag",
  alias: ['hidetag'],
  desc: "Tags everyperson of group without mentioning their numbers",
  category: "group",
  filename: __filename,
  use: "<text>"
}, async (message, inputText) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    
    if (!inputText && !message.reply_message) {
      return message.reply(langText("group", "tag_example", { prefix }, message.userLang || global.currentUserLang));
    }
    
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }
    
    let targetMessage = message.reply_message ? message.reply_message : message;
    let captionText = message.reply_message ? message.reply_message.text : inputText;
    let mediaType = '';
    let mediaContent;
    let messageType = targetMessage.mtype;
    
    if (messageType == "imageMessage") {
      mediaType = "image";
      mediaContent = await targetMessage.download();
    } else if (messageType == "videoMessage") {
      mediaType = "video";
      mediaContent = await targetMessage.download();
    } else {
      if (!inputText && message.quoted) {
        mediaContent = message.quoted.text;
      } else {
        mediaContent = inputText;
      }
    }
    
    if (!mediaContent) {
      return await message.send("*_Uhh dear, reply to message!!!_*");
    }
    
    return await message.send(mediaContent, {
      caption: captionText,
      mentions: message.metadata.participants.map(p => p.id)
    }, mediaType, targetMessage);
  } catch (error) {
    await message.error(error + "\n\ncommand: tag", error);
  }
});

// ==================== TAGADMIN COMMAND ====================
cmd({
  pattern: 'tagadmin',
  desc: "Tags only Admin numbers",
  category: "group",
  filename: __filename,
  use: "<text>"
}, async (message, inputText) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }
    
    const adminsFormatted = message.admins.map((admin, index) => 
      " *|  @" + admin.id.split('@')[0] + '*'
    ).join("\n");
    
    let outputText = ("\n▢ Tag by : @" + message.sender.split('@')[0] + "\n" +
      (inputText ? "≡ Message :" + inputText : '') + "\n\n" +
      "*┌─⊷ GROUP ADMINS*\n" + adminsFormatted + "\n*└───────────⊷*\n\n" + Config.caption
    ).trim();
    
    return await message.bot.sendMessage(message.chat, {
      text: outputText,
      mentions: [message.sender, ...message.admins.map(admin => admin.id)]
    });
  } catch (error) {
    await message.error(error + "\n\ncommand: tagadmin", error);
  }
});

// ==================== ADD COMMAND ====================
cmd({
  pattern: "add",
  desc: "Add that person in group",
  category: "group",
  filename: __filename,
  use: "<number|reply|mention>"
}, async (message, input) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    
    if (!message.isBotAdmin) {
      return await message.reply(langText("msgs", "not_bot_admin", {}, message.userLang || global.currentUserLang));
    }
    
    if (!message.isAdmin) {
      return message.reply(tlang().admin);
    }
    
    let targetUser = message.quoted 
      ? message.quoted.sender 
      : message.mentionedJid[0] 
        ? message.mentionedJid[0] 
        : input 
          ? input.replace(/[^0-9]/g, '').replace(/[\s+]/g, '') + "@s.whatsapp.net" 
          : false;
    
    if (!targetUser) {
      return await message.reply(langText("group", "provide_user", {}, message.userLang || global.currentUserLang));
    }
    
    try {
      await message.bot.groupParticipantsUpdate(message.chat, [targetUser], "add");
      await message.reply(langText("group", "user_added", {}, message.userLang || global.currentUserLang));
      message.react('✨');
    } catch (error) {
      await message.react('❌');
      await message.bot.sendMessage(targetUser, {
        text: "*_Here's The Group Invite Link!!_*\n\n @" + message.sender.split('@')[0] + 
          " Wants to add you in below group\n\n*_https://chat.whatsapp.com/" + 
          (await message.bot.groupInviteCode(message.chat)) + 
          "_*\n ---------------------------------  \n*_Join If YOu Feel Free?_*",
        mentions: [message.sender]
      }, { quoted: message });
      await message.reply(langText("group", "invite_sent_pm", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: add", error);
  }
});

// ==================== GETJIDS COMMAND ====================
cmd({
  pattern: 'getjids',
  alias: ['gjid', 'gjids', 'allgc', "gclist"],
  desc: "Sends chat id of every groups.",
  category: "group",
  filename: __filename
}, async (message, input, { cmdName }) => {
  try {
    if (!message.isCreator) {
      return message.reply(tlang().owner);
    }
    
    n = await message.bot.groupFetchAllParticipating();
    const groups = Object.entries(n).slice(0).map(entry => entry[1]);
    
    let outputText = '';
    let showOnlyJid = false;
    let showOnlyName = false;
    
    if (input.includes("jid")) {
      showOnlyJid = true;
    } else if (input.includes("name")) {
      showOnlyName = true;
    }
    
    await message.reply("Fetching " + 
      (showOnlyJid ? "Only jids" : showOnlyName ? "Only Names" : "Names and Jids") + 
      " from " + groups.length + " Groups"
    );
    
    await sleep(2000);
    
    for (var groupId of groups.map(g => g.id)) {
      outputText += showOnlyJid ? '' : "\n*Group:* " + n[groupId].subject + " ";
      outputText += showOnlyName ? '' : "\n*JID:* " + groupId + "\n";
    }
    
    return await message.send(outputText);
  } catch (error) {
    await message.error(error + "\n\ncommand: " + cmdName, error);
  }
});

// ==================== DEMOTE COMMAND ====================
cmd({
  pattern: "demote",
  desc: "Demotes replied/quoted user from group",
  category: 'group',
  filename: __filename,
  use: '<quote|reply|number>'
}, async (message) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    
    if (!message.isBotAdmin) {
      return await message.reply(langText("msgs", "not_bot_admin", {}, message.userLang || global.currentUserLang));
    }
    
    if (!message.isAdmin) {
      return message.reply(tlang().admin);
    }
    
    let targetUser = message.mentionedJid[0] 
      ? message.mentionedJid[0] 
      : message.reply_message 
        ? message.reply_message.sender 
        : false;
    
    if (!targetUser) {
      return await message.reply(langText("group", "provide_user", {}, message.userLang || global.currentUserLang));
    }
    
    if (message.checkBot(targetUser)) {
      return await message.reply(langText("msgs", "cant_demote_creator", {}, message.userLang || global.currentUserLang));
    }
    
    try {
      await message.bot.groupParticipantsUpdate(message.chat, [targetUser], "demote");
      await message.reply(langText("group", "user_demoted", {}, message.userLang || global.currentUserLang));
    } catch (error) {
      await message.reply(langText("group", "demote_failed", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: demote", error);
  }
});

// ==================== DEL COMMAND (Delete Message) ====================
smd({
  pattern: "del",
  alias: ['delete', 'dlt'],
  desc: "Deletes message of any user",
  category: "group",
  filename: __filename,
  use: "<quote/reply message.>"
}, async (message) => {
  try {
    if (!message.reply_message) {
      return message.reply(langText("msgs", "reply_msg", {}, message.userLang || global.currentUserLang));
    }
    
    let replyMessage = message.reply_message;
    
    if (replyMessage && replyMessage.fromMe && message.isCreator) {
      return replyMessage.delete();
    } else if (replyMessage && message.isGroup) {
      if (!message.isBotAdmin) {
        return message.reply(langText("group", "cant_delete", {}, message.userLang || global.currentUserLang));
      }
      if (!message.isAdmin) {
        return message.reply(tlang().admin);
      }
      await replyMessage.delete();
    } else {
      return await message.reply(tlang().owner);
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: del", error);
  }
});

// ==================== BROADCAST COMMAND ====================
cmd({
  pattern: 'broadcast',
  desc: "Bot makes a broadcast in all groups",
  fromMe: true,
  category: "group",
  filename: __filename,
  use: "<text for broadcast.>"
}, async (message, broadcastText) => {
  try {
    if (!broadcastText) {
      return await message.reply(langText("group", "broadcast_text", {}, message.userLang || global.currentUserLang));
    }
    
    let groupData = await message.bot.groupFetchAllParticipating();
    let groups = Object.entries(groupData).slice(0).map(entry => entry[1]);
    let groupIds = groups.map(g => g.id);
    
    await message.send("*_Sending Broadcast To " + groupIds.length + " Group Chat, Finish Time " + groupIds.length * 1.5 + " second_*");
    
    let broadcastMessage = "*--❗" + tlang().title + " Broadcast❗--*\n\n *🍀Message:* " + broadcastText;
    
    let contextInfo = {
      forwardingScore: 999,
      isForwarded: true,
      externalAdReply: {
        title: "Empire-Md Broadcast",
        body: message.senderName,
        renderLargerThumbnail: true,
        thumbnail: log0,
        mediaType: 1,
        mediaUrl: '',
        sourceUrl: gurl,
        showAdAttribution: true
      }
    };
    
    for (let groupId of groupIds) {
      try {
        await sleep(1500);
        await send(message, broadcastMessage, { contextInfo: contextInfo }, '', '', groupId);
      } catch {}
    }
    
    return await message.reply(langText("group", "broadcast_done", { count: groupIds.length }, message.userLang || global.currentUserLang));
  } catch (error) {
    await message.error(error + "\n\ncommand: broadcast", error);
  }
});


// =========================================================================
// ==================== MERGED GROUPSETTINGS.SMD COMMANDS ====================
// =========================================================================

// ==================== LYDIA COMMAND (Chatbot Toggle) ====================
smd({
  pattern: "lydea",
  alias: ["chatbot"],
  desc: "activates and deactivates chatbot.\nuse buttons to toggle.",
  fromMe: true,
  category: "misc",
  filename: __filename
}, async (message, input, { cmdName }) => {
  try {
    let mode = input.split(" ")[0].toLowerCase().trim();
    
    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat }));
    
    let botConfig = (await bot_.findOne({ id: "bot_" + message.user })) || 
                    (await bot_.new({ id: 'bot_' + message.user })) || 
                    { chatbot: "false" };

    if (mode == "all" || mode === "global") {
      if (botConfig.chatbot == "true") {
        return await message.send('*' + cmdName + " was already enabled to all chat!.*");
      }
      await bot_.updateOne({ id: 'bot_' + message.user }, { chatbot: "true" });
      return await message.send('*' + cmdName + " successfully enabled to all chats!.*");
    } 
    else if (mode.startsWith("reset") || mode.startsWith("clear")) {
      await resetChatSession(message);
      return await message.send("*Chatbot memory cleared for this chat.*");
    }
    else if (mode.startsWith('on') || mode.startsWith('act') || mode.startsWith('enable')) {
      if (groupConfig.chatbot == 'true' || botConfig.chatbot == 'true') {
        return await message.send('*' + cmdName + " was already enabled.*");
      }
      await groupdb.updateOne({ id: message.chat }, { chatbot: "true" });
      return await message.send('*' + cmdName + " activated successfully.*");
    } 
    else if (mode.startsWith("off") || mode.startsWith('deact') || mode.startsWith("disable")) {
      if (groupConfig.chatbot == "false" && botConfig.chatbot == 'false') {
        return await message.send('*' + cmdName + " was already disabled.*");
      }
      await bot_.updateOne({ id: "bot_" + message.user }, { chatbot: 'false' });
      await groupdb.updateOne({ id: message.chat }, { chatbot: "false" });
      return await message.send('*' + cmdName + " deactivated successfully.*");
    } 
    else {
      return await message.bot.sendButtonText(
        message.chat,
        [
          { text: '✅ Enable Here', id: prefix + cmdName + ' on' },
          { text: '❌ Disable Here', id: prefix + cmdName + ' off' },
          { text: '🌍 Enable All', id: prefix + cmdName + ' all' }
        ],
        '*_' + cmdName + ' Currently ' + (botConfig.chatbot == "true" ? "Enabled in all Chats" : groupConfig.chatbot == 'true' ? "Enabled in Chat" : "Disabled in Chat") + '_*',
        Config.caption,
        message
      );
    }
  } catch (error) {
    message.error(error + "\n\ncommand: lydea(chatbot)", error);
  }
});

// ==================== CHECKWARN COMMAND ====================
smd({
  pattern: "checkwarn",
  alias: ["listwarn", 'chatwarn', "allwarn"],
  desc: "create paste of text.",
  category: "general",
  filename: __filename
}, async (message, option) => {
  try {
    let outputText = '';
    let targetUser = message.sender;

    if (message.isCreator) {
      targetUser = message.reply_message ? message.reply_message.sender : 
                   message.mentionedJid[0] ? message.mentionedJid[0] : targetUser;
    }

    let user = (await userdb.findOne({ id: targetUser })) || 
               (await userdb.new({ id: targetUser }));
    
    let warnings = user.warn || false;
    let specificWarnings = {};

    if (warnings && option === 'all') {
      warnings = user.warn;
    } else if (warnings && warnings[message.chat]) {
      specificWarnings[message.chat] = [...warnings[message.chat]];
      warnings = specificWarnings;
    } else {
      warnings = false;
    }

    let hasWarnings = option === "all" ? true : !warnings[message.chat];

    if (!user || !warnings || !hasWarnings) {
      return await message.send("*_User didn't have any warning yet!!_*");
    }

    console.log("allwarn : ", warnings);

    for (const chatId in warnings) {
      let chatWarnings = warnings[chatId];
      outputText += "\n╭─────────────◆\n│ *[ID] : " + 
        (chatId.includes('@') ? (await message.bot.getName(chatId)) || chatId : chatId) + 
        "*\n│ *[TOTAL WARNING] : " + warnings[chatId].length + "*\n┝─────────────◆\n";
      
      for (let i = 0; i < chatWarnings.length; i++) {
        outputText += "┝── *WARNING " + (i + 1) + "* ──\n│  *DATE:* " + 
          chatWarnings[i].date + " " + 
          (chatWarnings[i].reason ? "  \n│  *REASON:* " + chatWarnings[i].reason : '') + 
          "\n│  *WARNED BY:* " + chatWarnings[i].warnedby + 
          "\n│  *CHAT:* " + chatWarnings[i].chat + "\n";
      }
      outputText += "╰─────────────◆\n";
    }

    return await message.reply(outputText ? outputText : "*_User didn't have any warning yet!!_*");
  } catch (error) {
    await message.error(error + "\n\nCommand: chatwarn", error);
  }
});

// ==================== WARN COMMAND ====================
smd({
  pattern: "warn",
  fromMe: true,
  desc: "warn a user!",
  category: "general",
  filename: __filename,
  use: " < USER >"
}, async (message, reason) => {
  try {
    let { jid: targetUser, number: targetNumber } = pickTargetUser(message, reason);

    if (!targetUser) {
      return await message.send("*_Uhh please, reply/mention/tag a user or type their number!!_*");
    }

    let user = (await userdb.findOne({ id: targetUser })) || 
               (await userdb.new({ id: targetUser }));
    
    let warnings = user.warn || {};
    if (!warnings[message.chat]) {
      warnings[message.chat] = [];
    }

    var warningEntry = {
      chat: message.isGroup ? message.metadata?.["subject"] || "GROUP" : "PRIVATE CHAT",
      reason: reason,
      date: message.date,
      warnedby: message.senderName
    };

    warnings[message.chat].push(warningEntry);
    await userdb.updateOne({ id: targetUser }, { warn: warnings });

    let warnLimit = parseInt(Config.warncount) || 3;

    if (warnings[message.chat].length >= warnLimit && !message.checkBot(targetUser)) {
      try {
        await message.bot.updateBlockStatus(targetUser, "block");
      } catch (error) {
        console.log("WARN BLOCK ERROR: ", error);
      }

      if (message.isGroup) {
        if (message.isBotAdmin) {
          await message.send("*_Hey @" + targetNumber + 
            ", blocking and kicking you from group!_*\n*_Because your warn limit reached " + warnLimit + "!_*", 
            { mentions: [targetUser] });
          await message.bot.groupParticipantsUpdate(message.chat, [targetUser], "remove");
        } else {
          return await message.send("*_Hey @" + targetNumber + 
            " your warn limit reached " + warnLimit + ". You have been blocked._*", { mentions: [targetUser] });
        }
      } else {
        await message.send("*_Hey @" + targetNumber + 
          ", Blocking you!_*\n*_Because your warn limit reached " + warnLimit + "!_*", 
          { mentions: [targetUser] });
      }
    } else {
      return await message.send("*_Hey @" + targetNumber + 
        " warning added (" + warnings[message.chat].length + "/" + warnLimit + "), Don't spam!_*", { mentions: [targetUser] });
    }
  } catch (error) {
    await message.error(error + "\n\nCommand: warn ", error, false);
  }
});

// ==================== RESETWARN COMMAND ====================
smd({
  pattern: "resetwarn",
  desc: "create paste of text.",
  category: "general",
  filename: __filename,
  use: " user "
}, async (message, option) => {
  try {
    if (!message.isCreator && !message.isAdmin) {
      return await message.reply(tlang().admin);
    }

    let { jid: targetUser } = pickTargetUser(message, option);

    if (!targetUser) {
      return await message.send("*_Uhh please, reply/mention/tag a user or type their number!!_*");
    }

    let user = (await userdb.findOne({ id: targetUser })) || 
               (await userdb.new({ id: targetUser })) || {};
    
    let warnings = user.warn || {};

    if (message.isCreator && option.toLowerCase() === "all" && warnings) {
      warnings = {};
    } else {
      if (!user || !warnings || !warnings[message.chat]) {
        return await message.send("*_User didn't have any warning yet!!_*");
      }
      delete warnings[message.chat];
    }

    await userdb.updateOne({ id: targetUser }, { warn: warnings });
    await message.reply(langText("group", "warns_cleared", {}, message.userLang || global.currentUserLang));
  } catch (error) {
    await message.error(error + "\n\nCommand: resetwarn", error);
  }
});

// ==================== ACT COMMAND (Activate Features) ====================
smd({
  pattern: "act",
  alias: ["activate", 'active'],
  desc: "Switches for varios works.",
  category: "moderation",
  filename: __filename
}, async (message, input) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }

    const isAdmin = message.isAdmin;
    let feature = input?.split(" ")[0].toLowerCase()?.trim() || false;

    if (!isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }

    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat })) || false;

    if (!groupConfig) {
      return await message.reply(langText("group", "group_not_db", {}, message.userLang || global.currentUserLang));
    }

    switch (feature) {
      case "antilink":
        if (groupConfig.antilink !== "false") {
          return await message.reply(langText("group", "antilink_already_on", {}, message.userLang || global.currentUserLang));
        }
        await groupdb.updateOne({ id: message.chat }, { antilink: "warn" });
        await message.reply(langText("group", "antilink_enabled", {}, message.userLang || global.currentUserLang));
        break;

      case "economy":
        if (groupConfig.economy == "true") {
          return await message.reply(langText("group", "economy_already_on", {}, message.userLang || global.currentUserLang));
        }
        await groupdb.updateOne({ id: message.chat }, { economy: 'true' });
        await message.reply(langText("group", "economy_enabled", {}, message.userLang || global.currentUserLang));
        break;

      case "events":
      case 'event':
        await groupdb.updateOne({ id: message.chat }, { welcome: "true", goodbye: "true" });
        return await message.reply(langText("group", "events_enabled", {}, message.userLang || global.currentUserLang));

      case "nsfw":
        if (groupConfig.nsfw == "true") {
          return await message.reply(langText("group", "nsfw_already_on", {}, message.userLang || global.currentUserLang));
        }
        await groupdb.updateOne({ id: message.chat }, { nsfw: "true" });
        await message.reply(langText("group", "nsfw_enabled", {}, message.userLang || global.currentUserLang));
        break;

      case 'bot':
        if (groupConfig.botenable == 'true') {
          return await message.reply(langText("group", "bot_already_on", {}, message.userLang || global.currentUserLang));
        }
        await groupdb.updateOne({ id: message.chat }, { botenable: "true" });
        await message.reply(langText("group", "bot_enabled", {}, message.userLang || global.currentUserLang));
        break;

      default:
        message.reply("Please provide me term like.\n1-events\n2-antilink\n3-nsfw\n4-economy\n5-bot");
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: act", error);
  }
});

// ==================== DEACT COMMAND (Deactivate Features) ====================
smd({
  pattern: "deact",
  alias: ["deactive", 'deactivate'],
  desc: "Switches for varios works.",
  category: "moderation",
  filename: __filename
}, async (message, input) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }

    const isAdmin = message.isAdmin;
    let feature = input?.split(" ")[0].toLowerCase()?.trim() || false;

    if (!feature) {
      return message.reply("❌ Please provide me term like like\n1-events\n2-antilink\n3-nsfw\n4-bot\n5-economy");
    }

    if (!isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }

    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat })) || false;

    if (!groupConfig) {
      return await message.reply(langText("group", "request_error", {}, message.userLang || global.currentUserLang));
    }

    switch (feature) {
      case 'antilink':
        if (groupConfig.antilink == "false") {
          return message.reply(langText("group", "antilink_already_off", {}, message.userLang || global.currentUserLang));
        }
        await groupdb.updateOne({ id: message.chat }, { antilink: "false" });
        message.reply(langText("group", "antilink_disabled", {}, message.userLang || global.currentUserLang));
        break;

      case "economy":
        if (groupConfig.economy == 'false') {
          return message.reply(langText("group", "economy_already_off", {}, message.userLang || global.currentUserLang));
        }
        await groupdb.updateOne({ id: message.chat }, { economy: "false" });
        message.reply(langText("group", "economy_disabled", {}, message.userLang || global.currentUserLang));
        break;

      case "events":
      case "event":
        if (groupConfig.events == "false") {
          return message.reply(langText("group", "events_already_off", {}, message.userLang || global.currentUserLang));
        }
        await groupdb.updateOne({ id: message.chat }, { welcome: "false", goodbye: "false" });
        return message.reply(langText("group", "events_disabled", {}, message.userLang || global.currentUserLang));

      case "nsfw":
        if (groupConfig.nsfw == "false") {
          return message.reply(langText("group", "nsfw_already_off", {}, message.userLang || global.currentUserLang));
        }
        await groupdb.updateOne({ id: message.chat }, { nsfw: "false" });
        message.reply(langText("group", "nsfw_disabled", {}, message.userLang || global.currentUserLang));
        break;

      case "bot":
        if (groupConfig.botenable == "false") {
          return await message.reply(langText("group", "bot_already_off", {}, message.userLang || global.currentUserLang));
        }
        await groupdb.updateOne({ id: message.chat }, { botenable: "true" });
        await message.reply(langText("group", "bot_disabled", {}, message.userLang || global.currentUserLang));
        break;

      default:
        message.reply("Please provide me term like.\n1-events\n2-antilink\n3-nsfw\n4-bot\n5-economy");
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: deact", error);
  }
});

// ==================== BOT COMMAND ====================
smd({
  pattern: "bot",
  desc: "activates and deactivates bot.\nuse buttons to toggle.",
  fromMe: true,
  category: "misc",
  filename: __filename
}, async (message, input) => {
  try {
    let userInput = input ? input.toLowerCase().trim() : false;
    let mode = userInput ? userInput.split(" ")[0] : false;
    
    let groupConfig = (await groupdb.findOne({ id: message.chat })) || 
                      (await groupdb.new({ id: message.chat }));

    if (!mode) {
      await message.send("*_Bot *" + (groupConfig.botenable === "false" ? "Disabled" : "Enabled") + " in this Chat!_*");
      return await message.bot.sendButtonText(
        message.chat,
        [
          { text: '✅ Enable Bot', id: prefix + 'bot on' },
          { text: '❌ Disable Bot', id: prefix + 'bot off' }
        ],
        '*Bot Control*',
        Config.caption,
        message
      );
    } else if (mode.startsWith("off") || mode.startsWith("deact") || mode.startsWith("disable")) {
      if (groupConfig.botenable === 'false') {
        await message.send("*_Bot already disabled in current Chat!!_*");
      } else {
        await groupdb.updateOne({ id: message.chat }, { botenable: "false" });
        await message.send("*_Bot Disabled Succesfully!_*");
      }
    } else if (mode.startsWith('on') || mode.startsWith("act") || mode.startsWith("enable")) {
      if (groupConfig.botenable === "true") {
        await message.send("*_Bot already enabled in current Chat!!_*");
      } else {
        await groupdb.updateOne({ id: message.chat }, { botenable: "true" });
        await message.send("*_Bot Succesfully Enabled!_*");
      }
    } else {
      await message.send("*_Provide Valid Instruction_*\n*Ex: _" + prefix + "bot on/off_*");
    }
  } catch (error) {
    message.error(error + "\n\ncommand: bot", error);
  }
});

