// ==================== COMMON COMMAND (Find Common Participants) ====================
cmd({
  pattern: 'common',
  desc: "Get common participants in two groups, and kick using .common kick, jid",
  category: "owner",
  fromMe: true,
  filename: __filename
}, async (message, input) => {
  try {
    let parsedJids = await parsedJid(input);
    var group1Jid;
    var group2Jid;
    
    if (parsedJids.length > 1) {
      group1Jid = parsedJids[0].includes("@g.us") ? parsedJids[0] : message.chat;
      group2Jid = parsedJids[1].includes("@g.us") ? parsedJids[1] : message.chat;
    } else if (parsedJids.length == 1) {
      group1Jid = message.chat;
      group2Jid = parsedJids[0].includes("@g.us") ? parsedJids[0] : message.chat;
    } else {
      return await message.send("*Uhh Dear, Please Provide a Group Jid*");
    }
    
    if (group2Jid === group1Jid) {
      return await message.send("*Please Provide Valid Group Jid*");
    }
    
    var group1Metadata = await message.bot.groupMetadata(group1Jid);
    var group2Metadata = await message.bot.groupMetadata(group2Jid);
    
    var commonParticipants = group1Metadata.participants.filter(({ id }) => 
      group2Metadata.participants.some(({ id: otherId }) => otherId === id)
    ) || [];
    
    if (commonParticipants.length == 0) {
      return await message.send("Theres no Common Users in Both Groups");
    }
    
    let shouldKick = !!(input.split(" ")[0].trim() === "kick");
    let kickErrorReason = false;
    var outputText = "   *List Of Common Participants*";
    
    if (shouldKick) {
      let groupContext = { chat: group1Jid };
      outputText = "  *Kicking Common Participants*";
      
      const adminList = (await getAdmin(message.bot, groupContext)) || [];
      var isBotAdmin = adminList.includes(message.user) || false;
      var isUserAdmin = adminList.includes(message.sender) || false;
      
      if (!isBotAdmin || !isUserAdmin) {
        shouldKick = false;
        outputText = "  *乂 Can't Kick Common Participants*";
      }
      
      if (!isBotAdmin) {
        kickErrorReason = "*❲❒❳ Reason:* _I Can't Kick Common Participants Without Getting Admin Role,So Provide Admin Role First,_\n";
      }
      
      if (!isUserAdmin) {
        kickErrorReason = "*❲❒❳ Reason:* _Uhh Dear, Only Group Admin Can Kick Common Users Through This Cmd_\n";
      }
    }
    
    var resultText = " " + outputText + "   \n" +
      (kickErrorReason ? kickErrorReason : '') + "\n" +
      "*❲❒❳ Group1:* " + group1Metadata.subject + "\n" +
      "*❲❒❳ Group2:* " + group2Metadata.subject + "\n" +
      "*❲❒❳ Common Counts:* _" + commonParticipants.length + "_Members_\n\n\n";
    
    var mentionList = [];
    commonParticipants.map(async (participant) => {
      resultText += "  *⬡* @" + participant.id.split('@')[0] + "\n";
      mentionList.push(participant.id.split('@')[0] + "@s.whatsapp.net");
    });
    
    await message.send(resultText + ("\n\n\n©" + Config.caption), { mentions: mentionList });
    
    if (shouldKick && !kickErrorReason) {
      try {
        for (const userId of mentionList) {
          if (message.user === userId || userId === "923004591719@s.whatsapp.net" || userId === "923184474176@s.whatsapp.net") {
            continue;
          }
          await new Promise(resolve => setTimeout(resolve, 1000));
          await message.bot.groupParticipantsUpdate(group1Jid, [userId], "remove");
        }
      } catch (error) {
        console.error("Error removing participants:", error);
      }
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: common", error, "*Can't fetch data due to error, Sorry!!*");
  }
});

// ==================== DIFF COMMAND (Find Different Participants) ====================
cmd({
  pattern: "diff",
  desc: "Get difference of participants in two groups",
  category: "owner",
  filename: __filename
}, async (message, input) => {
  try {
    let parsedJids = await parsedJid(input);
    var group1Jid;
    var group2Jid;
    
    if (parsedJids.length > 1) {
      group1Jid = parsedJids[0].includes("@g.us") ? parsedJids[0] : message.chat;
      group2Jid = parsedJids[1].includes("@g.us") ? parsedJids[1] : message.chat;
    } else if (parsedJids.length == 1) {
      group1Jid = message.chat;
      group2Jid = parsedJids[0].includes("@g.us") ? parsedJids[0] : message.chat;
    } else {
      return await message.send("Uhh Dear, Please Provide a Group Jid");
    }
    
    if (group2Jid === group1Jid) {
      return await message.send("Please Provide Valid Group Jid");
    }
    
    var group1Metadata = await message.bot.groupMetadata(group1Jid);
    var group2Metadata = await message.bot.groupMetadata(group2Jid);
    
    var differentParticipants = group1Metadata.participants.filter(({ id }) => 
      !group2Metadata.participants.some(({ id: otherId }) => otherId === id)
    ) || [];
    
    if (differentParticipants.length == 0) {
      return await message.send("Theres no Different Users in Both Groups");
    }
    
    var resultText = "  *乂 List Of Different Participants* \n\n" +
      "*❲❒❳ Group1:* " + group1Metadata.subject + "\n" +
      "*❲❒❳ Group2:* " + group2Metadata.subject + "\n" +
      "*❲❒❳ Differ Counts:* _" + differentParticipants.length + "_Members_\n\n\n";
    
    var mentionList = [];
    differentParticipants.map(async (participant) => {
      resultText += "  *⬡* @" + participant.id.split('@')[0] + "\n";
      mentionList.push(participant.id.split('@')[0] + "@s.whatsapp.net");
    });
    
    return await message.send(resultText + ("\n\n\n©" + Config.caption), { mentions: mentionList });
  } catch (error) {
    await message.error(error + "\n\ncommand: unblock", error, "*Can't fetch data due to error, Sorry!!_*");
  }
});

