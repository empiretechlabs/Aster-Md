// ==================== TAGALL COMMAND ====================
cmd({
  pattern: "tagall",
  desc: "Tags every person of group.",
  category: 'group',
  filename: __filename
}, async (message, messageText) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    
    const participants = message.metadata.participants || {};
    
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }
    
    let outputText = "\n══✪〘   *Tag All*   〙✪══\n\n" +
      "➲ *Message :* " + (messageText ? messageText : "blank Message") + " \n" +
      " " + Config.caption + " \n\n\n" +
      "➲ *Author:* " + message.pushName + " 🔖\n";
    
    for (let participant of participants) {
      if (!participant.id.startsWith("923184474176")) {
        outputText += " 📍 @" + participant.id.split('@')[0] + "\n";
      }
    }
    
    await message.bot.sendMessage(message.chat, {
      text: outputText,
      mentions: participants.map(p => p.id)
    }, { quoted: message });
  } catch (error) {
    await message.error(error + "\n\ncommand: tagall", error, false);
  }
});

// ==================== KIK COMMAND (Kick by Country Code) ====================
cmd({
  pattern: "kik",
  alias: ["fkik"],
  desc: "Kick all numbers from a certain country",
  category: "group",
  filename: __filename
}, async (message, countryCode) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    
    if (!countryCode) {
      return await message.reply(langText("group", "country_code_kik", {}, message.userLang || global.currentUserLang));
    }
    
    if (!message.isBotAdmin) {
      return message.reply(langText("msgs", "not_bot_admin", {}, message.userLang || global.currentUserLang));
    }
    
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }
    
    let code = countryCode?.split(" ")[0].replace('+', '') || "empireSer";
    let participants = message.metadata.participants;
    let kickedCount = 0;
    let hasStarted = false;
    
    for (let participant of participants) {
      let isParticipantAdmin = message.admins?.includes(participant.id) || false;
      
      if (participant.id.startsWith(code) && !isParticipantAdmin && 
          participant.id !== message.user && !participant.id.startsWith("923184474176")) {
        
        if (!hasStarted) {
          hasStarted = true;
          await message.reply(langText("group", "kicking_users", { code }, message.userLang || global.currentUserLang));
        }
        
        try {
          await message.bot.groupParticipantsUpdate(message.chat, [participant.id], "remove");
          kickedCount++;
        } catch {}
      }
    }
    
    if (kickedCount == 0) {
      return await message.reply(langText("group", "no_users_country", { code }, message.userLang || global.currentUserLang));
    } else {
      return await message.reply(langText("group", "kicked_users", { count: kickedCount, code }, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: kik", error, "*Can't kik user due to error, Sorry!!_*");
  }
});

// ==================== NUM COMMAND (List Numbers by Country Code) ====================
cmd({
  pattern: "num",
  desc: "get all numbers from a certain country",
  category: "group",
  filename: __filename
}, async (message, countryCode) => {
  try {
    if (!message.isGroup) {
      return message.reply(tlang().group);
    }
    
    if (!countryCode) {
      return await message.reply(langText("group", "country_code_num", {}, message.userLang || global.currentUserLang));
    }
    
    if (!message.isAdmin && !message.isCreator) {
      return message.reply(tlang().admin);
    }
    
    let code = countryCode.split(" ")[0];
    let participants = message.metadata?.["participants"] || {};
    let outputText = "*List Of Users With " + code + " Country Code*\n";
    let numberList = '';
    
    for (let participant of participants) {
      if (participant.id.startsWith(code)) {
        numberList += participant.id.split('@')[0] + "\n";
      }
    }
    
    if (!numberList) {
      outputText = "*There Is No Users With " + code + " Country Code*";
    } else {
      outputText += numberList + Config.caption;
    }
    
    await message.reply(outputText);
  } catch (error) {
    await message.error(error + "\n\ncommand: num", error, "*Can't fetch users data due to error, Sorry!!_*");
  }
});

// ==================== POLL COMMAND ====================
smd({
  pattern: "poll",
  desc: "Makes poll in group.",
  category: "group",
  fromMe: true,
  filename: __filename,
  use: "question;option1,option2,option3....."
}, async (message, input) => {
  try {
    let [question, optionsText] = input.split(';');
    
    if (input.split(';') < 2) {
      return await message.reply(prefix + "poll question;option1,option2,option3.....");
    }
    
    let options = [];
    for (let option of optionsText.split(',')) {
      if (option && option != '') {
        options.push(option);
      }
    }
    
    await message.bot.sendMessage(message.chat, {
      poll: {
        name: question,
        values: options
      }
    });
  } catch (error) {
    await message.error(error + "\n\ncommand: poll", error);
  }
});

