let {
  smd,
  lang,
  textToLogoGenerator,
  prefix,
  langText,
  tr
} = require("../lib");
smd({
  'cmdname': 'slice',
  'type': "logo",
  'info': "Some text to image feature with various styles.",
  'filename': __filename
}, async (message, text, {
  cmdName
}) => {
  try {
    if (!text) {
      return message.reply(langText("textpro", "example_text", { prefix, cmd: prefix + cmdName }, message.userLang || global.currentUserLang));
    }
    return await textToLogoGenerator(message, "create-light-glow-sliced-text-effect-online-1068", text);
  } catch (error) {
    return await message.error(error + "\n\ncmdName: " + cmdName, error);
  }
});

