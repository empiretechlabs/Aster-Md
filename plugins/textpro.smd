smd({
  cmdname: "phub",
  type: "logo",
  info: "Some text to image feature with various styles.",
  filename: __filename
}, async (message, text, { cmdName }) => {
  try {
    const text1 = text ? text.split(";")[0] : "";
    const text2 = text ? text.split(";")[1] : "";

    if (!text1 || !text2) {
      return await message.reply(
        `*_Example : ${prefix + cmdName} text1;text2_*`
      );
    }

    return await textToLogoGenerator(
      message,
      "pornhub-style-logo-online-generator-free-977",
      text1,
      text2
    );

  } catch (error) {
    return await message.error(
      `${error}\n\ncmdName: ${cmdName}`,
      error
    );
  }
});

