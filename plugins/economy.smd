const { groupdb, smd, getBuffer, tlang, prefix, langText, tr } = require('../lib');
const eco = require('discord-mongoose-economy');

let economyConnected = false;

try {
  if (isMongodb) {
    economyConnected = eco.connect(mongodb);
    console.log("Connected with discord economy!!");
  }
} catch (error) {
  economyConnected = false;
}

// ==================== ECONOMY COMMANDS ====================

if (economyConnected) {
  
  // Command: daily - Claim daily gold
  smd({
    pattern: "daily",
    desc: "daily gold.",
    category: "economy",
    filename: __filename
  }, async ({ reply, chat, isGroup, sender, error }) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: chat })) || {};
      if (groupConfig?.economy == "false") {
        return reply("*🚦Economy* is not active in current group.");
      }
      if (!isGroup) {
        return reply(tlang().group);
      }
      
      const dailyReward = await eco.daily(sender, "Empire", 500);
      if (dailyReward.cd) {
        return await reply(`🧧 You already claimed daily for today, come back in ${dailyReward.cdL}🫡`);
      } else {
        reply(`you claimed daily ${dailyReward.amount} 🪙 for today🎉.`);
      }
    } catch (e) {
      error(`${e}\n\ncommand: daily`, e);
    }
  });

  // Command: resetwallet - Reset wallet of quoted user
  smd({
    pattern: "resetwallet",
    desc: "reset wallet of quoted user.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: message.chat })) || (await groupdb.new({ id: message.chat }));
      let economyEnabled = groupConfig.economy || "false";
      
      if (economyEnabled == "false") {
        return message.reply(langText("economy", "not_active", {}, message.userLang || global.currentUserLang));
      }
      if (!isCreator) {
        return message.reply(tlang().owner);
      }
      
      let targetUser = message.mentionedJid ? message.mentionedJid[0] : message.msg.contextInfo.participant || false;
      if (!targetUser) {
        return message.reply('Please give me user.');
      }
      
      const balance = await eco.balance(targetUser, "Empire");
      await eco.deduct(targetUser, "Empire", balance.wallet);
      
      return await message.reply(
        `⛩️ User: @${targetUser.split('@')[0]} \n *🧧 @${targetUser.split('@')[0]} lost all 🪙 in wallet.*\n_Now live with that poverty.🫡_`,
        { mentions: [targetUser] }
      );
    } catch (e) {
      message.error(`${e}\n\ncommand: resetwallet`, e);
    }
  });

  // Command: capacity - Update bank capacity
  smd({
    pattern: "capacity",
    desc: "update capacity.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message, match) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: message.chat })) || (await groupdb.new({ id: message.chat }));
      let economyEnabled = groupConfig.economy || "false";
      
      if (economyEnabled == "false") {
        return message.reply(langText("economy", "not_active", {}, message.userLang || global.currentUserLang));
      }
      if (!message.isGroup) {
        return message.reply(tlang().group);
      }
      if (!match) {
        return message.reply(
          `💴 *Bank-capacity* 💳\n\n1 | *1000 sp* = 🪙100\n\n2 | *100000 sp* = 🪙1000\n\n3 | *10000000 sp* = 🪙10000000\n\nExample- ${prefix}capacity 1 OR ${prefix}bankupgrade 1000`
        );
      }
      
      let user = message.mentionedJid ? message.mentionedJid[0] : message.msg.contextInfo.participant || false;
      let value = match.trim();
      let amount = parseInt(value);
      const balance = await eco.balance(user, "Empire");
      
      switch (value) {
        case '1000':
        case '1':
          if (amount > balance.wallet) {
            return message.reply(`*_You need to pay 🪙100 to increase bank capacity ~ 1000 sp_*`);
          }
          return await message.reply(`*1000 🪙diamond storage has been added in ${message.senderName} bank*`);
        case '100000':
        case '2':
          if (amount < balance.wallet) {
            return message.reply(`*You need to pay 🪙1000 to increase bank capacity ~ 100000 sp*`);
          }
          return await message.reply(`*100000 🪙diamond storage has been added in ${message.pushName} bank*`);
        case '10000000':
        case '3':
          if (amount < balance.wallet) {
            return message.reply(`You need to pay 🪙10000 to increase bank capacity ~ 1000 sp`);
          }
          return await message.reply(`*10000000 🪙diamond storage has been added in ${message.pushName}\'s bank*`);
        default:
          await message.reply(langText("economy", "invalid_action", {}, message.userLang || global.currentUserLang));
      }
    } catch (e) {
      message.error(`${e}\n\ncommand: capacity`, e);
    }
  });

  // Command: deposit - Deposit gold into bank
  smd({
    pattern: "deposit",
    desc: "deposit gold.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message, match) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: message.chat })) || {};
      let economyEnabled = groupConfig.economy || "false";
      
      if (economyEnabled == "false") {
        return message.reply(langText("economy", "not_active", {}, message.userLang || global.currentUserLang));
      }
      if (!match) {
        return message.reply("Baka!! Provide the 💰amount you want to deposit!");
      }
      
      let depositAmount = parseInt(match);
      const deposit = await eco.deposit(message.sender, "Empire", depositAmount);
      
      if (deposit.noten) {
        return message.reply("You can't deposit what you don't have💰.");
      }
      
      return await message.reply(
        `⛩️ Sender: ${message.pushName}\n🍀Successfully 💰Deposited 🪙${deposit.amount} to your bank.Upgrade your bank capacity to add more money📈.`
      );
    } catch (e) {
      message.error(`${e}\n\ncommand: deposit`, e);
    }
  });

  // Command: lb - Leaderboard
  smd({
    pattern: "lb",
    desc: "check leaderboard.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message) => {
    try {
      let topUsers = await eco.lb("Empire", 10);
      let leaderboardText = `*Top ${topUsers.length} users with more money in wallet.*\n`;
      let mentionList = [];
      
      for (let i = 0; i < topUsers.length; i++) {
        var userName = message.bot.getName(topUsers[i].userID);
        leaderboardText += `*${i + 1}*\n╭─────────────◆\n│ *Name:-* _${userName}_\n│ *User:-* _@${topUsers[i].userID.split('@')[0]}_\n│ *Wallet:-* _${topUsers[i].wallet}_\n│ *Bank Amount:-* _${topUsers[i].bank}_\n│ *Bank Capacity:-* _${topUsers[i].bankCapacity}_\n╰─────────────◆\n\n`;
        mentionList.push(topUsers[i].userID);
      }
      
      await message.reply(leaderboardText, { mentions: mentionList });
    } catch (e) {
      message.error(`${e}\n\ncommand: lb`, e);
    }
  });

  // Command: transfer - Transfer gold to another user
  smd({
    pattern: "transfer",
    desc: "transfer gold.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message, match) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: message.chat })) || {};
      let economyEnabled = groupConfig.economy || "false";
      
      if (economyEnabled == "false") {
        return message.reply(langText("economy", "not_active", {}, message.userLang || global.currentUserLang));
      }
      
      let values = match.trim().split(" ");
      if (values[0] === "") {
        return message.reply(`Use ${prefix}transfer 100 @user`);
      }
      
      let targetUser = message.mentionedJid ? message.mentionedJid[0] : message.msg.contextInfo.participant || false;
      if (!targetUser) {
        return message.reply('Please give me any user🤦‍♂️.');
      }
      
      const sender = message.sender;
      const transferAmount = parseInt(values[0]);
      
      if (!transferAmount) {
        return message.reply("check your text plz u r using the command in a wrong way👀");
      }
      
      const balance = await eco.balance(sender, "Empire");
      
      if (balance.wallet < transferAmount) {
        return message.reply("you dont have sufficient money to transfer👎");
      }
      
      return await message.reply(`*📠 Transaction successful of ${values[0]} 💰*`);
    } catch (e) {
      message.error(`${e}\n\ncommand: transfer`, e);
    }
  });

  // Command: wallet - Show wallet balance
  smd({
    pattern: "wallet",
    desc: "shows wallet.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: message.chat })) || (await groupdb.new({ id: message.chat }));
      let economyEnabled = groupConfig.economy || "false";
      
      if (economyEnabled == "false") {
        return message.reply(langText("economy", "not_active", {}, message.userLang || global.currentUserLang));
      }
      
      const balance = await eco.balance(message.sender, "Empire");
      return await message.reply(`*👛 ${message.pushName}'s Purse:*\n\n_🪙${balance.wallet}_`);
    } catch (e) {
      message.error(`${e}\n\ncommand: wallet`, e);
    }
  });

  // Command: give - Add money to user's wallet (owner only)
  smd({
    pattern: "give",
    desc: "Add money in wallet.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message, match) => {
    try {
      if (!message.isCreator) {
        return message.reply(`*_Hey buddy, only my owner can give money!_*`);
      }
      
      let targetUser = message.mentionedJid ? message.mentionedJid[0] : message.msg?.contextInfo?.participant || false;
      if (!targetUser) {
        return message.reply('Please give me user to add money.');
      }
      
      await eco.give(targetUser, "Empire", parseInt(match.split(' ')[0]));
      
      return await message.bot.sendMessage(message.chat, {
        text: `Added 📈 ${parseInt(match.split(' ')[0])} to @${targetUser.split('@')[0]} wallet🛸.`,
        mentions: [targetUser]
      }, { quoted: message });
    } catch (e) {
      message.error(`${e}\n\ncommand: give`, e);
    }
  });

  // Command: bank - Show bank balance
  smd({
    pattern: "bank",
    desc: "shows bank amount.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: message.chat })) || (await groupdb.new({ id: message.chat }));
      let economyEnabled = groupConfig.economy || "false";
      
      if (economyEnabled == "false") {
        return message.reply(langText("economy", "not_active", {}, message.userLang || global.currentUserLang));
      }
      
      const balance = await eco.balance(message.sender, "Empire");
      return await message.reply(`🍀User: ${message.pushName}\n\n_🪙${balance.bank}/${balance.bankCapacity}_`);
    } catch (e) {
      message.error(`${e}\n\ncommand: bank`, e);
    }
  });

  // Command: rob - Rob another user's bank
  smd({
    pattern: "rob",
    desc: "rob bank amount.",
    category: "economy",
    filename: __filename
  }, async (message) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: message.chat })) || (await groupdb.new({ id: message.chat }));
      let economyEnabled = groupConfig.economy || "false";
      
      if (economyEnabled == "false") {
        return message.reply(langText("economy", "not_active", {}, message.userLang || global.currentUserLang));
      }
      
      let targetUser = message.mentionedJid ? message.mentionedJid[0] : message.msg.contextInfo.participant || false;
      if (!targetUser) {
        return message.reply('Please give me user to rob.');
      }
      
      const robber = message.sender;
      const robberBalance = await eco.balance(robber, "Empire");
      const victimBalance = await eco.balance(targetUser, "Empire");
      
      const outcomes = ['ran', 'rob', 'caught'];
      const result = outcomes[Math.floor(Math.random() * outcomes.length)];
      
      if (1000 > robberBalance.wallet) {
        return message.reply(`*☹️ You don't have enough money to pay incase you get caught*`);
      }
      if (1000 > victimBalance.wallet) {
        return message.reply(`*Sorry, your victim is too poor 🤷🏽‍♂️ let go🫤.*`);
      }
      
      switch (result) {
        case 'ran':
          await message.reply(`*Your victim escaped, be more scary next time🫰.*`);
          break;
        case 'rob':
          const stolenAmount = Math.floor(Math.random() * 1000);
          await eco.deduct(targetUser, "Empire", stolenAmount);
          await eco.give(message.sender, "Empire", stolenAmount);
          await message.reply(`*🤑 Robbery operation done successfully.🗡️*\nYou ran with ${stolenAmount} amount in your wallet.`);
          break;
        case 'caught':
          const penaltyAmount = Math.floor(Math.random() * 1000);
          await eco.deduct(robber, "Empire", penaltyAmount);
          await message.reply(`*Sorry FBI👮 caught up with you, you paid ${penaltyAmount} 🪙 from wallet🥹.*`);
          break;
        default:
          await message.reply(langText("economy", "invalid_action", {}, message.userLang || global.currentUserLang));
      }
    } catch (e) {
      message.error(`${e}\n\ncommand: rob`, e);
    }
  });

  // Command: withdraw - Withdraw money from bank
  smd({
    pattern: "withdraw",
    desc: "withdraw money from bank account.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message, match) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: message.chat })) || {};
      let economyEnabled = groupConfig.economy || "false";
      
      if (economyEnabled == "false") {
        return message.reply(langText("economy", "not_active", {}, message.userLang || global.currentUserLang));
      }
      
      const user = message.sender;
      if (!match) {
        return message.reply(langText("economy", "withdraw_amount", {}, message.userLang || global.currentUserLang));
      }
      
      const query = match.trim();
      const withdraw = await eco.withdraw(user, "Empire", query);
      
      if (withdraw.noten) {
        return message.reply(langText("economy", "insufficient_funds", {}, message.userLang || global.currentUserLang));
      }
      
      message.reply(`*🏧 ALERT* \n _🪙${withdraw.amount} has been withdrawn from your wallet💰._`);
    } catch (e) {
      message.error(`${e}\n\ncommand: withdraw`, e);
    }
  });

  // Command: gamble - Gamble money with direction betting
  smd({
    pattern: "gamble",
    desc: "gamble money.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message, match) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: message.chat })) || {};
      let economyEnabled = groupConfig.economy || "false";
      
      if (economyEnabled == "false") {
        return message.reply(langText("economy", "not_active", {}, message.userLang || global.currentUserLang));
      }
      
      const user = message.sender;
      var texts = match.split(" ");
      var chosenDirection = texts[1];
      var betValue = texts[0].toLowerCase();
      var betAmount = parseInt(betValue);
      
      const balance = await eco.balance(user, "Empire");
      const hasEnoughBalance = balance.wallet > parseInt(betValue);
      const isMinimumBetMet = 50 > parseInt(betValue);
      const winAmount = betAmount * 2;
      
      var directionImageUrl;
      if (chosenDirection === 'left') {
        directionImageUrl = 'https://github.com/SecktorBot/Brandimages/blob/main/Nezuko/leftr.webp?raw=true';
      } else if (chosenDirection === 'right') {
        directionImageUrl = 'https://github.com/SecktorBot/Brandimages/blob/main/Nezuko/rightr.webp?raw=true';
      } else if (chosenDirection === 'up') {
        directionImageUrl = 'https://github.com/SecktorBot/Brandimages/blob/main/Nezuko/upr.webp?raw=true';
      } else if (chosenDirection === 'down') {
        directionImageUrl = 'https://github.com/SecktorBot/Brandimages/blob/main/Nezuko/downr.webp?raw=true';
      } else {
        message.reply(`Please provide direction(left,right,up,down).\nEg:- ${prefix}gamble 200 left`);
      }
      
      let stickerMedia = await getBuffer(directionImageUrl);
      message.reply(stickerMedia, { packname: "Empire", author: 'Economy' }, "sticker");
      
      const possibleDirections = ["up", "right", "left", "down", "up", "left", "down", "right", "up", "down", "right", "left"];
      const randomDirection = possibleDirections[Math.floor(Math.random() * possibleDirections.length)];
      
      if (!match) {
        return message.reply(`Example:  ${prefix}gamble 100 direction(left,right,up,down)`);
      }
      if (!betValue) {
        return message.reply(langText("economy", "gamble_amount", {}, message.userLang || global.currentUserLang));
      }
      if (!chosenDirection) {
        return message.reply(langText("economy", "gamble_direction", {}, message.userLang || global.currentUserLang));
      }
      if (!betAmount) {
        return message.reply(langText("economy", "gamble_wrong", {}, message.userLang || global.currentUserLang));
      }
      if (hasEnoughBalance == false) {
        return message.reply(`*You don't have sufficient 🪙 Diamond to gamble with*`);
      }
      if (isMinimumBetMet == true) {
        return message.reply(`*Sorry ${message.pushName}, you can only gamble with more than 🪙50.*`);
      }
      
      if (randomDirection == chosenDirection) {
        return await message.reply(`*📈 You won 🪙${winAmount}*`);
      } else {
        return await message.reply(`*📉 You lost 🪙${texts[0]}*`);
      }
    } catch (e) {
      message.error(`${e}\n\ncommand: gamble`, e);
    }
  });

  // Command: slot2 - Weekend slot game
  smd({
    pattern: "slot2",
    desc: "withdraw money from bank account.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message, match) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: message.chat })) || {};
      let economyEnabled = groupConfig.economy || "false";
      
      if (economyEnabled == "false") {
        return message.reply(langText("economy", "not_active", {}, message.userLang || global.currentUserLang));
      }
      
      var today = new Date();
      
      // Only available on weekends (Friday, Saturday, Sunday)
      if (today.getDay() == 6 || today.getDay() == 5 || today.getDay() == 0) {
        if (match == 'help') {
          return message.reply(
            `*1:* Use ${prefix}slot to play\n\n*2:* You must have 🪙100 in your wallet\n\n*3:* If you don't have money in wallet then 👛withdraw from your bank🏦\n\n*4:* If you don't have 🤑 money in your 🏦bank too then use economy features to 📈gain money`
          );
        }
        if (match == 'money') {
          return message.reply(
            `*1:* Small Win --> +🪙20\n\n*2:* Small Lose --> -🪙20\n\n*3:* Big Win --> +🪙100\n\n*4:* Big Lose --> -🪙50\n\n*5:* 🎉 JackPot --> +🪙1000`
          );
        }
        
        const fruit1 = ["🥥", "🍎", "🍇"];
        const fruit2 = ["🍎", "🍇", "🥥"];
        const fruit3 = ["🍇", "🥥", "🍎"];
        
        const loseMessages = [
          "*You suck at playing this game*\n\n_--> 🍍-🥥-🍎_",
          "*Totally out of line*\n\n_--> 🥥-🍎-🍍_",
          "*Are you a newbie?*\n\n_--> 🍎-🍍-🥥_"
        ];
        const smallLoseMessages = [
          "*You cannot harvest coconut 🥥 in a pineapple 🍍 farm*\n\n_--> 🍍>🥥<🍍_",
          "*Apples and Coconut are not best Combo*\n\n_--> 🍎>🥥<🍎_",
          "*Coconuts and Apple are not great deal*\n\n_--> 🥥>🍎<🥥_"
        ];
        const winMessages = [
          "*You harvested a basket of*\n\n_--> 🍎+🍎+🍎_",
          "*Impressive, You must be a specialist in plucking coconuts*\n\n_--> 🥥+🥥+🥥_",
          "*Amazing, you are going to be making pineapple juice for the family*\n\n_--> 🍍+🍍+🍍_"
        ];
        const nearWinMessages = [
          "*Wow, you were so close to winning pineapples*\n\n_--> 🍎-🍍+🍍_",
          "*Hmmm, you were so close to winning Apples*\n\n_--> 🍎+🍎-🍍_"
        ];
        const jackpotMessages = [
          "*🥳 JackPot 🤑*\n\n_--> 🍇×🍇×🍇×🍇_",
          "*🎉 JaaackPooot!*\n\n_--> 🥥×🥥×🥥×🥥_",
          '*🎊 You Just hit a jackpot worth 🪙1000*'
        ];
        
        const user = message.sender;
        const balance1 = await eco.balance(user, "Empire");
        
        if (100 > balance1.wallet) {
          return message.reply(`You are going to be spinning on your wallet, you need at least 🪙100`);
        }
        
        const f1 = fruit1[Math.floor(Math.random() * fruit1.length)];
        const f2 = fruit2[Math.floor(Math.random() * fruit2.length)];
        const f3 = fruit3[Math.floor(Math.random() * fruit3.length)];
        
        const loseMsg = loseMessages[Math.floor(Math.random() * loseMessages.length)];
        const winMsg = winMessages[Math.floor(Math.random() * winMessages.length)];
        const nearMsg = nearWinMessages[Math.floor(Math.random() * nearWinMessages.length)];
        const jackpotMsg = jackpotMessages[Math.floor(Math.random() * jackpotMessages.length)];
        const smallLoseMsg = smallLoseMessages[Math.floor(Math.random() * smallLoseMessages.length)];
        
        if (match.split(' ')[0]) {
          let betValue = match.split(' ')[0];
          const balance = await eco.balance(message.sender, "Empire");
          console.log(balance.wallet);
          
          if (betValue <= balance.wallet) {
            const deductedAmount = Math.floor(Math.random() * betValue);
            
            if (f1 !== f2 && f2 !== f3) {
              return message.reply(`${loseMsg}\n\n*Big Lose -->* _🪙${deductedAmount}_`);
            } else if (f1 == f2 && f2 == f3) {
              return message.reply(`${winMsg}\n*_Little Jackpot -->* _🪙${deductedAmount / 2}_`);
            } else if (f1 == f2 && f2 !== f3) {
              return message.reply(`${nearMsg}\n*Small Win -->* _🪙${deductedAmount}_`);
            } else if (f1 !== f2 && f1 == f3) {
              return message.reply(`${smallLoseMsg}\n\n*Small Lose -->* _🪙${deductedAmount}_`);
            } else if (f1 !== f2 && f2 == f3) {
              return message.reply(`${nearMsg}\n\n*Small Win -->* _🪙${deductedAmount}_`);
            } else if (f1 == f2 && f2 == f3 && f3 == f4) {
              return message.reply(`${jackpotMsg}\n\n_🎊 JackPot --> _🪙${deductedAmount * 20}_`);
            } else {
              return message.reply(`Do you understand what you are doing?`);
            }
          } else {
            return message.reply("You don't have enough 💰amount in your👛 wallet.\n- Please don't provide 🤑amount.");
          }
        }
        
        // Default game without bet amount
        if (f1 !== f2 && f2 !== f3) {
          message.reply(`${loseMsg}\n\n*Big Lose -->* _🪙50_`);
        } else if (f1 == f2 && f2 == f3) {
          message.reply(`${winMsg}\n*_Little Jackpot -->* _🪙100_`);
        } else if (f1 == f2 && f2 !== f3) {
          message.reply(`${nearMsg}\n*Small Win -->* _🪙20_`);
        } else if (f1 !== f2 && f1 == f3) {
          message.reply(`${smallLoseMsg}\n\n*Small Lose -->* _🪙20_`);
        } else if (f1 !== f2 && f2 == f3) {
          message.reply(`${nearMsg}\n\n*Small Win -->* _🪙20_`);
        } else if (f1 == f2 && f2 == f3 && f3 == f4) {
          message.reply(`${jackpotMsg}\n\n_🎊 JackPot --> _🪙1000_`);
        } else {
          message.reply(`Do you understand what you are doing?`);
        }
      } else {
        message.reply(`*You can only play this game during weekends*\n\n*🌿 Friday*\n*🎏 Saturday*\n*🎐 Sunday*`);
      }
    } catch (e) {
      message.error(`${e}\n\ncommand: slot2`, e);
    }
  });

  // Command: slot - Slot machine game
  smd({
    pattern: "slot",
    desc: "slot game.",
    category: "economy",
    filename: __filename,
    react: "💷"
  }, async (message) => {
    try {
      let groupConfig = (await groupdb.findOne({ id: message.chat })) || {};
      let economyEnabled = groupConfig.economy || "false";
      
      if (economyEnabled == "false") {
        return message.reply(langText("economy", "not_active", {}, message.userLang || global.currentUserLang));
      }
      
      const balance = await eco.balance(message.sender, "Empire");
      if (100 > balance.wallet) {
        return message.reply(`You are going to be spinning on your wallet, you need at least 🪙100`);
      }
      
      var slotRows = new Array();
      slotRows[0] = "1 : 2 : 3";
      slotRows[1] = "1 : 2 : 3";
      slotRows[2] = "1 : 2 : 3";
      slotRows[3] = "4 : 3 : 3";
      slotRows[4] = "1 : 1 : 1";
      slotRows[5] = "5 : 2 : 5";
      slotRows[6] = "3 : 5 : 3";
      slotRows[7] = "1 : 3 : 6";
      slotRows[8] = "6 : 2 : 7";
      slotRows[9] = "1 : 6 : 3";
      slotRows[10] = "6 : 3 : 2";
      slotRows[11] = "5 : 5 : 6";
      slotRows[12] = "1 : 5 : 3";
      slotRows[13] = "4 : 1 : 7";
      slotRows[14] = "4 : 3 : 2";
      slotRows[15] = "4 : 3 : 2";
      slotRows[16] = "7 : 4 : 6";
      slotRows[17] = "6 : 5 : 1";
      slotRows[18] = "5 : 7 : 2";
      
      var rowIndex1 = Math.floor(19 * Math.random());
      var rowIndex2 = Math.floor(19 * Math.random());
      var rowIndex3 = Math.floor(19 * Math.random());
      var row1 = slotRows[rowIndex1];
      var row2 = slotRows[rowIndex2];
      var row3 = slotRows[rowIndex3];
      
      console.log(row1 + "\n" + row2 + "\n" + row3);
      
      let row1Values = row1.split(':');
      let row2Values = row2.split(':');
      let row3Values = row3.split(':');
      
      var isWinner = false;
      
      // Check all winning combinations
      if (row1Values[2] === row2Values[1] && row2Values[1] === row3Values[0]) isWinner = true;
      if (row1Values[0] === row2Values[1] && row2Values[1] === row3Values[2]) isWinner = true;
      if (row1Values[0] === row2Values[0] && row2Values[0] === row3Values[0]) isWinner = true;
      if (row1Values[1] === row2Values[1] && row2Values[1] === row3Values[1]) isWinner = true;
      if (row1Values[2] === row2Values[2] && row2Values[2] === row3Values[2]) isWinner = true;
      if (row1Values[0] === row2Values[1] && row2Values[1] === row3Values[2]) isWinner = true;
      if (row1Values[2] === row2Values[1] && row2Values[1] === row3Values[0]) isWinner = true;
      if (row1Values[0] === row1Values[1] && row1Values[0] === row1Values[2]) isWinner = true;
      if (row2Values[0] === row2Values[1] && row2Values[0] === row2Values[2]) isWinner = true;
      if (row3Values[0] === row3Values[1] && row3Values[0] === row3Values[2]) isWinner = true;
      if (row1Values[0] === row3Values[1] && row1Values[0] === row3Values[2]) isWinner = true;
      
      if (isWinner) {
        const winAmount = Math.floor(Math.random() * 5000);
        return await message.reply(`You got ${winAmount * 10} in your wallet.`);
      } else {
        const lossAmount = Math.floor(Math.random() * 300);
        let resultText = `\n🎰 Slot Machine Result\n     ${row1}\n\n      ${row2}\n\n      ${row3}\n\nNot Jacpot📉 but lost `
          .replace(/1/g, `🔴`)
          .replace(/2/g, `🔵`)
          .replace(/3/g, `🟣`)
          .replace(/4/g, `🟢`)
          .replace(/5/g, `🟡`)
          .replace(/6/g, `⚪️`)
          .replace(/7/g, `⚫️`)
          .replace(/:/g, `    `);
        return await message.reply(resultText + ` ${lossAmount}.`);
      }
    } catch (e) {
      message.error(`${e}\n\ncommand: slot`, e);
    }
  });
}