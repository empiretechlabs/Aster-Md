// ==================== IMAGINE COMMAND (Hugging Face) ====================
smd({
  pattern: "imagine",
  alias: ["imagin"],
  desc: "Generate images with AI",
  category: 'ai',
  use: "<boy walking on street>",
  filename: __filename
}, async (message, query) => {
  try {
    let promptText = query || message.reply_text;
    if (!promptText) {
      return await message.reply(langText("ai", "imagine_query", {}, message.userLang || global.currentUserLang));
    }
    
    let aiDescription = false;
    try {
      const response = await fetch("https://aemt.me/openai?text=" + (promptText + " \nNOTE: Make sure to looks like imagination, make it short and concise, also in english!"));
      const data = await response.json();
      aiDescription = data && data.status && data.result ? data.result : '';
    } catch (error) {
      aiDescription = false;
    }
    
    if (!Config.HF_API_KEY) {
      return await message.reply(langText("ai", "api_key_missing", {}, message.userLang || global.currentUserLang) || "*_Hugging Face API key not configured (HF_API_KEY)._*\nSet it in your `.env` file.");
    }

    const drawResponse = await fetch(
      "https://api-inference.huggingface.co/models/prompthero/openjourney-v2",
      {
        method: "POST",
        headers: {
          'content-type': "application/json",
          'Authorization': "Bearer " + Config.HF_API_KEY
        },
        body: JSON.stringify({ inputs: promptText })
      }
    ).then(response => response.blob());
    
    const arrayBuffer = await drawResponse.arrayBuffer();
    const imageBuffer = Buffer.from(arrayBuffer);
    
    await message.bot.sendMessage(message.chat, {
      image: imageBuffer,
      caption: "*[IMAGINATION]:* ```" + promptText + " ```" + 
        (aiDescription ? "\n\n*[RESPONSE]:* ```" + aiDescription + "``` \n" : '') + 
        "  \n " + Config.caption + " "
    });
    
  } catch (error) {
    await message.error(error + "\n\ncommand: imagine", error, "*_No response from Server side, Sorry!!_*");
  }
});

// ==================== RMBG COMMAND (Remove Background) ====================
smd({
  pattern: "rmbg",
  alias: ["removebg"],
  category: 'ai',
  filename: __filename,
  desc: "Remove image Background."
}, async (message) => {
  try {
    if (!Config.REMOVE_BG_KEY) {
      return message.reply(
        "```You Dont Have REMOVE_BG_KEY \n" +
        "Please Create RemoveBG KEY from Given Link \n" +
        "https://www.remove.bg/\n" +
        "And Set Key in REMOVE_BG_KEY Var```"
      );
    }
    
    let mediaTypes = ["imageMessage"];
    let mediaMessage = mediaTypes.includes(message.mtype) ? message : message.reply_message;
    
    if (!mediaMessage || !mediaTypes.includes(mediaMessage?.["mtype"] || "null")) {
      return await message.send("*_Uhh Dear, Reply to an image_*");
    }
    
    let mediaPath = await message.bot.downloadAndSaveMediaMessage(mediaMessage);
    let imageUrl = await TelegraPh(mediaPath);
    
    try {
      fs.unlinkSync(mediaPath);
    } catch {}
    
    const response = await axios.post(
      "https://api.remove.bg/v1.0/removebg",
      {
        image_url: imageUrl,
        size: "auto"
      },
      {
        headers: {
          "X-Api-Key": Config.REMOVE_BG_KEY
        },
        responseType: "arraybuffer"
      }
    );
    
    const result = Buffer.from(response.data, "binary");
    
    if (result) {
      await message.send(result, { caption: Config.caption }, "image", message);
    } else {
      await message.send("*_Request not be preceed!!_*");
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: rmbg", error, "*_No responce from remove.bg, Sorry!!_*");
  }
});

