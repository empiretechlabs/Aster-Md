// ==================== ALEXA COMMAND (Chat with SimSimi AI) ====================
smd({
  pattern: "alexa",
  category: 'ai',
  use: "[text]",
  filename: __filename,
  desc: "chat with simsimi alexa ai!"
}, async (message, text) => {
  try {
    if (!text) {
      return await message.reply(`Hi *${message.pushName}*, do you want to talk?`);
    }
    
    const requestOptions = {
      method: "POST",
      headers: {
        'Content-Type': "application/x-www-form-urlencoded"
      },
      body: `text=${encodeURIComponent(text)}&lc=en&key=`
    };
    
    const response = await fetch("https://api.simsimi.vn/v1/simtalk", requestOptions);
    const responseData = await response.json();
    
    if (responseData.status === "200" && responseData.message) {
      message.reply(responseData.message);
    } else {
      message.reply(langText("msgs", "no_response", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    await message.error(error + "\n\ncommand : alexa", error, false);
  }
});