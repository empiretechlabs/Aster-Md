// ==================== DALLE COMMAND (Free DALL-E API) ====================
smd({
  pattern: "dalle",
  alias: ["dall", "dall-e"],
  desc: "Generate images with DALL-E",
  category: 'ai',
  use: "<image description>",
  filename: __filename
}, async (message, query) => {
  try {
    if (!query) {
      return await message.reply(langText("ai", "dalle_query", {}, message.userLang || global.currentUserLang));
    }
    
    const imageUrl = 'https://gurugpt.cyclic.app/dalle?prompt=' + encodeURIComponent(query + " \nNOTE: Make sure to looks like imagination");
    
    return await message.bot.sendMessage(message.chat, {
      image: { url: imageUrl },
      caption: "[PROMPT]: ```" + query + " ```  \n " + Config.caption + " "
    });
    
  } catch (error) {
    await message.error(error + "\n\ncommand: dalle", error, "*_No response from DALL-E AI, Sorry!!_*");
  }
});

