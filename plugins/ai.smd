const {
  smd,
  prefix,
  Config,
  sleep,
  aitts,
  TelegraPh,
  smdBuffer,
  smdJson,
  tlang,
  langText,
  tr
} = require("../lib");
const axios = require("axios");
const fetch = require('node-fetch');
const fs = require("fs-extra");

// ==================== CHAT COMMAND (PrinceTech Mistral AI) ====================
smd({
  pattern: "chat",
  desc: "chat with an AI",
  category: 'ai',
  use: "<Hii, Empire Tech Labs>",
  filename: __filename
}, async (message, query) => {
  try {
    let prompt = query || message.reply_text;

    if (!prompt) {
      return await message.reply(langText("ai", "provide_query", {}, message.userLang || global.currentUserLang));
    }

    const response = await smdJson(
      `https://api.princetechn.com/api/ai/chat?apikey=prince&q=${encodeURIComponent(prompt)}`
    );

    if (response && response.status === 200 && response.success && response.result) {
      return await message.send(response.result);
    } else {
      return await message.reply(langText("ai", "no_response", {}, message.userLang || global.currentUserLang));
    }
  } catch (error) {
    await message.error(error + "\n\ncommand: chat", error, "*_No response from chatbot, sorry!!_*");
  }
});

