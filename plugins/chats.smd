let {
  smd,
  prefix,
  Config,
  langText,
  tr,
  tlang
} = require("../lib");

const UL = (message) => message.userLang || global.currentUserLang;

// ============================ CHATS SETTINGS ============================ 

function chatId(message) {
  return message.chat || message.jid || message.from;
}

function lastMessages(message) {
  const jid = chatId(message);
  const key = {
    remoteJid: jid,
    id: message.id || message.key?.id,
    fromMe: !!message.fromMe
  };
  const participant = message.key?.participant || message.sender || message.participant;
  if (message.isGroup && participant && !key.fromMe) {
    key.participant = participant;
  }

  let messageTimestamp = message.messageTimestamp ?? message.timestamp ?? Math.floor(Date.now() / 1000);
  if (typeof messageTimestamp === "object") {
    messageTimestamp = messageTimestamp.low ?? messageTimestamp.high ?? Math.floor(Date.now() / 1000);
  }

  return [{
    key,
    message: message.message || { conversation: message.body || "" },
    messageTimestamp: Number(messageTimestamp)
  }];
}

function parseMuteTime(input = '') {
  const raw = String(input || '').trim().toLowerCase();
  if (!raw) return 8 * 60 * 60;
  if (["forever", "always", "permanent"].includes(raw)) return 365 * 24 * 60 * 60;

  const match = raw.match(/(\d+)\s*(s|sec|secs|second|seconds|m|min|mins|minute|minutes|h|hr|hrs|hour|hours|d|day|days|w|week|weeks)?/);
  if (!match) return 8 * 60 * 60;

  const value = parseInt(match[1]);
  const unit = match[2] || "h";
  if (/^s/.test(unit)) return value;
  if (/^m/.test(unit)) return value * 60;
  if (/^d/.test(unit)) return value * 24 * 60 * 60;
  if (/^w/.test(unit)) return value * 7 * 24 * 60 * 60;
  return value * 60 * 60;
}

async function modifyChat(message, patch) {
  try {
    return await message.bot.chatModify(patch, chatId(message));
  } catch (error) {
    const errorText = String(error?.message || error);
    if (/App state key|myAppStateKey/i.test(errorText)) {
      try { message.bot.ev.flush(); } catch {}
      await message.send(langText("chats", "syncing", {}, UL(message)));
      return false;
    }
    throw error;
  }
}

function parsePinDuration(input = '') {
  const raw = String(input || '').trim().toLowerCase();
  if (!raw) return 86400;
  if (['1d', '1', 'day'].includes(raw)) return 86400;
  if (['7d', '7', 'week'].includes(raw)) return 604800;
  if (['30d', '30', 'month'].includes(raw)) return 2592000;
  const seconds = parseInt(raw, 10);
  return Number.isFinite(seconds) && seconds > 0 ? seconds : 86400;
}

function quotedMessageKey(message) {
  const key = { ...message.quoted.key };
  if (!message.isGroup) delete key.participant;
  return key;
}

// Command: clear - Clear chat messages (Baileys chatModify)
smd({
  pattern: 'clear',
  fromMe: true,
  desc: 'clear chat messages',
  type: 'chats'
}, async (message, match) => {
  try {
    await message.send(langText("chats", "clearing", {}, UL(message)));
    if (await modifyChat(message, {
      clear: true,
      lastMessages: lastMessages(message)
    }) === false) return;
    await message.send("_Chat cleared._");
  } catch (error) {
    message.error(`${error}\n\nCommand : clear`, error, false);
  }
});

