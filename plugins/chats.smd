// Command: pin - Pin a message (Baileys)
smd({
  pattern: 'pin',
  alias: ["pinmsg"],
  fromMe: true,
  desc: 'pin a quoted message (reply). optional: 1d, 7d, 30d',
  use: '<reply> [1d|7d|30d]',
  type: 'chats'
}, async (message, input) => {
  try {
    if (!message.quoted?.key?.id) {
      return message.reply("*Reply to the message you want to pin.*\nExample: `.pin 7d`");
    }
    if (message.isGroup && (!message.isAdmin || !message.isBotAdmin)) {
      return message.reply(tlang().admin);
    }
    const duration = parsePinDuration(input);
    await message.bot.sendMessage(message.chat, {
      pin: quotedMessageKey(message),
      time: duration,
      type: 1
    });
    await message.send(langText("chats", "pinned", {}, UL(message)));
  } catch (error) {
    message.error(`${error}\n\nCommand : pin`, error, false);
  }
});

// Command: unpin - Unpin a message (Baileys)
smd({
  pattern: 'unpin',
  alias: ["unpinmsg"],
  fromMe: true,
  desc: 'unpin a quoted message (reply)',
  use: '<reply>',
  type: 'chats'
}, async (message) => {
  try {
    if (!message.quoted?.key?.id) {
      return message.reply("*Reply to the message you want to unpin.*");
    }
    if (message.isGroup && (!message.isAdmin || !message.isBotAdmin)) {
      return message.reply(tlang().admin);
    }
    await message.bot.sendMessage(message.chat, {
      pin: quotedMessageKey(message),
      type: 2
    });
    await message.send(langText("chats", "unpinned", {}, UL(message)));
  } catch (error) {
    message.error(`${error}\n\nCommand : unpin`, error, false);
  }
});

