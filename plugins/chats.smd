// Command: mutechat - Mute a chat
smd({
  pattern: 'mutechat',
  alias: ["chatmute", "mutecghat"],
  fromMe: true,
  desc: 'mute a chat',
  type: 'chats'
}, async (message, match) => {
  try {
    const seconds = parseMuteTime(match);
    if (await modifyChat(message, {
      mute: Math.floor(Date.now() / 1000) + seconds
    }) === false) return;
    await message.send(langText("chats", "muted", {}, UL(message)));
  } catch (error) {
    message.error(`${error}\n\nCommand : mutechat`, error, false);
  }
});

// Command: unmutechat - Unmute a chat
smd({
  pattern: 'unmutechat',
  alias: ["chatunmute", "unmutecghat"],
  fromMe: true,
  desc: 'unmute a chat',
  type: 'chats'
}, async (message, match) => {
  try {
    if (await modifyChat(message, {
      mute: null
    }) === false) return;
    await message.send(langText("chats", "unmuted", {}, UL(message)));
  } catch (error) {
    message.error(`${error}\n\nCommand : unmutechat`, error, false);
  }
});

// Command: profilename - Change your WhatsApp profile name
smd({
  pattern: 'profilename',
  fromMe: true,
  desc: 'To change your profile name',
  type: 'whatsapp'
}, async (message, match) => {
  try {
    match = match || message.reply_message.text;
    if (!match) {
      return await message.send(langText("chats", "need_name", {}, UL(message)));
    }
    await message.bot.updateProfileName(match);
    await message.send(langText("chats", "profile_updated", {}, UL(message)));
  } catch (error) {
    message.error(`${error}\n\nCommand : profilename`, error, false);
  }
});

// ============================ PRIVACY SETTINGS ============================    

// Command: getprivacy - Get current privacy settings
smd({
  pattern: 'getprivacy',
  fromMe: true,
  desc: 'get your privacy settings',
  type: 'privacy'
}, async (message, match) => {
  const {
    readreceipts,
    profile,
    status,
    online,
    last,
    groupadd,
    calladd
  } = await message.bot.fetchPrivacySettings(true);
  
  let profilePicture = await message.getpp(message.user);
  
  await message.send(profilePicture, {
    caption: `*♺ whatsapp privacy settings*

*ᝄ name :* ${(message.fromMe && message.pushName ? message.pushName : message.bot.user.name).split("\n").join("  ")}
*ᝄ number :* ${message.user.split("@")[0]}

*ᝄ online :* ${online}
*ᝄ profile :* ${profile}
*ᝄ last seen :* ${last}
*ᝄ whts status :* ${status}
*ᝄ read receipt :* ${readreceipts}

*ᝄ who can add in group :* ${groupadd}
*ᝄ who can call :* ${calladd}`
  }, 'img');
});

// Command: lastseen - Change last seen privacy setting
smd({
  pattern: 'lastseen',
  fromMe: true,
  desc: 'to change lastseen privacy',
  type: 'privacy'
}, async (message, match, { smd: commandName }) => {
  try {
    if (!match) {
      return await message.send(langText("chats", "privacy_example", { cmd: "lastseen", setting: "last seen" }, UL(message)));
    }
    const available_privacy = ['all', 'contacts', 'contact_blacklist', 'none'];
    if (!available_privacy.includes(match)) {
      return await message.send(langText("chats", "privacy_invalid", { options: available_privacy.join(' / ') }, UL(message)));
    }
    await message.bot.updateLastSeenPrivacy(match);
    await message.send(langText("chats", "privacy_updated", { setting: "last seen", value: match }, UL(message)));
  } catch (error) {
    message.error(`${error}\n\nCommand : lastseen`, error, false);
  }
});

