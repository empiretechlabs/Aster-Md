# Empire-Md — copy to .env and fill in your values

# Bot owner (required for owner commands & DMs)
OWNER_NUMBER=212782547789
OWNER_NAME=Empire Tech

# Session: MEGA file ID for session credentials (or leave empty to use QR)
SESSION_ID=

# Bot settings
PREFIX=.
MODE=private
SUDO=
TIME_ZONE=Africa/Lagos
VERSION=0.0.2-developement-x

# Database (auto-detected: set one or none)
# MongoDB — set MONGODB_URL to use MongoDB
MONGODB_URL=
# PostgreSQL — set DATABASE_URL to use PostgreSQL
DATABASE_URL=
# If neither URL is set, bot uses JSON files in ./database/

# Features
ALWAYS_ONLINE=false
ANTICALL=false
ANTICALL_MSG=🚫 Calls are not allowed.
ANTIFAKE=false
ANTIFAKE_ACTION=kick
ANTIFAKE_NUMBERS=91,222,92
ANTILINK=false
ANTILINK_ACTION=delete
ANTIDELETE=false
AUTOREACT=false
AUTO_LIKE_EMOJI=😀
AUTO_LIKE_STATUS=false
AUTO_RECORDING=false
AUTO_TYPING=false
AUTO_VIEW_STATUS=false

# Heroku (optional)
HEROKU_APP_NAME=
HEROKU_API_KEY=
