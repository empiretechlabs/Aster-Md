# =============================================================================
# Aster-Md — Environment Variables
# Copy this file to `.env` and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------
# Owner WhatsApp number (international format, no + or spaces)
OWNER_NUMBER=
OWNER_NAME=Aster Tech

# Session: MEGA file ID (leave empty to use QR login)
SESSION_ID=

# -----------------------------------------------------------------------------
# Bot core
# -----------------------------------------------------------------------------
PREFIX=.
MODE=private
BOT_NAME=Aster-Md
VERSION=0.0.2-developement-x
SUDO=
TIME_ZONE=Africa/Lagos
LANGUAGE=en
THEME=ASTER

# -----------------------------------------------------------------------------
# Database
# Set MONGODB_URL and/or DATABASE_URL, or leave both empty to use ./database/
# -----------------------------------------------------------------------------
MONGODB_URL=
DATABASE_URL=

# -----------------------------------------------------------------------------
# Server & deployment
# -----------------------------------------------------------------------------
PORT=3000
APP_URL=
BRANCH=main
HEROKU_APP_NAME=
HEROKU_API_KEY=
KOYEB_API=false
RENDER_API=

# -----------------------------------------------------------------------------
# Branding & media
# -----------------------------------------------------------------------------
CAPTION=
PACK_NAME=Sticker By
PACK_AUTHER=
THUMB_IMAGE=
GITHUB=
GURL=
WEBURL=

# -----------------------------------------------------------------------------
# Auto features
# -----------------------------------------------------------------------------
ALWAYS_ONLINE=false
AUTO_TYPING=false
AUTO_RECORDING=false
AUTO_VIEW_STATUS=false
AUTO_LIKE_STATUS=false
AUTO_LIKE_EMOJI=random
AUTO_READ_STATUS=false
AUTO_SAVE_STATUS=false
STATUS_REACTION_EMOJI=random
READ_COMMAND=false
READ_MESSAGE=false
READ_MESSAGE_FROM=
SAVE_STATUS_FROM=
READ_STATUS_FROM=

# -----------------------------------------------------------------------------
# Group & security
# -----------------------------------------------------------------------------
ANTICALL=false
ANTICALL_MSG=🚫 Calls are not allowed.
ANTIFAKE=false
ANTIFAKE_ACTION=kick
ANTIFAKE_NUMBERS=91,222,92
ANTILINK=false
ANTILINK_ACTION=delete
ANTILINK_VALUES=all
ANTIDELETE=false
AUTOREACT=false
WELCOME=false
GOODBYE=false
WARN_COUNT=3
DISABLE_PM=false
DISABLE_GROUPS=false

# -----------------------------------------------------------------------------
# API keys (optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
HF_API_KEY=
TELEGRAPH_TOKEN=
ELEVENLAB_API_KEY=
REMOVE_BG_KEY=
AITTS_ID=37

# -----------------------------------------------------------------------------
# Advanced (optional)
# -----------------------------------------------------------------------------
ALLOW_JID=
BLOCK_JID=
ERROR_CHAT=
MSGS_IN_LOG=false
FLUSH=false
STYLE=
USER_IMAGES=
WAPRESENCE=
MENU=
